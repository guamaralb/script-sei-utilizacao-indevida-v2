        <mxCell id="g-f-velho" parent="g-c-sem" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = Processar VELHO&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;O fluxo VELHO só roda na próxima execução (aba 6)&lt;/font&gt;" vertex="1">
