        <UserObject label="&lt;b&gt;Detalhado na aba 3&lt;/b&gt; →&lt;br&gt;Fluxo normal do NOVO, &lt;b&gt;na mesma execução&lt;/b&gt;" link="data:page/id,normal" id="g-c-pn-lk">
          <mxCell parent="g-c-pn" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1">
            <mxGeometry height="58" width="360" x="20" y="58" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="g-err-exc" parent="g-c-linha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" value="&lt;b&gt;except&lt;/b&gt; (qualquer etapa acima): &lt;b&gt;registrar_erro&lt;/b&gt;(registro, e) preenche tipo_erro e erro (e prox_acao = Verificar erro, se vazia).&lt;br&gt;ErroAvaliacao, FormatoMemorandoInvalido, TextoMemoPendente: sem traceback. Outras: logger.exception" vertex="1">
          <mxGeometry height="90" width="440" x="650" y="1544" as="geometry" />
        </mxCell>
        <mxCell id="g-a-fimproc" parent="g-c-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;log_fim_processo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;registro.to_dict() vira uma linha da planilha de controle; segue para o próximo processo" vertex="1">
          <mxGeometry height="74" width="440" x="670" y="2276" as="geometry" />
        </mxCell>
        <mxCell id="g-nota0" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• Moldura = &lt;b&gt;função&lt;/b&gt; (nome e módulo no topo); caixas dentro = passos na ordem em que o código executa. Funções chamadas aparecem como molduras aninhadas.&lt;br&gt;• Azul: ação · Amarelo: pergunta · Roxo: memo criado e inserido no bloco · Verde: ➕ marcador · Vermelho: erro · Cinza: início/fim · Laranja: detalhado em outra aba (clique).&lt;br&gt;• Erros à esquerda; desvios que param o processo ou seguem outro caminho, à direita. Tracejado: previsto (não implementado).&lt;br&gt;• Legenda completa e tabela de marcadores: aba 8." vertex="1">
          <mxGeometry height="170" width="560" x="-620" as="geometry" />
        </mxCell>
        <mxCell id="g-nota1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Prefixo &quot;Script v2 - &quot; em todos (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres. Aqui os marcadores aparecem sem o prefixo." vertex="1">
          <mxGeometry height="80" width="560" x="-620" y="194" as="geometry" />
        </mxCell>
        <mxCell id="g-nota2" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Classificação&lt;/b&gt;&lt;br&gt;NOVO: nenhum documento da GEACS na árvore. VELHO: já existe documento da GEACS.&lt;br&gt;1 - Processo NOVO segue na mesma execução para o fluxo normal (aba 3); 2 - Processo VELHO só é tratado na execução seguinte (aba 6)." vertex="1">
          <mxGeometry height="100" width="560" x="-620" y="298" as="geometry" />
        </mxCell>
        <mxCell id="g-nota3" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Marcadores manuais&lt;/b&gt;&lt;br&gt;PLANILHADO e UTILIZAÇÃO INSERIDA (e MANUAL/ASSINADO) não contam na pergunta &quot;Tem outro marcador Script v2 - ?&quot; e não impedem a classificação." vertex="1">
          <mxGeometry height="80" width="560" x="-620" y="422" as="geometry" />
        </mxCell>
        <mxCell id="g-nota4" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Erros&lt;/b&gt;&lt;br&gt;Todo erro sobe até _processar_linha: registrar_erro preenche tipo_erro, erro e, se preciso, prox_acao = Verificar erro. ErroAvaliacao, FormatoMemorandoInvalido e TextoMemoPendente são logados sem traceback; falha inesperada, com logger.exception. &lt;b&gt;Um erro nunca interrompe os demais processos.&lt;/b&gt;" vertex="1">
          <mxGeometry height="110" width="560" x="-620" y="526" as="geometry" />
        </mxCell>
        <mxCell id="g-nota5" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Desfecho de cada processo&lt;/b&gt;&lt;br&gt;Todo caminho termina com uma prox_acao (Registro.ProxAcao) ou com erro. O registro vira uma linha da planilha de controle e o loop volta a &quot;Há próximo processo?&quot; (seta tracejada)." vertex="1">
          <mxGeometry height="90" width="560" x="-620" y="660" as="geometry" />
        </mxCell>
        <mxCell id="g-e1" edge="1" parent="1" source="g-ini" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3938;entryY=0;entryDx=0;entryDy=0;" target="g-c-main" value="">
