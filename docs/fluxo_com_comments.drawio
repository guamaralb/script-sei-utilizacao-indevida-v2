        </mxCell>
        <mxCell id="c-err-existe" parent="c-c-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): memo existe sem os marcadores. Verificar se está no bloco e adicionar os marcadores manualmente. Registro: memo_uso_rede_sei" vertex="1">
          <mxGeometry height="110" width="260" x="20" y="1364" as="geometry" />
        </mxCell>
        <mxCell id="c-a-reabre" parent="c-c-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;_reabrir&lt;/font&gt;&lt;/b&gt;&lt;br&gt;reabrir_processo: reabre o processo na unidade" vertex="1">
