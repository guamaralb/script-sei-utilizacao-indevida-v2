        <mxCell id="n-r-err" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): memo da GEACS sem marcador; verificar manualmente (evita duplicidade). Registro: qnt_memos_geacs_esperada&lt;br&gt;&lt;b&gt;TODO&lt;/b&gt;: procurar os memos pelo assunto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="n-c-ret">
          <mxGeometry x="20" y="152" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n-r-log" value="Log: fluxo normal do início ou &lt;b&gt;retomada&lt;/b&gt; (tem 1.6, 1.8 ou 1.9: TAGS_RETOMADA_NOVO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="n-c-ret">
