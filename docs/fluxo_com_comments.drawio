        <mxCell id="c-tu-fim" parent="c-c-main" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = Nada a fazer: todos usaram a rede própria (memo dispensado)" vertex="1">
