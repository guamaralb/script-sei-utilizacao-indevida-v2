        <mxCell id="AFsUTFi49G7jIGGUE0sy-90" parent="AFsUTFi49G7jIGGUE0sy-84" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;_incluir_memo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Cria &lt;b&gt;MemoApisPeriodoDependentes&lt;/b&gt; e insere no bloco &lt;b&gt;7730905&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TODO: procurar pelo assunto antes de criar&lt;/font&gt;" vertex="1">
