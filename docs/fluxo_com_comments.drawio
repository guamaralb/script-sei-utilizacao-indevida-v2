        </mxCell>
        <mxCell id="c-a-gar" parent="c-c-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;garantir_marcadores_no_sei&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[1.4 - Memo Não Usou Rede no Bloco; 1.2 - Avaliado Se Usou Rede Própria]" vertex="1">
          <mxGeometry height="74" width="440" x="320" y="1596" as="geometry" />
        </mxCell>
        <mxCell id="c-err-gar" parent="c-c-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): marcador não cadastrado no SEI. Nenhum memo nem marcador" vertex="1">
          <mxGeometry height="58" width="260" x="20" y="1604" as="geometry" />
        </mxCell>
        <mxCell id="c-m-memo" parent="c-c-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;incluir_doc_sei_memo · inserir_bloco_ass&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Cria &lt;b&gt;MemoDisaUsoRede&lt;/b&gt; (quem usou e quem não usou) e insere no bloco &lt;b&gt;7707212&lt;/b&gt;" vertex="1">
          <mxGeometry height="74" width="440" x="320" y="1706" as="geometry" />
        </mxCell>
        <mxCell id="c-t14" parent="c-c-main" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" value="➕ 1.4 - Memo Não Usou Rede no Bloco" vertex="1">
          <mxGeometry height="50" width="440" x="320" y="1816" as="geometry" />
        </mxCell>
        <mxCell id="c-t12" parent="c-c-main" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" value="➕ 1.2 - Avaliado Se Usou Rede Própria&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:10px&quot;&gt;(_marcar_avaliado)&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="440" x="320" y="1902" as="geometry" />
        </mxCell>
        <mxCell id="c-a-num" parent="c-c-main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;_registrar_numero_memo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;memos_geacs_novos: relê a árvore e preenche memo_uso_rede_sei (falha só gera log)" vertex="1">
          <mxGeometry height="74" width="440" x="320" y="1998" as="geometry" />
        </mxCell>
        <mxCell id="c-fim" parent="1" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = Assinar memo de uso da rede própria e encaminhar" vertex="1">
          <mxGeometry height="50" width="480" x="300" y="2224" as="geometry" />
        </mxCell>
        <mxCell id="c-nota0" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• Moldura = &lt;b&gt;função&lt;/b&gt; (nome e módulo no topo); caixas dentro = passos na ordem em que o código executa. Funções chamadas aparecem como molduras aninhadas.&lt;br&gt;• Azul: ação · Amarelo: pergunta · Roxo: memo criado e inserido no bloco · Verde: ➕ marcador · Vermelho: erro · Cinza: início/fim · Laranja: detalhado em outra aba (clique).&lt;br&gt;• Erros à esquerda; desvios que param o processo ou seguem outro caminho, à direita. Tracejado: previsto (não implementado).&lt;br&gt;• Legenda completa e tabela de marcadores: aba 8." vertex="1">
          <mxGeometry height="170" width="560" x="-620" as="geometry" />
        </mxCell>
        <mxCell id="c-nota1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Prefixo &quot;Script v2 - &quot; em todos (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres. Aqui os marcadores aparecem sem o prefixo." vertex="1">
          <mxGeometry height="80" width="560" x="-620" y="194" as="geometry" />
        </mxCell>
        <mxCell id="c-nota2" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Quem chama&lt;/b&gt;&lt;br&gt;• main.py (_corrigir_novo_sem_avaliacao, aba 2): matrículas do memo da APIS destinado à GEACS;&lt;br&gt;• script de correção (aba 7): matrículas da planilha compilada (matricula_titular, matriculas_dependentes)." vertex="1">
          <mxGeometry height="90" width="560" x="-620" y="298" as="geometry" />
        </mxCell>
        <mxCell id="c-nota3" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Marcadores só com o processo reaberto&lt;/b&gt;&lt;br&gt;Todo marcador desta rotina é adicionado depois de reabrir o processo na unidade (_reabrir)." vertex="1">
          <mxGeometry height="70" width="560" x="-620" y="412" as="geometry" />
        </mxCell>
        <mxCell id="c-nota4" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Memo de correção só existe se alguém NÃO usou&lt;/b&gt; (MemoDisaUsoRede levanta ValueError se todos usaram). É identificado na árvore pelo assunto (PADRAO_ASSUNTO_MEMO_USO_REDE, aceita a grafia antiga &quot;Rede Prória&quot;)." vertex="1">
          <mxGeometry height="90" width="560" x="-620" y="506" as="geometry" />
        </mxCell>
        <mxCell id="c-nota5" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Ordem: ➕ 1.4 antes de ➕ 1.2&lt;/b&gt;&lt;br&gt;Se falhar entre os dois, a próxima execução entra pela retomada (tem 1.4, sem 1.2) e só adiciona 1.2." vertex="1">
          <mxGeometry height="70" width="560" x="-620" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c-nota6" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" value="&lt;b&gt;Erros&lt;/b&gt;&lt;br&gt;Todo erro sobe até _processar_linha: registrar_erro preenche tipo_erro, erro e, se preciso, prox_acao = Verificar erro. ErroAvaliacao, FormatoMemorandoInvalido e TextoMemoPendente são logados sem traceback; falha inesperada, com logger.exception. &lt;b&gt;Um erro nunca interrompe os demais processos.&lt;/b&gt;" vertex="1">
