          </mxCell>
        </UserObject>
        <mxCell id="s-err-exc" value="&lt;b&gt;except&lt;/b&gt; (qualquer etapa acima): &lt;b&gt;registrar_erro&lt;/b&gt;(registro, e) preenche tipo_erro e erro.&lt;br&gt;ErroAvaliacao: sem traceback. Outras: logger.exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="s-c-linha">
          <mxGeometry x="590" y="1404" width="440" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s-a-fimproc" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;log_fim_processo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;registro.to_dict() vira uma linha da planilha de controle; segue para o próximo processo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="s-c-main">
          <mxGeometry x="610" y="2058" width="440" height="74" as="geometry" />
        </mxCell>
        <mxCell id="s-nota0" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• Moldura = &lt;b&gt;função&lt;/b&gt; (nome e módulo no topo); caixas dentro = passos na ordem em que o código executa. Funções chamadas aparecem como molduras aninhadas.&lt;br&gt;• Azul: ação · Amarelo: pergunta · Roxo: memo criado e inserido no bloco · Verde: ➕ marcador · Vermelho: erro · Cinza: início/fim · Laranja: detalhado em outra aba (clique).&lt;br&gt;• Erros à esquerda; desvios que param o processo ou seguem outro caminho, à direita. Tracejado: previsto (não implementado).&lt;br&gt;• Legenda completa e tabela de marcadores: aba 8." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-620" y="0" width="560" height="170" as="geometry" />
        </mxCell>
        <mxCell id="s-nota1" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Prefixo &quot;Script v2 - &quot; em todos (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres. Aqui os marcadores aparecem sem o prefixo." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-620" y="194" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s-nota2" value="&lt;b&gt;Objetivo&lt;/b&gt;&lt;br&gt;Corrigir os NOVOS encaminhados à DISA e à DEPROC &lt;b&gt;sem&lt;/b&gt; avaliação do uso da rede própria. Nenhum marcador é adicionado na triagem (_avaliar_processo): só a rotina de correção (aba 4) adiciona." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-620" y="298" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s-nota3" value="&lt;b&gt;Os dois main nunca se importam&lt;/b&gt;: a rotina de correção fica em correcao_rede_propria.py e é usada pelos dois scripts." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-620" y="412" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s-nota4" value="&lt;b&gt;Pendente&lt;/b&gt;: este script ainda trata 1.2.2 como processo parado (no fluxo normal atual, 1.2.2 não para o processo)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-620" y="496" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s-nota5" value="&lt;b&gt;Erros&lt;/b&gt;&lt;br&gt;Todo erro sobe até _processar_linha: registrar_erro preenche tipo_erro, erro e, se preciso, prox_acao = Verificar erro. ErroAvaliacao, FormatoMemorandoInvalido e TextoMemoPendente são logados sem traceback; falha inesperada, com logger.exception. &lt;b&gt;Um erro nunca interrompe os demais processos.&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="-620" y="580" width="560" height="110" as="geometry" />
        </mxCell>
