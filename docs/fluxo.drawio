><mxCell id="c185" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_finalizar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Número SEI dos memos criados (registrar_numeros_memos)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c220"><mxGeometry x="511" y="2468" width="330" height="66" as="geometry"/></mxCell><mxCell id="c219" value="Volta para a coluna 1&lt;br&gt;(planilha de controle)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c220"><mxGeometry x="24" y="2562" width="330" height="50" as="geometry"/></mxCell><mxCell id="c413" value="Funções usadas em vários pontos" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3826" y="230" width="500" height="34" as="geometry"/></mxCell><mxCell id="c257" value="&lt;b&gt;Marcadores&lt;/b&gt; (prefixo &quot;Script v2 - &quot;; ★ = estado: no máximo um; ◆ = par: no máximo um de cada)&lt;br&gt;0 - Processo VELHO&lt;br&gt;1 - Tratado pelo Script&lt;br&gt;1.1 - Período Variável p/ Dependentes&lt;br&gt;1.2.1 - Mat. N Encontradas Base APIS&lt;br&gt;★ 1.5 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;★ 1.5 - Aguarda APIS: Formato Inválido&lt;br&gt;★ 1.6 - Avaliado Uso Rede Própria DISA&lt;br&gt;★ 1.6.1 - Aguarda APIS: Matrículas&lt;br&gt;◆ 1.6.2 - Base DISA: Usou RP&lt;br&gt;◆ 1.6.2 - Base DISA: Não Usou RP&lt;br&gt;★ 1.7 - Aguarda APIS: Período Deps&lt;br&gt;★ 1.8 - Avaliado Uso Rede Própria MANTIS&lt;br&gt;◆ 1.8.2 - MANTIS: Usou RP&lt;br&gt;◆ 1.8.2 - MANTIS: Não Usou RP&lt;br&gt;◆ 1.8.3 - MANTIS: Usou RC&lt;br&gt;◆ 1.8.3 - MANTIS: Não Usou RC&lt;br&gt;★ 1.9 - Aguarda DISA: Validar (Consta)&lt;br&gt;★ 1.9 - Aguarda DISA: Validar (N Consta)&lt;br&gt;★ 1.9 - Aguarda DISA: Relat. s/ MANTIS&lt;br&gt;★ 1.10 - Concluído: Memo DEPROC&lt;br&gt;★ 1.10 - Aguarda APIS: Sem Uso&lt;br&gt;&lt;i&gt;Versão anterior:&lt;br&gt;1.2 - Avaliado Se Usou Rede Própria&lt;br&gt;1.2.2 - Mat. N Encontradas Base DISA&lt;br&gt;1.3 - Memos DISA e DEPROC no Bloco (= VELHO)&lt;br&gt;1.3 - Memo DEPROC no Bloco&lt;br&gt;1.4 - Memo Não Usou Rede no Bloco&lt;br&gt;★ 1.8.1 - Memo DISA Validar Usos MANTIS&lt;br&gt;★ 1.9 - Memo DISA Uso Rede Própria&lt;br&gt;★ 1.10 - Concluído: Memos DISA e DEPROC&lt;br&gt;★ 1.11 - VELHO Concluído: Memo DISA&lt;br&gt;★ 1.11 - VELHO Concluído: Memo DEPROC&lt;/i&gt;" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3826" y="270" width="718" height="546" as="geometry"/></mxCell><mxCell id="c227" value="&lt;b style=&quot;font-size:16px&quot;&gt;_separar_velho()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Processo VELHO&lt;/b&gt; (enviado à DISA e à DEPROC antes da avaliação): marcado e &lt;b&gt;não processado&lt;/b&gt;. TODO: definir o fluxo do VELHO&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=66;" vertex="1" parent="1"><mxGeometry x="3826" y="856" width="718" height="428" as="geometry"/></mxCell><mxCell id="c222" value="Tem MANUAL&lt;br&gt;ou ASSINADO?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="74" y="90" width="230" height="90" as="geometry"/></mxCell><mxCell id="c221" value="prox_acao = Fora do escopo (tratado manualmente)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="424" y="110" width="270" height="50" as="geometry"/></mxCell><mxCell id="c224" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColo