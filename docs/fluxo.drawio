eacs_verificar_marcadores"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1596" pageHeight="2902" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1071" value="run_geacs_verificar_marcadores · Verificar os marcadores (main_geacs_verificar_marcadores.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c1072" value="Na unidade da GEACS. Não altera a prox_acao: atualiza as colunas de marcadores (tag_* e demais_marcadores) e confere a prox_acao com os marcadores e os memorandos. Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c1073" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c1074" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1075" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c1076" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1077" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1078" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1079" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1080" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c1081" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1082" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c659" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_geacs_verificar_marcadores. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1350" as="geometry"/></mxCell><mxCell id="c641" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c642" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba geacs_verificar_marcadores de processos_a_processar.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="142" width="330" height="82" as="geometry"/></mxCell><mxCell id="c643" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="252" width="330" height="82" as="geometry"/></mxCell><mxCell id="c644" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="362" width="330" height="40" as="geometry"/></mxCell><mxCell id="c646" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="74" y="430" width="230" height="120" as="geometry"/></mxCell><mxCell id="c645" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="424" y="457" width="270" height="66" as="geometry"/></mxCell><mxCell id="c648" value="▶ verificar_marcadores(linha_processo()) — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="578" width="330" height="50" as="geometry"/></mxCell><mxCell id="c649" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="656" width="330" height="66" as="geometry"/></mxCell><mxCell id="c650" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Só altera a prox_acao pela troca do No Bloco ou pelo memo do Aguarda assinado (nem fluxo e erro dos outros fluxos): script, ultima_passagem, data_execucao, as colunas de marcadores, verificar_marcadores_acao_sugerida / _inconsistencia / _erro (antes das de marcadores, em amarelo), verificar_marcadores_aberto_na_geacs, verificar_marcadores_memo_aguarda_assinado e, com troca, verificar_marcadores_marcador_trocado" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="750" width="330" height="194" as="geometry"/></mxCell><mxCell id="c652" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="74" y="972" width="230" height="90" as="geometry"/></mxCell><mxCell id="c651" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="424" y="992" width="270" height="50" as="geometry"/></mxCell><mxCell id="c655" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="74" y="1090" width="230" height="90" as="geometry"/></mxCell><mxCell id="c654" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="424" y="1115" width="270" height="40" as="geometry"/></mxCell><mxCell id="c657" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="1208" width="330" height="50" as="geometry"/></mxCell><mxCell id="c658" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c659"><mxGeometry x="24" y="1286" width="330" height="40" as="geometry"/></mxCell><mxCell id="c704" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · verificar_marcadores() · conferir_processo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Lê os marcadores e confere a prox_acao da planilha de controle com eles e com os memorandos. Única ação no SEI: a troca do No Bloco assinado (o fechado é reaberto e concluído de novo). Cada problema vai para verificar_marcadores_inconsistencia, com uma ação (AcaoSugerida) em verificar_marcadores_acao_sugerida&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=98;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="2592" as="geometry"/></mxCell><mxCell id="c660" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_marcadores() · registrar_tags()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Marcadores do processo no SEI" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="24" y="122" width="330" height="50" as="geometry"/></mxCell><mxCell id="c661" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tem_incluir_documento()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;verificar_marcadores_aberto_na_geacs: o fechado no setor é lido como está; só é reaberto para trocar o marcador" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="24" y="200" width="330" height="82" as="geometry"/></mxCell><mxCell id="c667" value="trocar_no_bloco_assinado():&lt;br&gt;No Bloco com o memo da rodada&lt;br&gt;assinado por Gustavo, Bruna ou Danúbia?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="74" y="310" width="230" height="168" as="geometry"/></mxCell><mxCell id="c662" value="Só com marcadores consistentes e o novo marcador cadastrado (garantir_marcadores_no_sei; faltando: inconsistência)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="353" width="270" height="82" as="geometry"/></mxCell><mxCell id="c663" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;reabrir_processo_fechado()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Processo fechado na GEACS: reabre antes da troca (com MANUAL: não reabre nem troca; não reabriu: inconsistência)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="463" width="270" height="98" as="geometry"/></mxCell><mxCell id="c664" value="➕ Aguarda (.1) ou, no 01.12, 01.12.1 - Encaminhado APIS: Todas as Infos (↻ remove o No Bloco)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="589" width="270" height="66" as="geometry"/></mxCell><mxCell id="c665" value="prox_acao = a do novo estado (exceto DEPROC: ...); verificar_marcadores_marcador_trocado, marcadores_adicionados / _removidos" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="683" width="270" height="82" as="geometry"/></mxCell><mxCell id="c666" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_concluir_de_novo() · concluir_processo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Reaberto: conclui de novo, mesmo se a troca falhar. Não concluiu: erro (concluir à mão)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="793" width="270" height="98" as="geometry"/></mxCell><mxCell id="c675" value="conferir_memos_aguarda():&lt;br&gt;Aguarda com o memo assinado&lt;br&gt;por Gustavo, Bruna ou Danúbia?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="74" y="876" width="230" height="152" as="geometry"/></mxCell><mxCell id="c673" value="Planilha: memo_*_sei do memo e verificar_marcadores_memo_aguarda_assinado (marcador: nº SEI (signatário))" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="919" width="270" height="66" as="geometry"/></mxCell><mxCell id="c674" value="Aguarda é o único estado e marcadores consistentes: prox_acao = Aguardar resposta ao memo enviado (exceto se já for ela ou DEPROC: ...)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="1013" width="270" height="82" as="geometry"/></mxCell><mxCell id="c678" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;colunas_tags() · demais_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Uma coluna tag_* por marcador válido na GEACS (TAGS_VALIDOS_GEACS, 30). Os outros (v2v:, 01.06.2 / 01.08.2 / 01.08.3, manuais, antigos) vão juntos para demais_marcadores" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="24" y="1080" width="330" height="98" as="geometry"/></mxCell><mxCell id="c680" value="Planilha de controle&lt;br&gt;não lida?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="74" y="1206" width="230" height="104" as="geometry"/></mxCell><mxCell id="c679" value="A prox_acao não é conferida (só os memorandos)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="1233" width="270" height="50" as="geometry"/></mxCell><mxCell id="c683" value="conferir_marcadores():&lt;br&gt;combinação impossível?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="74" y="1338" width="230" height="120" as="geometry"/></mxCell><mxCell id="c682" value="Inconsistência: os problemas (prox_acao esperada: Verificar marcadores inconsistentes)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="1365" width="270" height="66" as="geometry"/></mxCell><mxCell id="c688" value="conferir_prox_acao():&lt;br&gt;prox_acao não é a do estado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="74" y="1486" width="230" height="120" as="geometry"/></mxCell><mxCell id="c685" value="Inconsistência: prox_acao esperada (No Bloco: assinar; Aguarda: aguardar resposta; 00: VELHO; 01.00: ADC aguarda; sem estado: vazia ou erro). Sempre aceitas: as de erro (PROX_ACOES_A_VERIFICAR), ADC estado mantido" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="1489" width="270" height="114" as="geometry"/></mxCell><mxCell id="c686" value="Verificar acesso de uma passagem da GEACS: a GEACS abriu o processo, o acesso foi resolvido (Rodar geacs_inicial)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="1631" width="270" height="82" as="geometry"/></mxCell><mxCell id="c687" value="DEPROC: ... só com o 01.10 / 01.10.1 da DEPROC" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="1741" width="270" height="50" as="geometry"/></mxCell><mxCell id="c695" value="No Bloco / Aguarda /&lt;br&gt;Encaminhado de memo?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="74" y="1816" width="230" height="120" as="geometry"/></mxCell><mxCell id="c692" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_caso_disa_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;caso_disa_mantis da planilha (se preenchido) é o do memo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="1843" width="270" height="66" as="geometry"/></mxCell><mxCell id="c693" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_memo_do_marcador()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memo pelo assunto na árvore (No Bloco: na rodada); relatórios RP / RC que ele cita antes dele; memo_*_sei da planilha na árvore; No Bloco Sem Memo com memo da APIS para a GEACS" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="1937" width="270" height="114" as="geometry"/></mxCell><mxCell id="c694" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_conferir_assinatura()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;No Bloco com memo assinado: trocar pelo Aguarda / Encaminhado. Aguarda / 01.12.1 com memo não assinado: verificar manualmente" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="2079" width="270" height="98" as="geometry"/></mxCell><mxCell id="c700" value="Retomada&lt;br&gt;(01.06, 01.08)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="74" y="2178" width="230" height="90" as="geometry"/></mxCell><mxCell id="c699" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_retomada()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memo do fluxo na rodada sem o marcador (o geacs_inicial o reaproveita)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="424" y="2190" width="270" height="66" as="geometry"/></mxCell><mxCell id="c702" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;sugestoes_de_fluxo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Só a ação sugerida: N Consta → Rodar geacs_corrige_envio_disa; 01.10.1 com memo de resultado da DEPROC assinado na rodada → Rodar geacs_todas_infos; 01.09.1 com documento da DISA depois do memo → Tratar a resposta da DISA" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="24" y="2296" width="330" height="114" as="geometry"/></mxCell><mxCell id="c703" value="Planilha: tag_*, demais_marcadores, marcadores_finais, verificar_marcadores_acao_sugerida (sem repetição), verificar_marcadores_inconsistencia e verificar_marcadores_aberto_na_geacs (erro: verificar_marcadores_erro; sem ler os marcadores, as colunas deles ficam como estavam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c704"><mxGeometry x="24" y="2438" width="330" height="130" as="geometry"/></mxCell><mxCell id="c1083" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c642" target="c643"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1084" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c643" target="c644"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1085" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c644" target="c646"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1086" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c646" target="c648"><mxGeometry relative="1" as="geometry"/></mxCel