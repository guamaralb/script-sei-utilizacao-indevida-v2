pace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="705" width="220" height="110" as="geometry"/></mxCell><mxCell id="correcao-a3" value="Reabre o processo na unidade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="770" width="260" height="60" as="geometry"/></mxCell><mxCell id="correcao-t3" value="➕ 1.2 - Avaliado Se Usou Rede Própria" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="853" width="320" height="54" as="geometry"/></mxCell><mxCell id="correcao-f3" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Nada a fazer: todos usaram&lt;br&gt;a rede própria (memo dispensado)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="845" width="280" height="70" as="geometry"/></mxCell><mxCell id="correcao-q4" value="Memo de correção&lt;br&gt;já existe na árvore&lt;br&gt;(pelo assunto)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="870" width="240" height="120" as="geometry"/></mxCell><mxCell id="correcao-e4" value="Erro: memo existe sem os marcadores.&lt;br&gt;Verificar se está no bloco e&lt;br&gt;adicionar os marcadores manualmente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="990" width="320" height="80" as="geometry"/></mxCell><mxCell id="correcao-a5" value="Reabre o processo na unidade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1050" width="260" height="60" as="geometry"/></mxCell><mxCell 