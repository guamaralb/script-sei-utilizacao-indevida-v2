"135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1178" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1179" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c1180" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1181" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c508" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_deproc_calcula_copa -a AAAA (ano dos processos: base DEPROC e data de geração dela, obrigatório). Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1520" as="geometry"/></mxCell><mxCell id="c490" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="90" width="330" height="40" as="geometry"/></mxCell><mxCell id="c488" value="ler_argumentos():&lt;br&gt;sem -a AAAA&lt;br&gt;(ou ano sem base em BASES_DEPROC)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="74" y="158" width="230" height="152" as="geometry"/></mxCell><mxCell id="c487" value="argparse mostra o erro e encerra (código 2), antes do log, do login e de qualquer ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="424" y="201" width="270" height="66" as="geometry"/></mxCell><mxCell id="c491" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba deproc_calcula_copa de processos_a_processar.xlsx e a base DEPROC do ano (BASES_DEPROC; 2019 e 2020: copa-MANTIS11281-base_2019 / _2020, aba Resultado, matrículas com DV)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="338" width="330" height="130" as="geometry"/></mxCell><mxCell id="c492" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da DEPROC (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="496" width="330" height="82" as="geometry"/></mxCell><mxCell id="c493" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="606" width="330" height="40" as="geometry"/></mxCell><mxCell id="c495" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="74" y="674" width="230" height="120" as="geometry"/></mxCell><mxCell id="c494" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="424" y="701" width="270" height="66" as="geometry"/></mxCell><mxCell id="c497" value="▶ processar_deproc() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="822" width="330" height="40" as="geometry"/></mxCell><mxCell id="c498" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="890" width="330" height="66" as="geometry"/></mxCell><mxCell id="c499" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linha do processo: script, fluxo (DEPROC - COPARTICIPAÇÃO), prox_acao, erro, ano_base_deproc, data_geracao_base_deproc, marcadores_deproc_* e tag_deproc_*. Os marcadores da GEACS e os resultados do fluxo inicial ficam como estão" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="984" width="330" height="130" as="geometry"/></mxCell><mxCell id="c501" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="74" y="1142" width="230" height="90" as="geometry"/></mxCell><mxCell id="c500" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="424" y="1162" width="270" height="50" as="geometry"/></mxCell><mxCell id="c504" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="74" y="1260" width="230" height="90" as="geometry"/></mxCell><mxCell id="c503" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="424" y="1285" width="270" height="40" as="geometry"/></mxCell><mxCell id="c506" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="1378" width="330" height="50" as="geometry"/></mxCell><mxCell id="c507" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c508"><mxGeometry x="24" y="1456" width="330" height="40" as="geometry"/></mxCell><mxCell id="c536" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · processar_deproc()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Na unidade da DEPROC: apura a coparticipação, anexa o relatório e cria o MemoGeacsCalculoCopa (da DEPROC à GEACS). Marcadores da DEPROC (mesmo prefixo &quot;v2: &quot;)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="1998" as="geometry"/></mxCell><mxCell id="c509" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;registrar_tags() · conferir_marcadores_deproc()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;No máximo um estado, e estado só com o 01. De novo no fim da passagem" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="90" width="330" height="82" as="geometry"/></mxCell><mxCell id="c511" value="Marcadores&lt;br&gt;inconsistentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="74" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c510" value="&lt;b&gt;MarcadoresInconsistentes&lt;/b&gt;: prox_acao = Verificar marcadores inconsistentes" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="424" y="212" width="270" height="66" as="geometry"/></mxCell><mxCell id="c514" value="Tem 01.02 - No Bloco GEACS:&lt;br&gt;Memo Cálculo COPA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="74" y="318" width="230" height="120" as="geometry"/></mxCell><mxCell id="c513" value="Sem ler mais nada&lt;br&gt;prox_acao = DEPROC: assinar memo de resultado da coparticipação e encaminhar à GEACS" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="424" y="337" width="270" height="82" as="geometry"/></mxCell><mxCell id="c517" value="Tem 01.02.1 - Encaminhado GEACS:&lt;br&gt;Memo Cálculo COPA (manual)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="74" y="466" width="230" height="120" as="geometry"/></mxCell><mxCell id="c516" value="Concluído, sem ler mais nada&lt;br&gt;prox_acao = DEPROC: memo de resultado da coparticipação encaminhado à GEACS (concluído)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="424" y="485" width="270" height="82" as="geometry"/></mxCell><mxCell id="c520" value="Sem Incluir Documento?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="74" y="614" width="230" height="90" as="geometry"/></mxCell><mxCell id="c519" value="&lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;: não está aberto na DEPROC (não reabre)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="424" y="634" width="270" height="50" as="geometry"/></mxCell><mxCell id="c522" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Os três que o script adiciona (TAGS_DEPROC): 01, 01.01 e 01.02" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="732" width="330" height="66" as="geometry"/></mxCell><mxCell id="c523" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_documentos_arvore() · obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Último memo da APIS destinado à GEACS (define a rodada). Sem memo ou formato inválido: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="826" width="330" height="98" as="geometry"/></mxCell><mxCell id="c524" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_memo_deproc_assinado()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memo DEPROC da GEACS na rodada (PADRAO_ASSUNTO_MEMO_DEPROC), assinado por Gustavo Amaral Bernardino (ou, nos anteriores, Bruna Miiller Lavarini). Sem o memo ou sem a assinatura: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="952" width="330" height="114" as="geometry"/></mxCell><mxCell id="c525" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;apurar_coparticipacao()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linhas com SEI = processo; confere as matrículas com o memo da APIS (MatriculasDivergentes); mantém só as linhas com VALOR_BASE_COPA diferente de 0; filtra pelo período de apuração. Nenhuma linha: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="1094" width="330" height="114" as="geometry"/></mxCell><mxCell id="c526" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_conferir_configuracao()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Antes de qualquer documento: bloco BLOCO_MEMO_GEACS_CALCULO_COPA (7765003), signatário (Danúbia Lacerda Gomes de Oliveira), texto do memo e data de geração da base (a do ano -a, em BASES_DEPROC). Faltando: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="1236" width="330" height="114" as="geometry"/></mxCell><mxCell id="c527" value="➕ 01 - Tratado pelo Script&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se faltar&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="1378" width="330" height="50" as="geometry"/></mxCell><mxCell id="c530" value="Há coparticipação no período?&lt;br&gt;(atendimento e total ≠ 0)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="74" y="1456" width="230" height="120" as="geometry"/></mxCell><mxCell id="c528" value="📎 PDF Coparticipação - &amp;lt;matrícula&amp;gt; - &amp;lt;data&amp;gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;extrato de utilização, sem as linhas de valor 0; retomada pelo nome na rodada&lt;/span&gt;" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="424" y="1461" width="270" height="110" as="geometry"/></mxCell><mxCell id="c529" value="➕ 01.01 - Relatório Copart. Anexado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="424" y="1599" width="270" height="50" as="geometry"/></mxCell><mxCell id="c533" value="📄 &lt;b&gt;MemoGeacsCalculoCopa&lt;/b&gt;&lt;br&gt;no bloco 7765003 (BLOCO_MEMO_GEACS_CALCULO_COPA); tabelas: beneficiário (iniciais), matrícula, vínculo e valor (sem os de valor 0) e totais (apurado, descontado, em aberto)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="1672" width="330" height="98" as="geometry"/></mxCell><mxCell id="c534" value="➕ 01.02 - No Bloco GEACS: Memo Cálculo COPA&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;↻ remove o 01.01&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="1798" width="330" height="66" as="geometry"/></mxCell><mxCell id="c535" value="prox_acao = DEPROC: assinar memo de resultado da coparticipação e encaminhar à GEACS&lt;br&gt;Depois de assinar (manual): ➕ 01.02.1, ➖ 01.02" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c536"><mxGeometry x="24" y="1892" width="330" height="82" as="geometry"/></mxCell><mxCell id="c1182" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endF