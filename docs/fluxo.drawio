o-fc1" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Assinar memos DISA e DEPROC e encaminhar&lt;br&gt;ou Assinar memo DEPROC e encaminhar" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="605" width="300" height="70" as="geometry"/></mxCell><mxCell id="novo-fc2" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Verificar quantidade de memos da GEACS" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="460" width="240" height="70" as="geometry"/></mxCell><mxCell id="novo-q3" value="Tem &lt;b&gt;1.3 Memos&lt;br&gt;DISA e DEPROC&lt;/b&gt;&lt;br&gt;no Bloco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="730" width="230" height="120" as="geometry"/></mxCell><mxCell id="novo-a3" value="Lê o último memo da APIS&lt;br&gt;(obter_dados_ui) → matrículas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="550" y="760" width="260" height="60" as="geometry"/></mxCell><UserObject label="Rotina de correção&lt;br&gt;(corrigir_uso_rede_propria) →" link="data:page/id,correcao" id="novo-s3"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="760" width="300" height="60" as="geometry"/></mxCell></UserObject><mxCell id="novo-q4" value="Tem &lt;b&gt;1.3 Memo&lt;br&gt;DEPROC&lt;/b&gt; no Bloco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="225" y="890" width="230" height="120" as="geometry"/></mxCell><mxCell id="novo-e4" value="Erro: marcador de memo DEPROC&lt;br&gt;sem marcador de avaliação" style="rounded=1;whiteSpa