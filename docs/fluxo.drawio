=0;" edge="1" parent="1" source="geral-a4" target="geral-q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e9" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="geral-q1" target="geral-e1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e10" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="geral-q1" target="geral-q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e11" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="geral-q2" target="geral-s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e12" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="geral-q2" target="geral-q3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e13" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="geral-q3" target="geral-s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e14" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="geral-q3" target="geral-q4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e15" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="geral-q4" target="geral-e4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e16" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="geral-q4" target="geral-q5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e17" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="geral-q5" target="geral-t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="geral-t2" target="geral-f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e19" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="geral-q5" target="geral-t1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="geral-t1" target="geral-s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="geral-prox" target="geral-qloop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="430"/></Array></mxGeometry></mxCell><mxCell id="geral-n1" value='&lt;b&gt;Desfecho de cada processo&lt;/b&gt;&lt;br&gt;Todo caminho (prox_acao, fim de subfluxo ou erro) termina o processo atual. O registro vira uma linha da planilha e o loop volta a "Há próximo processo?" (seta tracejada).' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="675" width="220" height="170" as="geometry"/></mxCell><mxCell id="geral-n2" value="&lt;b&gt;Marcadores manuais&lt;/b&gt;&lt;br&gt;PLANILHADO e UTILIZAÇÃO INSERIDA não contam como marcadores do script e não impedem a classificação." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="1060" width="260" height="100" as="geometry"/></mxCell><mxCell id="geral-n3" value='&lt;b&gt;Erros (caixas vermelhas)&lt;/b&gt;&lt;br&gt;registrar_erro(registro, e) preenche tipo_erro, erro e, se preciso, prox_acao = "Verificar erro".&lt;br&gt;ErroAvaliacao / FormatoMemorandoInvalido: log sem traceback. Falha inesperada: logger.exception.&lt;br&gt;O processo termina e o loop segue: &lt;b&gt;um erro nunca interrompe os demais&lt;/b&gt;.' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="645" width="300" height="150" as="geometry"/></mxCell><mxCell id="geral-n4" value="&lt;b&gt;Classificação&lt;/b&gt;&lt;br&gt;NOVO: nenhum documento da GEACS na árvore.&lt;br&gt;VELHO: já existe documento da GEACS.&lt;br&gt;O marcador &lt;b&gt;1&lt;/b&gt; segue na mesma execução; o &lt;b&gt;2&lt;/b&gt; só é tratado na execução seguinte." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="5" y="1225" width="230" height="150" as="geometry"/></mxCell><mxCell id="geral-leg-t" value="Legenda" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1335" y="105" width="200" height="30" as="geometry"/></mxCell><mxCell id="geral-leg0" value="Início / fim" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="148" width="230" height="34" as="geometry"/></mxCell><mxCell id="geral-leg1" value="Ação do script" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="198" width="230" height="34" as="geometry"/></mxCell><mxCell id="geral-leg2" value="Ação no SEI (memo, bloco, reabertura)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="248" width="230" height="34" as="geometry"/></mxCell><mxCell id="geral-leg3" value="Pergunta (divide o fluxo)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="292" width="230" height="46" as="geometry"/></mxCell><mxCell id="geral-leg4" value="➕ Marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="348" width="230" height="34" as="geometry"/></mxCell><mxCell id="geral-leg5" value="Subfluxo (clique: outra página)" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="398" width="230" height="34" as="geometry"/></mxCell><mxCell id="geral-leg6" value="Desfecho: prox_acao" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="448" width="230" height="34" as="geometry"/></mxCell><mxCell id="geral-leg7" value="Erro (processo termina)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="498" width="230" height="34" as="geometry"/></mxCell><mxCell id="geral-leg-ni" value="Previsto (não implementado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;dashPattern=6 4;fontColor=#555555;opacity=70;" vertex="1" parent="1"><mxGeometry x="1335" y="548" width="230" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="novo" name="2. NOVO: roteamento (_tratar_novo)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="novo-tit" value="2. NOVO já classificado: roteamento pelos marcadores (main._tratar_novo)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="-20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="novo-ini" value="Entrada: processo com &lt;b&gt;1&lt;/b&gt; (NOVO)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="43" width="280" height="54" as="geometry"/></mxCell><mxCell id="novo-q1" value="Tem &lt;b&gt;1.2.1&lt;/b&gt;&lt;br&gt;ou &lt;b&gt;1.2.2&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="125" width="220" height="110" as="geometry"/></mxCell><mxCell id="novo-e1" value="Erro: processo parado&lt;br&gt;(matrículas não encontradas)&lt;br&gt;&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Verificar matrículas não encontradas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="135" width="300" height="90" as="geometry"/></mxCell><mxCell id="novo-q2" value="Tem &lt;b&gt;1.2&lt;/b&gt;&lt;br&gt;(AVALIADO)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="275" width="220" height="110" as="geometry"/></mxCell><mxCell id="novo-qa" value="Tem &lt;b&gt;1.4&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="275" width="220" height="110" as="geo