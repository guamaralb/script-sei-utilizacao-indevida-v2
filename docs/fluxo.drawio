        <mxCell id="v-c-instr" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_encontrar_instrucoes&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;processar_velho.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="v-c-proc"><mxGeometry x="320" y="430" width="440" height="184" as="geometry" /></mxCell>
        <mxCell id="v-i-ler" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;ler_texto_doc · _identificar_instrucao&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Para cada memo: lê o texto e procura &lt;b&gt;todos&lt;/b&gt; os padrões de uma instrução (_MARCADORES_INSTRUCOES: atualizar_pesquisa / nova_pesquisa). Dicionário vazio = instrução ainda não definida, ignorada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="v-c-instr"><mxGeometry x="20" y="58" width="400" height="106" as="geometry" /></mxCell>
        <mxCell id="v-p-reg" value="Registro: instrucoes_velho&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TODO: avaliar o uso da rede própria aqui (avaliar_uso; matrícula não encontrada: aba 5 com 2.1.1 / 2.1.2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="v-c-proc"><mxGeometry x="320" y="650" width="440" height="74" as="geometry" /></mxCell>
        <mxCell id="v-p-qmais" value="Mais de uma instrução?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="v-c-proc"><mxGeometry x="320" y="760" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="v-p-errmais" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): instruções conflitantes nos memos da APIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="v-c-proc"><mxGeometry x="20" y="781" width="260" height="58" as="geometry" /></mxCell>
        <mxCell id="v-p-qnova" value="Instrução &lt;b&gt;nova_pesquisa&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="v-c-proc"><mxGeometry x="320" y="896" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="v-c-mref" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_marcar_refazer_rel_ui&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;processar_velho.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="v-c-proc"><mxGeometry x="800" y="896" width="440" height="214" as="geometry" /></mxCell>
        <mxCell id="v-mr-t" value="➕ 2.1 - Refazer Relatório de UI" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="v-c-mref"><mxGeometry x="20" y="58" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="v-mr-f" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = VELHO: refazer relatório de UI" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="v-c-mref"><mxGeometry x="20" y="144" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="v-p-qatual" value="&lt;b&gt;atualizar_pesquisa&lt;/b&gt; identificada ou critérios de nova_pesquisa definidos?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="v-c-proc"><mxGeometry x="320" y="1146" width="440" height="130" as="geometry" /></mxCell>
        <mxCell id="v-c-mpdf" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_marcar_transformar_excel_em_pdf&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;processar_velho.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="v-c-proc"><mxGeometry x="800" y="1146" width="440" height="214" as="geometry" /></mxCell>
        <mxCell id="v-mp-t" value="➕ 2.1 - Transformar Excel em PDF" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="v-c-mpdf"><mxGeometry x="20" y="58" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="v-mp-f" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = VELHO: transformar Excel em PDF" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="v-c-mpdf"><mxGeometry x="20" y="144" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="v-p-fim" value="&lt;b&gt;Fim&lt;/b&gt; sem marcador: prox_acao = VELHO: aguardar definição dos critérios das instruções&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Reavaliado na próxima execução&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="v-c-proc"><mxGeometry x="320" y="1312" width="440" height="74" as="geometry" /></mxCell>
        <mxCell id="v-nota0" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• Moldura = &lt;b&gt;função&lt;/b&gt; (nome e módulo no topo); caixas dentro = passos na ordem em que o código executa. Funções chamadas aparecem como molduras aninhadas.&lt;br&gt;• Azul: ação · Amarelo: pergunta · Roxo: memo criado e inserido no bloco · Verde: ➕ marcador · Vermelho: erro · Cinza: início/fim · Laranja: detalhado em outra aba (clique).&lt;br&gt;• Erros à esquerda; desvios que param o processo ou seguem outro caminho, à direita. Tracejado: previsto (não implementado).&lt;br&gt;• Legenda completa e tabela de marcadores: aba 8." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="0" width="560" height="170" as="geometry" /></mxCell>
        <mxCell id="v-nota1" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Prefixo &quot;Script v2 - &quot; em todos (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres. Aqui os marcadores aparecem sem o prefixo." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="194" width="560" height="80" as="geometry" /></mxCell>
        <mxCell id="v-nota2" value="&lt;b&gt;Por enquanto o script só adiciona o marcador da pendência (2.1).&lt;/b&gt;&lt;br&gt;Os stubs de main.py só definem a prox_acao. Os passos tracejados ainda não foram implementados; 2.2 - Relatório de UI Refeito só entra depois da pesquisa da utilização indevida." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="298" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="v-nota3" value="&lt;b&gt;Critérios das instruções&lt;/b&gt;&lt;br&gt;Os padrões de nova_pesquisa ainda estão vazios (em avaliação). Enquanto isso, um processo sem instrução identificada não recebe marcador: não dá para afirmar que ele não tem a instrução de nova pesquisa." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="422" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="v-nota4" value="&lt;b&gt;TODO&lt;/b&gt;&lt;br&gt;- critérios de texto das instruções (não invente);&lt;br&gt;- avaliação da rede própria no VELHO;&lt;br&gt;- download das planilhas antigas;&lt;br&gt;- _tratar_tag_transformar_excel_em_pdf e _tratar_tag_refazer_rel_ui;&lt;br&gt;- pesquisa da utilização indevida." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="546" width="560" height="120" as="geometry" /></mxCell>
        <mxCell id="v-nota5" value="&lt;b&gt;Erros&lt;/b&gt;&lt;br&gt;Todo erro sobe até _processar_linha: registrar_erro preenche tipo_erro, erro e, se preciso, prox_acao = Verificar erro. ErroAvaliacao, FormatoMemorandoInvalido e TextoMemoPendente são logados sem traceback; falha inesperada, com logger.exception. &lt;b&gt;Um erro nunca interrompe os demais processos.&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="690" width="560" height="110" as="geometry" /></mxCell>
