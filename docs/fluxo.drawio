" source="velho-q10" target="velho-t10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="velho-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="velho-t10" target="velho-f10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="velho-e33" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="velho-q10" target="velho-f11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="velho-n1" value="&lt;b&gt;Por enquanto o script só adiciona o marcador da pendência (2.1).&lt;/b&gt;&lt;br&gt;Os fluxos tracejados ainda não foram implementados. 2.2 Relatório de UI Refeito só entra depois da pesquisa da utilização indevida." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="1030" width="280" height="140" as="geometry"/></mxCell><mxCell id="velho-n2" value="&lt;b&gt;Critérios das instruções&lt;/b&gt;&lt;br&gt;Os padrões de texto de nova_pesquisa ainda estão vazios (em avaliação). Enquanto isso, um processo sem nenhuma instrução identificada não recebe marcador: não dá para afirmar que ele não tem a instrução de nova pesquisa." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="1880" width="300" height="160" as="geometry"/></mxCell><mxCell id="velho-n3" value="&lt;b&gt;TODO&lt;/b&gt;&lt;br&gt;- critérios de texto das instruções (não invente);&lt;br&gt;- avaliação da rede própria no VELHO;&lt;br&gt;- download das planilhas antigas;&lt;br&gt;- _tratar_tag_transformar_excel_em_pdf e _tratar_tag_refazer_rel_ui;&lt;br&gt;- pesquisa da utilização indevida." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="245" width="280" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="script-correcao" name="7. Script de correção"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="script-correcao-tit" value="7. Script de correção (main_add_memo_nao_usou_rede_propria.py): triagem" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="-20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="script-correcao-ini" value="Início do script de correção" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="33" width="280" height="54" as="geometry"/></mxCell><mxCell id="script-correcao-a1" value="Lê _processos_processados-COMPILADO-2026_09_23.xlsx&lt;br&gt;(aba FINAL: num_processo, matricula_titular,&lt;br&gt;matriculas_dependentes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="125" width="360" height="70" as="geometry"/></mxCell><mxCell id="script-correcao-a2" value="Carrega as bases:&lt;br&gt;rede própria (DISA) e base geral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="230" width="260" height="60" as="geometry"/></mxCell><mxCell id="script-correcao-a3" value="Login no SEI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="310" width="260" height="60" as="geometry"/></mxCell><mxCell id="script-correcao-qloop" value="Há próximo&lt;br&gt;processo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="395" width="220" height="110" as="geometry"/></mxCell><mxCell id="script-correcao-fimA" value="Salva a planilha de controle e&lt;br&gt;o resumo no log&lt;br&gt;(…/main_add_memo_nao_usou_rede_propria/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="415" width="300" height="70" as="geometry"/></mxCell><mxCell id="script-correcao-fim" value="Fim" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="423" width="120" height="54" as="geometry"/></mxCell><mxCell id="script-correcao-a4" value="Abre o processo e lê os&lt;br&gt;marcadores &lt;b&gt;do SEI&lt;/b&gt; (não da planilha)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="540" width="280" height="60" as="geometry"/></mxCell><mxCell id="script-correcao-q1" value="Tem &lt;b&gt;1&lt;/b&gt;&lt;br&gt;(NOVO)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="635" width="220" height="110" as="geometry"/></mxCell><mxCell id="script-correcao-q1a" value="Tem &lt;b&gt;2&lt;/b&gt;&lt;br&gt;(VELHO)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="635" width="220" height="110" as="geometry"/></mxCell><mxCell id="script-correcao-f1a" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Fora do escopo&lt;br&gt;(VELHO)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="220" height="60" as="geometry"/></mxCell><mxCell id="script-correcao-q1b" value="Tem MANUAL&lt;br&gt;ou ASSINADO?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="785" width="220" height="110" as="geometry"/></mxCell><mxCell id="script-correcao-f1b" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Fora do escopo&lt;br&gt;(tratado manualmente)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="810" width="240" height="60" as="geometry"/></mxCell><mxCell id="script-correcao-e1b" value="Erro: processo não marcado&lt;br&gt;como NOVO nem VELHO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="935" width="280" height="70" as="geometry"/></mxCell><mxCell id="script-correcao-q2" value="Tem &lt;b&gt;1.2.1&lt;/b&gt;&lt;br&gt;ou &lt;b&gt;1.2.2&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="785" width="220" height="110" as="geometry"/></mxCell><mxCell id="script-correcao-e2" value="Erro: processo parado&lt;br&gt;&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Verificar matrículas não encontradas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="5" y="800" width="230" height="80" as="geometry"/></mxCell><mxCell id="script-correcao-q3" value="Tem &lt;b&gt;1.2&lt;/b&gt;&lt;br&gt;(AVALIADO)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1025" width="220" height="110" as="geometry"/></mxCell><mxCell id="script-correcao-q3a" value="Tem &lt;b&gt;1.4&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="1085" width="220" height="110" as="geometry"/></mxCell><mxCell id="script-correcao-a3a" value="Lista a árvore e confere o&lt;br&gt;memo de correção (pelo assunto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="1110" width="280" height="60" as="geometry"/></mxCell><mxCell id="script-correcao-f3a" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Assinar memo de uso da&lt;br&gt;rede própria e encaminhar" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="1105" width="260" height="70" as="geometry"/></mxCell><mxCell id="script-correcao-f3b" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Nada a fazer" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="1260" width="220" height="60" as="geometry"/></mxCell><mxCell id="script-correcao-q4" value="Tem &lt;b&gt;1.3 Memos&lt;br&gt;DISA e DEPROC&lt;/b&gt;&lt;br&gt;no Bloco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="305" y="1200" width="230" height="120" as="geometry"/></mxCell><mxCell id="script-correcao-f4" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Fora do escopo&lt;br&gt;(não se enquadra)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="5" y="1230" width="230" height="60" as="geometry"/></mxCell><mxCell id="script-correcao-a5" value="Lista a árvore" style="rounded=1;whiteSpace=wra