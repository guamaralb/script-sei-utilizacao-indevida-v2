o-q5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="novo-e22" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="novo-q5" target="novo-e5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="novo-e23" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="novo-q5" target="novo-q6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="novo-e24" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="novo-q6" target="novo-e6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="novo-e25" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="novo-q6" target="novo-s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="novo-n1" value="&lt;b&gt;1.3 Memos DISA e DEPROC sem 1.2&lt;/b&gt;&lt;br&gt;Processo encaminhado à DISA e à DEPROC sem avaliação do uso da rede própria (erro antigo). A rotina de correção adiciona 1.4 e/ou 1.2, ou 1.2.1/1.2.2." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="860" width="300" height="120" as="geometry"/></mxCell><mxCell id="novo-n2" value="&lt;b&gt;Reprocessar um processo parado&lt;/b&gt;&lt;br&gt;Corrigir a base (geral ou da rede própria) e remover manualmente 1.2.1 / 1.2.2 no SEI." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="280" height="100" as="geometry"/></mxCell><mxCell id="novo-n3" value="&lt;b&gt;Nenhum marcador é adicionado nesta página.&lt;/b&gt;&lt;br&gt;Ela só decide para onde o processo vai. Ordem das perguntas = ordem do código." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="1195" width="260" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="normal" name="3. NOVO: fluxo normal (processar_novo)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="normal-tit" value="3. NOVO: fluxo normal (processar_novo.processar_novo)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="-20" width="900" height="40" as="geometry"/></mxCell><mxCell id="normal-ini" value="Entrada: NOVO recém-classificado (➕1)&lt;br&gt;ou NOVO sem memos da GEACS" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="40" width="300" height="60" as="geometry"/></mxCell><mxCell id="normal-a1" value="Localiza o &lt;b&gt;último&lt;/b&gt; memorando&lt;br&gt;da APIS-Utilização" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="140" width="260" height="60" as="geometry"/></mxCell><mxCell id="normal-q1" value="Encontrou?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="235" width="220" height="90" as="geometry"/></mxCell><mxCell id="normal-e1" value="Erro: memorando da APIS&lt;br&gt;não encontrado na árvore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="245" width="280" height="70" as="geometry"/></mxCell><mxCell id="normal-a2" value="Lê o texto do memo, identifica o modelo&lt;br&gt;(novo/velho) e extrai: titular (nome,&lt;br&gt;matrícula com DV, período), dependentes&lt;br&gt;(sem DV) e período variável" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="365" width="320" height="90" as="geometry"/></mxCell><mxCell id="normal-q2" value="Formato&lt;br&gt;válido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="495" width="220" height="90" as="geometry"/></mxCell><mxCell id="normal-e2" value="Erro: FormatoMemorandoInvalido&lt;br&gt;&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Verificar formato do memo da APIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="500" width="300" height="80" as="geometry"/></mxCell><mxCell id="normal-a3" value="&lt;b&gt;avaliar_uso&lt;/b&gt;: busca titular e&lt;br&gt;dependentes na &lt;b&gt;base geral&lt;/b&gt; e&lt;br&gt;na &lt;b&gt;base da rede própria&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="635" width="260" height="70" as="geometry"/></mxCell><mxCell id="normal-q3" value="Todas as&lt;br&gt;matrículas nas&lt;br&gt;duas bases?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="745" width="220" height="110" as="geometry"/></mxCell><UserObject label="Matrículas não encontradas&lt;br&gt;(➕ 1.2.1 / 1.2.2) →" link="data:page/id,matriculas" id="normal-s3"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="770" width="280" height="60" as="geometry"/></mxCell></UserObject><mxCell id="normal-f3" value="Processo parado&lt;br&gt;(erro relançado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1030" y="770" width="200" height="60" as="geometry"/></mxCell><mxCell id="normal-a4" value="garantir_marcadores_no_sei&lt;br&gt;[1.2, 1.3 (o do caso), 1.1 se houver]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="900" width="300" height="60" as="geometry"/></mxCell><mxCell id="normal-q4" value="Todos existem&lt;br&gt;no SEI?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1000" width="220" height="100" as="geometry"/></mxCell><mxCell id="normal-e4" value="Erro: marcador não cadastrado&lt;br&gt;no SEI (nenhum memo criado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="1015" width="280" height="70" as="geometry"/></mxCell><mxCell id="normal-q5" value="Período variável&lt;br&gt;p/ dependentes?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1135" width="220" height="110" as="geometry"/></mxCell><mxCell id="normal-t5" value="➕ 1.1 - Período Variável p/ Dependentes" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1163" width="320" height="54" as="geometry"/></mxCell><mxCell id="normal-q6" value="Alguém usou&lt;br&gt;a rede própria?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1285" width="220" height="110" as="geometry"/></mxCell><mxCell id="normal-a6" value="Cria &lt;b&gt;memo DISA&lt;/b&gt; (quem usou e&lt;br&gt;quem não usou) e insere no&lt;br&gt;bloco &lt;b&gt;7697744&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="1305" width="260" height="70" as="geometry"/></mxCell><mxCell id="normal-a7" value="Cria &lt;b&gt;memo DEPROC&lt;/b&gt; (todos os&lt;br&gt;beneficiários) e insere no&lt;br&gt;bloco &lt;b&gt;7697744&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1445" width="260" height="70" as="geometry"/></mxCell><mxCell id="normal-t8" value="➕ 1.2 - Avaliado Se Usou Rede Própria" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1563" width="320" height="54" as="geometry"/></mxCell><mxCell id="normal-q9" value="Alguém usou?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1665" width="220" height="90" as="geometry"/></mxCell><mxCell id="normal-t9a" value="➕ 1.3 - Memos DISA e DEPROC no Bloco" style="shape=hexagon;perime