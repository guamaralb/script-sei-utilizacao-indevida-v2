 parent="c222"><mxGeometry x="24" y="1852" width="240" height="66" as="geometry"/></mxCell><mxCell id="c162" value="&lt;b&gt;DISA não × MANTIS RP sim&lt;/b&gt;&lt;br&gt;validar; não consta na planilha" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="290" y="1360" width="240" height="50" as="geometry"/></mxCell><mxCell id="c163" value="📎 PDF Utilização Tit./Dep. &lt;b&gt;RP&lt;/b&gt;" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="290" y="1438" width="240" height="46" as="geometry"/></mxCell><mxCell id="c164" value="📎 PDF Utilização Tit./Dep. &lt;b&gt;RC&lt;/b&gt;&lt;br&gt;(só de quem usou)" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="290" y="1512" width="240" height="62" as="geometry"/></mxCell><mxCell id="c165" value="📄 &lt;b&gt;MemoDisaValidarNaoConsta&lt;/b&gt;&lt;br&gt;no bloco BLOCO_MEMO_DISA_VALIDAR_NAO_CONSTA (TODO)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="290" y="1602" width="240" height="66" as="geometry"/></mxCell><mxCell id="c166" value="➕ 01.09 - No Bloco DISA: Validar (N Consta)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="290" y="1696" width="240" height="50" as="geometry"/></mxCell><mxCell id="c167" value="➖ 01.08 - Avaliado Uso Rede Própria MANTIS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex=