35" width="180" height="40" as="geometry"/></mxCell><mxCell id="c728" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c729" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c730" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c731" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c732" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c733" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c734" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c735" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c422" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_geacs_resp_apis / _disa / _deproc. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1260" as="geometry"/></mxCell><mxCell id="c404" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c405" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba geacs_resp_apis / geacs_resp_disa / geacs_resp_deproc de processos_a_processar.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="142" width="330" height="98" as="geometry"/></mxCell><mxCell id="c406" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="268" width="330" height="82" as="geometry"/></mxCell><mxCell id="c407" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="378" width="330" height="40" as="geometry"/></mxCell><mxCell id="c409" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="74" y="446" width="230" height="120" as="geometry"/></mxCell><mxCell id="c408" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="424" y="473" width="270" height="66" as="geometry"/></mxCell><mxCell id="c411" value="▶ processar_linha() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="594" width="330" height="40" as="geometry"/></mxCell><mxCell id="c412" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="662" width="330" height="66" as="geometry"/></mxCell><mxCell id="c413" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linha do processo: script (nome da aba), fluxo (RESP &amp;lt;unidade&amp;gt; - RESPOSTA DA &amp;lt;unidade&amp;gt;), prox_acao, erro e marcador_aguarda. Os resultados do fluxo inicial ficam como estão" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="756" width="330" height="98" as="geometry"/></mxCell><mxCell id="c415" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="74" y="882" width="230" height="90" as="geometry"/></mxCell><mxCell id="c414" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="424" y="902" width="270" height="50" as="geometry"/></mxCell><mxCell id="c418" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="74" y="1000" width="230" height="90" as="geometry"/></mxCell><mxCell id="c417" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="424" y="1025" width="270" height="40" as="geometry"/></mxCell><mxCell id="c420" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="1118" width="330" height="50" as="geometry"/></mxCell><mxCell id="c421" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c422"><mxGeometry x="24" y="1196" width="330" height="40" as="geometry"/></mxCell><mxCell id="c431" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · processar_linha() (fluxo_resposta.py)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;TODO: fluxos ainda não montados.&lt;/b&gt; Base comum dos três; cada main_geacs_resp_*.py define os marcadores &quot;Aguarda&quot; e a função tratar_resposta()&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="656" as="geometry"/></mxCell><mxCell id="c423" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_marcadores() · registrar_tags()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê os marcadores do processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c431"><mxGeometry x="24" y="90" width="330" height="50" as="geometry"/></mxCell><mxCell id="c424" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcador_aguarda()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;O estado atual precisa ser um dos &quot;Aguarda&quot; (manuais) do fluxo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c431"><mxGeometry x="24" y="168" width="330" height="66" as="geometry"/></mxCell><mxCell id="c426" value="Estado não é um &quot;Aguarda&quot;&lt;br&gt;do fluxo?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c431"><mxGeometry x="74" y="262" width="230" height="104" as="geometry"/></mxCell><mxCell id="c425" value="&lt;b&gt;SemMarcadorAguarda&lt;/b&gt;: não aguarda resposta desta unidade (ou o memo ainda não foi assinado). prox_acao = Verificar erro" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c431"><mxGeometry x="424" y="273" width="270" height="82" as="geometry"/></mxCell><mxCell id="c428" value="prox_acao = Aguardar resposta ao memo enviado (coluna marcador_aguarda)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c431"><mxGeometry x="24" y="394" width="330" height="50" as="geometry"/></mxCell><mxCell id="c429" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tratar_resposta()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;TODO&lt;/b&gt;: o que fazer com a resposta, por marcador (comentário em cada main_geacs_resp_*.py)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c431"><mxGeometry x="24" y="472" width="330" height="66" as="geometry"/></mxCell><mxCell id="c430" value="&lt;b&gt;FluxoNaoMontado&lt;/b&gt;: &quot;Fluxo ... ainda não montado&quot;, sem nenhuma ação no SEI. A prox_acao continua Aguardar resposta ao memo enviado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c431"><mxGeometry x="24" y="566" width="330" height="66" as="geometry"/></mxCell><mxCell id="c432" value="&lt;b&gt;Marcadores &quot;Aguarda&quot; de cada fluxo&lt;/b&gt; (manuais: quem assina o memo coloca o &quot;Aguarda&quot; e remove o &quot;No Bloco&quot;)&lt;br&gt;&lt;br&gt;&lt;b&gt;run_geacs_resp_apis&lt;/b&gt; (TAGS_AGUARDA_RESPOSTA_APIS)&lt;br&gt;01.05.1 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;01.05.1 - Aguarda APIS: Formato Inválido&lt;br&gt;01.06.1.1 - Aguarda APIS: Matrículas&lt;br&gt;01.07.1 - Aguarda APIS: Período Deps&lt;br&gt;01.10.1 - Aguarda APIS: Sem Uso&lt;br&gt;&lt;br&gt;&lt;b&gt;run_geacs_resp_disa&lt;/b&gt; (TAGS_AGUARDA_RESPOSTA_DISA)&lt;br&gt;01.09.1 - Aguarda DISA: Validar (Consta)&lt;br&gt;01.09.1 - Aguarda DISA: Validar (N Consta)&lt;br&gt;01.09.1 - Aguarda DISA: Relat. s/ MANTIS&lt;br&gt;&lt;br&gt;&lt;b&gt;run_geacs_resp_deproc&lt;/b&gt; (TAGS_AGUARDA_RESPOSTA_DEPROC)&lt;br&gt;01.10.1 - Aguarda DEPROC: Coparticipação" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1636" y="270" width="420" height="290" as="geometry"/></mxCell><mxCell id="c736" value="" style="ed