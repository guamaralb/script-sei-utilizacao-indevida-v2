<mxfile host="app.diagrams.net" type="device"><diagram id="fluxo-completo" name="Fluxo completo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4584" pageHeight="3944" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c285" value="Fluxo do script SEI - Utilização Indevida (v2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="44" as="geometry"/></mxCell><mxCell id="c286" value="Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1200" height="28" as="geometry"/></mxCell><mxCell id="c274" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c275" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c276" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c277" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c278" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c279" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c280" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c281" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c282" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c283" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c284" value="&lt;b&gt;Pendências (TODO)&lt;/b&gt;&lt;br&gt;• no SEI: renomear 01.10 - Aguarda APIS: Sem Uso para 01.10 - No Bloco APIS: Sem Uso&lt;br&gt;• blocos dos três memos à DISA e do memo à APIS sem uso (constantes = None)&lt;br&gt;• revisar os textos e assuntos dos memos com TEXTO_DEFINIDO = False&lt;br&gt;• fluxo do processo VELHO&lt;br&gt;• tratar a resposta dos processos parados (APIS e DISA)" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2170" y="100" width="460" height="162" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Carrega as bases, faz login e passa cada processo pelo fluxo. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1512" as="geometry"/></mxCell><mxCell id="c10" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="90" width="330" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria as pastas e o log da execução" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="158" width="330" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;carregar_bases() · carregar_bases_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a aba geacs de processos_a_processar.xlsx, a base DISA, a base APIS e o MANTIS (rede própria e credenciada)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="236" width="330" height="82" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (alterar_unidade_sei: TODO na sei_automacao)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="346" width="330" height="82" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="456" width="330" height="40" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_processar_linha()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Abre o processo e lê os marcadores do SEI. Unidade sem acesso (UnidadeSemAcessoException): registrar_sem_acesso(), prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;acessar_processo, registrar_tags&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="524" width="330" height="130" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tem_incluir_documento()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Sem o botão Incluir Documento = processo fechado no setor. Só registra: quem decide reabrir é _tratar() (coluna 2)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="682" width="330" height="82" as="geometry"/></mxCell><mxCell id="c17" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;registrar_arvore()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a árvore do processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="792" width="330" height="50" as="geometry"/></mxCell><mxCell id="c18" value="▶ _tratar() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="870" width="330" height="40" as="geometry"/></mxCell><mxCell id="c19" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;De novo, no fim da passagem (se não houve erro)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="938" width="330" height="66" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Erro levantado em qualquer coluna?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;: tipo_erro, erro e prox_acao = Verificar erro (ou a já definida). Inesperado: + traceback e recarrega a página (tela presa não derruba os próximos processos)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="1032" width="330" height="98" as="geometry"/></mxCell><mxCell id="c21" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Regrava a planilha de controle (abas processos e historico) depois de cada processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="1158" width="330" height="66" as="geometry"/></mxCell><mxCell id="c23" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="74" y="1252" width="230" height="90" as="geometry"/></mxCell><mxCell id="c22" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="424" y="1277" width="270" height="40" as="geometry"/></mxCell><mxCell id="c25" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="1370" width="330" height="50" as="geometry"/></mxCell><mxCell id="c26" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c27"><mxGeometry x="24" y="1448" width="330" height="40" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · _tratar()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Separa o processo VELHO e roteia pelos marcadores lidos do SEI. Só adiciona o marcador 01 (e o 00, em _separar_velho); o resto é decidido em processar_novo()&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="3078" as="geometry"/></mxCell><mxCell id="c28" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A combinação de marcadores é possível no fluxo?&lt;br&gt;• no máximo um marcador de estado (★)&lt;br&gt;• no máximo um de cada par: 01.06.2 - Base DISA: Usou RP / 01.06.2 - Base DISA: Não Usou RP, 01.08.2 - MANTIS: Usou RP / 01.08.2 - MANTIS: Não Usou RP e 01.08.3 - MANTIS: Usou RC / 01.08.3 - MANTIS: Não Usou RC&lt;br&gt;• informativo só com estado compatível&lt;br&gt;• 01.06.1 - No Bloco APIS: Matrículas exige 01.02.1 - Mat. N Encontradas Base APIS&lt;br&gt;• 01.07 - No Bloco APIS: Período Deps exige 01.01 - Período Variável p/ Dependentes&lt;br&gt;• cada 01.09 - No Bloco DISA exige o seu par: Validar (Consta) = DISA e MANTIS Usou RP; Validar (N Consta) = DISA Não Usou e MANTIS Usou RP; Relat. s/ MANTIS = DISA Usou e MANTIS Não Usou RP&lt;br&gt;• 01.10 - No Bloco APIS: Sem Uso exige 01.06.2 - Base DISA: Não Usou RP, 01.08.2 - MANTIS: Não Usou RP e 01.08.3 - MANTIS: Não Usou RC&lt;br&gt;• cada &quot;Aguarda&quot; manual (.1) segue a mesma regra do seu &quot;No Bloco&quot;&lt;br&gt;• VELHO (00 - Processo VELHO ou 01.03 - Memos DISA e DEPROC no Bloco) sem memos à DISA ou à DEPROC do fluxo atual (01.09, 01.10)…" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="24" y="90" width="330" height="466" as="geometry"/></mxCell><mxCell id="c30" value="Marcadores&lt;br&gt;inconsistentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="74" y="584" width="230" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;MarcadoresInconsistentes&lt;/b&gt;: nada é feito no SEI&lt;br&gt;prox_acao = Verificar marcadores (corrigir no SEI)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="588" width="270" height="82" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;VELHO&lt;/b&gt; pelos marcadores?&lt;br&gt;00 - Processo VELHO ou&lt;br&gt;01.03 - Memos DISA e DEPROC no Bloco" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="24" y="702" width="330" height="120" as="geometry"/></mxCell><mxCell id="c32" value="▶ _separar_velho()&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;à direita&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="737" width="270" height="50" as="geometry"/></mxCell><mxCell id="c35" value="&lt;font face=&quot;Courier New&quot;&gt;estado_atual()&lt;/font&gt;: marcador de estado do processo" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="24" y="850" width="330" height="50" as="geometry"/></mxCell><mxCell id="c37" value="Memo no bloco (aguarda assinatura)?&lt;br&gt;01.05 - No Bloco APIS: Sem Memo p/ GEACS&lt;br&gt;01.05 - No Bloco APIS: Formato Inválido&lt;br&gt;01.06.1 - No Bloco APIS: Matrículas&lt;br&gt;01.07 - No Bloco APIS: Período Deps&lt;br&gt;01.09 - No Bloco DISA: Validar (Consta)&lt;br&gt;01.09 - No Bloco DISA: Validar (N Consta)&lt;br&gt;01.09 - No Bloco DISA: Relat. s/ MANTIS&lt;br&gt;01.10 - No Bloco DEPROC: Coparticipação&lt;br&gt;01.10 - No Bloco APIS: Sem Uso" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="24" y="928" width="330" height="376" as="geometry"/></mxCell><mxCell id="c36" value="prox_acao = Assinar o memo correspondente e encaminhar&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;quem assina coloca o &quot;Aguarda&quot; (.1) e remove o &quot;No Bloco&quot;&lt;/span&gt;" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="1075" width="270" height="82" as="geometry"/></mxCell><mxCell id="c40" value="Estado de parada (memo assinado)?&lt;br&gt;01.05.1 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;01.05.1 - Aguarda APIS: Formato Inválido&lt;br&gt;01.06.1.1 - Aguarda APIS: Matrículas&lt;br&gt;01.07.1 - Aguarda APIS: Período Deps&lt;br&gt;01.09.1 - Aguarda DISA: Validar (Consta)&lt;br&gt;01.09.1 - Aguarda DISA: Validar (N Consta)&lt;br&gt;01.09.1 - Aguarda DISA: Relat. s/ MANTIS&lt;br&gt;01.10.1 - Aguarda DEPROC: Coparticipação&lt;br&gt;01.10.1 - Aguarda APIS: Sem Uso (todos manuais)&lt;br&gt;versão anterior: 01.08.1 - Memo DISA Validar Usos MANTIS, 01.09 - Memo DISA Uso Rede Própria" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="24" y="1332" width="330" height="440" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Erro&lt;/b&gt;: parado aguardando resposta ao memo&lt;br&gt;prox_acao = Aguardar resposta ao memo enviado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="1511" width="270" height="82" as="geometry"/></mxCell><mxCell id="c43" value="Estado de conclusão?&lt;br&gt;versão anterior: 01.10 - Concluído: Memos DISA e DEPROC" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="24" y="1800" width="330" height="120" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Concluído&lt;/b&gt;, prox_acao = assinar os memos DISA e DEPROC" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="1835" width="270" height="50" as="geometry"/></mxCell><mxCell id="c46" value="NOVO sem estado com&lt;br&gt;01.03 - Memo DEPROC no Bloco?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="74" y="1948" width="230" height="120" as="geometry"/></mxCell><mxCell id="c45" value="Concluído na versão anterior&lt;br&gt;prox_acao = Assinar memo DEPROC" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="1983" width="270" height="50" as="geometry"/></mxCell><mxCell id="c48" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_memos_velho()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê &lt;b&gt;todos os memorandos da GEACS&lt;/b&gt; e procura dois seguidos: &quot;Para: IPSEMG/DISA-UTI-INDEV&quot; e depois &quot;Para: IPSEMG/DEPROC&quot;, os dois datados (&quot;Belo Horizonte, 18 de setembro de 2026.&quot;) antes de 01/10/2026" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="24" y="2096" width="330" height="114" as="geometry"/></mxCell><mxCell id="c50" value="Par sem data&lt;br&gt;legível?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="74" y="2238" width="230" height="90" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: não dá para saber se é VELHO; nada é feito no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="2258" width="270" height="50" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;VELHO&lt;/b&gt; pelos memos&lt;br&gt;da GEACS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="74" y="2356" width="230" height="104" as="geometry"/></mxCell><mxCell id="c52" value="▶ _separar_velho()&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;à direita&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="2383" width="270" height="50" as="geometry"/></mxCell><mxCell id="c59" value="Processo &lt;b&gt;fechado&lt;/b&gt; no setor?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="74" y="2488" width="230" height="90" as="geometry"/></mxCell><mxCell id="c56" value="Com MANUAL ou ASSINADO, ou sem&lt;br&gt;memo da APIS para a GEACS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="454" y="2488" width="270" height="120" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;: não reabre, nada é feito no SEI&lt;br&gt;prox_acao = Verificar erro" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="824" y="2515" width="270" height="66" as="geometry"/></mxCell><mxCell id="c58" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;reabrir_processo_fechado()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Reabre o processo na unidade (continua aberto) e relê a árvore. Coluna processo_reaberto. Não reabriu: ProcessoFechadoNoSetor&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;reabrir_processo, listar_documentos_arvore&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="2636" width="270" height="130" as="geometry"/></mxCell><mxCell id="c64" value="Sem o marcador&lt;br&gt;&lt;b&gt;01 - Tratado pelo Script&lt;/b&gt;?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="74" y="2794" width="230" height="104" as="geometry"/></mxCell><mxCell id="c62" value="➕ 01 - Tratado pelo Script" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="2826" width="270" height="40" as="geometry"/></mxCell><mxCell id="c63" value="▶ processar_novo() do início — coluna 3" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="424" y="2894" width="270" height="50" as="geometry"/></mxCell><mxCell id="c67" value="▶ processar_novo() — coluna 3&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;do início (sem estado ou com 01.00 - Aguarda Script: Fluxo Normal, que o fluxo ADC PDF ANT AUT deixa) ou retomando de 01.06 - Avaliado Uso Rede Própria DISA ou 01.08 - Avaliado Uso Rede Própria MANTIS&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c68"><mxGeometry x="24" y="2940" width="330" height="114" as="geometry"/></mxCell><mxCell id="c136" value="&lt;b style=&quot;font-size:16px&quot;&gt;3 · processar_novo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Memo da APIS, base APIS e base DISA, e as paradas com memo à APIS. Na retomada, as etapas já feitas são puladas (_etapa_feita)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="1596" y="270" width="718" height="3094" as="geometry"/></mxCell><mxCell id="c69" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Usa o &lt;b&gt;último&lt;/b&gt; memo da APIS destinado à GEACS; os documentos depois dele são a rodada. Procura &lt;b&gt;primeiro o modelo com período por dependente&lt;/b&gt; (linha &lt;i&gt;Período de apuração do dependente:&lt;/i&gt;; duplas matrícula + período) e, se não for ele, analisa como novo_novo&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;obter_memos_apis_para_geacs, validar_template, extrair_dados_ui&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="24" y="90" width="330" height="162" as="geometry"/></mxCell><mxCell id="c75" value="Nenhum memo da APIS&lt;br&gt;para a GEACS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="74" y="280" width="230" height="104" as="geometry"/></mxCell><mxCell id="c70" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_sem_memo_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="307" width="270" height="50" as="geometry"/></mxCell><mxCell id="c71" value="📄 &lt;b&gt;MemoApisSemMemo&lt;/b&gt;&lt;br&gt;no bloco 7730344" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="385" width="270" height="50" as="geometry"/></mxCell><mxCell id="c72" value="➕ 01.05 - No Bloco APIS: Sem Memo p/ GEACS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="463" width="270" height="50" as="geometry"/></mxCell><mxCell id="c73" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="541" width="270" height="40" as="geometry"/></mxCell><mxCell id="c74" value="prox_acao = Assinar memo à APIS (sem memorando)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="609" width="270" height="50" as="geometry"/></mxCell><mxCell id="c86" value="Formato inválido?&lt;br&gt;(período por dependente incompleto,&lt;br&gt;não é novo_novo ou período&lt;br&gt;do titular inválido)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="74" y="660" width="230" height="200" as="geometry"/></mxCell><mxCell id="c81" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_formato_invalido()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="735" width="270" height="50" as="geometry"/></mxCell><mxCell id="c82" value="📄 &lt;b&gt;MemoApisFormatoInvalido&lt;/b&gt;&lt;br&gt;no bloco 7730341" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="813" width="270" height="50" as="geometry"/></mxCell><mxCell id="c83" value="➕ 01.05 - No Bloco APIS: Formato Inválido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="891" width="270" height="50" as="geometry"/></mxCell><mxCell id="c84" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="969" width="270" height="40" as="geometry"/></mxCell><mxCell id="c85" value="prox_acao = Assinar memo à APIS (formato inválido)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1037" width="270" height="50" as="geometry"/></mxCell><mxCell id="c92" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;verificar_base_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A existência das matrículas é conferida &lt;b&gt;só na base APIS&lt;/b&gt; (a base DISA é feita a partir dela). Do memo, vêm com ou sem DV; a base APIS diz qual é a matrícula" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="24" y="1040" width="330" height="98" as="geometry"/></mxCell><mxCell id="c94" value="Matrícula em&lt;br&gt;formato inválido?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="74" y="1166" width="230" height="104" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1198" width="270" height="40" as="geometry"/></mxCell><mxCell id="c102" value="Faltou matrícula&lt;br&gt;na base APIS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="74" y="1298" width="230" height="90" as="geometry"/></mxCell><mxCell id="c96" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_nao_encontradas_base_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;garantir_marcadores_no_sei, incluir_memo_apis_mat_nao_encontradas&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1302" width="270" height="82" as="geometry"/></mxCell><mxCell id="c97" value="➕ 01.02.1 - Mat. N Encontradas Base APIS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1412" width="270" height="50" as="geometry"/></mxCell><mxCell id="c98" value="📄 &lt;b&gt;MemoApisMatNaoEncontradas&lt;/b&gt;&lt;br&gt;no bloco 7711907" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1490" width="270" height="50" as="geometry"/></mxCell><mxCell id="c99" value="➕ 01.06.1 - No Bloco APIS: Matrículas" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1568" width="270" height="50" as="geometry"/></mxCell><mxCell id="c100" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1646" width="270" height="40" as="geometry"/></mxCell><mxCell id="c101" value="prox_acao = Assinar memo à APIS (matrículas não encontradas)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1714" width="270" height="50" as="geometry"/></mxCell><mxCell id="c110" value="Tem 01.02.1 - Mat. N Encontradas Base APIS?&lt;br&gt;(base corrigida)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="24" y="1788" width="330" height="104" as="geometry"/></mxCell><mxCell id="c109" value="➖ 01.02.1 - Mat. N Encontradas Base APIS&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;remove e segue o fluxo (abaixo)&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="1807" width="270" height="66" as="geometry"/></mxCell><mxCell id="c112" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_avaliar_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Uso da rede própria na base DISA. Fora da base DISA = não usou&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;avaliar_uso_rede_propria_disa, registrar_uso, garantir_marcadores_no_sei&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="24" y="1920" width="330" height="98" as="geometry"/></mxCell><mxCell id="c114" value="Resposta inválida&lt;br&gt;na base DISA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="74" y="2046" width="230" height="104" as="geometry"/></mxCell><mxCell id="c113" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="2078" width="270" height="40" as="geometry"/></mxCell><mxCell id="c119" value="Alguém usou a rede própria&lt;br&gt;segundo a &lt;b&gt;base DISA&lt;/b&gt;?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="209" y="2178" width="300" height="104" as="geometry"/></mxCell><mxCell id="c116" value="➕ 01.06.2 - Base DISA: Usou RP" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="106" y="2342" width="240" height="50" as="geometry"/></mxCell><mxCell id="c117" value="➕ 01.06.2 - Base DISA: Não Usou RP" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="372" y="2342" width="240" height="50" as="geometry"/></mxCell><mxCell id="c118" value="➕ 01.06 - Avaliado Uso Rede Própria DISA&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;pulado na retomada; remove o estado anterior&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="194" y="2452" width="330" height="82" as="geometry"/></mxCell><mxCell id="c128" value="Período variável&lt;br&gt;para dependentes?&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;(nunca no modelo com período por dependente)&lt;/span&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="74" y="2562" width="230" height="152" as="geometry"/></mxCell><mxCell id="c122" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_periodo_variavel()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="2613" width="270" height="50" as="geometry"/></mxCell><mxCell id="c123" value="➕ 01.01 - Período Variável p/ Dependentes" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="2691" width="270" height="50" as="geometry"/></mxCell><mxCell id="c124" value="📄 &lt;b&gt;MemoApisPeriodoDependentes&lt;/b&gt;&lt;br&gt;no bloco 7730905" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="2769" width="270" height="50" as="geometry"/></mxCell><mxCell id="c125" value="➕ 01.07 - No Bloco APIS: Período Deps" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="2847" width="270" height="50" as="geometry"/></mxCell><mxCell id="c126" value="➖ 01.06 - Avaliado Uso Rede Própria DISA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="2925" width="270" height="50" as="geometry"/></mxCell><mxCell id="c127" value="prox_acao = Assinar memo à APIS (período dos dependentes)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="424" y="3003" width="270" height="50" as="geometry"/></mxCell><mxCell id="c135" value="▶ _avaliar_mantis_e_criar_docs() — coluna 4" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c136"><mxGeometry x="24" y="3030" width="330" height="40" as="geometry"/></mxCell><mxCell id="c229" value="&lt;b style=&quot;font-size:16px&quot;&gt;4 · _avaliar_mantis_e_criar_docs()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;MANTIS e a comparação base DISA × MANTIS, pelo processo inteiro (alguém usou). O memo à DISA depende só da rede própria (RP); a rede credenciada (RC) só separa DEPROC de APIS quando ninguém usou a RP. Cada caso tem o seu memo e o seu bloco. &lt;b&gt;Os relatórios RP e RC de quem usou entram em todos os casos&lt;/b&gt;; &lt;b&gt;quem vai para a DISA não vai para a DEPROC&lt;/b&gt;&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="2374" y="270" width="1352" height="2652" as="geometry"/></mxCell><mxCell id="c137" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;avaliar_uso_rede_propria_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Atendimentos no período do titular (no modelo com período por dependente, no de cada dependente), nas duas redes&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;interpretar_periodo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="24" y="90" width="330" height="98" as="geometry"/></mxCell><mxCell id="c139" value="Período ou data&lt;br&gt;de atendimento&lt;br&gt;inválidos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="74" y="216" width="230" height="104" as="geometry"/></mxCell><mxCell id="c138" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="424" y="248" width="270" height="40" as="geometry"/></mxCell><mxCell id="c141" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_registrar_uso_mantis() · usos_mantis_alem_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Planilha: uso nas duas redes, caso_disa_mantis e mats_uso_mantis_alem_disa (RP no MANTIS e fora da base DISA)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="24" y="348" width="330" height="98" as="geometry"/></mxCell><mxCell id="c142" value="Escolhe o memo pelo caso (abaixo) e o monta &lt;b&gt;antes de qualquer ação no SEI&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="24" y="474" width="330" height="50" as="geometry"/></mxCell><mxCell id="c144" value="Texto do memo&lt;br&gt;pendente?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="74" y="552" width="230" height="90" as="geometry"/></mxCell><mxCell id="c143" value="&lt;b&gt;TextoMemoPendente&lt;/b&gt;&lt;br&gt;nada é criado no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="424" y="572" width="270" height="50" as="geometry"/></mxCell><mxCell id="c147" value="Bloco do memo (DISA ou&lt;br&gt;APIS sem uso) não&lt;br&gt;configurado (None)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="74" y="670" width="230" height="152" as="geometry"/></mxCell><mxCell id="c146" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;&lt;br&gt;nada é criado no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c229"><mxGeometry x="424" y="721" width="270" height="50" as="geometry"/></mxCell><mxCell id="c149" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Os marcadores que serão adicionados existem no SEI?" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent