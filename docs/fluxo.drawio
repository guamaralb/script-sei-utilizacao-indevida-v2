dgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="correcao-a7" target="correcao-a8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="correcao-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="correcao-a8" target="correcao-t9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="correcao-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="correcao-t9" target="correcao-t10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="correcao-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="correcao-t10" target="correcao-a11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="correcao-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="correcao-a11" target="correcao-f11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="correcao-n1" value="&lt;b&gt;Quem chama&lt;/b&gt;&lt;br&gt;- main.py (_tratar_novo): matrículas lidas do último memo da APIS;&lt;br&gt;- script de correção: matrículas da planilha compilada (colunas matricula_titular e matriculas_dependentes)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="155" width="240" height="150" as="geometry"/></mxCell><mxCell id="correcao-n2" value="&lt;b&gt;Marcadores só com o processo reaberto&lt;/b&gt;&lt;br&gt;Todo marcador desta rotina é adicionado depois de reabrir o processo na unidade." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="565" width="240" height="110" as="geometry"/></mxCell><mxCell id="correcao-n3" value='&lt;b&gt;Memo de correção só existe se alguém NÃO usou&lt;/b&gt; (MemoDisaUsoRede levanta ValueError se todos usaram). É identificado na árvore pelo assunto (PADRAO_ASSUNTO_MEMO_USO_REDE, aceita a grafia antiga "Rede Prória").' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1215" width="240" height="170" as="geometry"/></mxCell><mxCell id="correcao-n4" value="&lt;b&gt;Ordem: ➕1.4 antes de ➕1.2&lt;/b&gt;&lt;br&gt;Se falhar entre os dois, a próxima execução entra pela retomada (tem 1.4, sem 1.2) e só adiciona 1.2." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="1385" width="260" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="matriculas" name="5. Matrículas não encontradas"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="matriculas-tit" value="5. Matrículas não encontradas (matriculas_nao_encontradas.marcar_matriculas_nao_encontradas)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="-20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="matriculas-ini" value="Entrada: avaliar_uso levantou&lt;br&gt;MatriculasNaoEncontradas&lt;br&gt;(resultado de cada base)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="45" width="300" height="70" as="geometry"/></mxCell><mxCell id="matriculas-a1" value="Registra as matrículas na planilha:&lt;br&gt;base geral → titular_nao_encontrado_base_geral,&lt;br&gt;deps_nao_encontrados_base_geral&lt;br&gt;rede própria → titular_nao_encontrado,&lt;br&gt;deps_nao_encontrados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="160" width="340" height="100" as="geometry"/></mxCell><mxCell id="matriculas-a1b" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Verificar matrículas não encontradas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="295" width="300" height="50" as="geometry"/></mxCell><mxCell id="matriculas-a2" value="garantir_marcadores_no_sei&lt;br&gt;[marcadores das bases afetadas]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="380" width="260" height="60" as="geometry"/></mxCell><mxCell id="matriculas-q2" value="Todos existem&lt;br&gt;no SEI?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="220" height="100" as="geometry"/></mxCell><mxCell id="matriculas-e2" value="Erro: marcador não cadastrado&lt;br&gt;no SEI (nenhum memo criado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="485" width="280" height="70" as="geometry"/></mxCell><mxCell id="matriculas-q3" value="Faltou na&lt;br&gt;&lt;b&gt;base geral&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="605" width="220" height="110" as="geometry"/></mxCell><mxCell id="matriculas-q4" value="Bloco do memo&lt;br&gt;à APIS configurado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="685" y="605" width="230" height="110" as="geometry"/></mxCell><mxCell id="matriculas-e4" value="Erro: BLOCO_MEMO_APIS_MAT_&lt;br&gt;NAO_ENCONTRADAS = None&lt;br&gt;(sem memo e sem marcador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="620" width="280" height="80" as="geometry"/></mxCell><mxCell id="matriculas-q5" value="Memo à APIS já&lt;br&gt;existe na árvore&lt;br&gt;(pelo assunto)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="685" y="750" width="230" height="120" as="geometry"/></mxCell><mxCell id="matriculas-a5" value="Retomada: não recria o memo&lt;br&gt;(memo_apis_mat_nao_encontradas_na_arvore)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="775" width="300" height="70" as="geometry"/></mxCell><mxCell id="matriculas-a6" value="Cria &lt;b&gt;MemoApisMatNaoEncontradas&lt;/b&gt;&lt;br&gt;(devolve à APIS para conferir&lt;br&gt;as matrículas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="925" width="280" height="70" as="geometry"/></mxCell><mxCell id="matriculas-a7" value="Insere no bloco &lt;b&gt;7711907&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="1030" width="260" height="60" as="geometry"/></mxCell><mxCell id="matriculas-t8" value="➕ 1.2.1 (NOVO) ou 2.1.1 (VELHO)&lt;br&gt;Mat. N Encontradas Base Geral" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1130" width="320" height="60" as="geometry"/></mxCell><mxCell id="matriculas-a8" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Assinar memo à APIS (matrículas&lt;br&gt;não encontradas) e encaminhar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="1230" width="300" height="60" as="geometry"/></mxCell><mxCell id="matriculas-q9" value="Faltou na&lt;br&gt;&lt;b&gt;base da rede&lt;br&gt;própria&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1330" width="220" height="120" as="geometry"/></mxCell><mxCell id="matriculas-t9" value="➕ 1.2.2 (NOVO) ou 2.1.2 (VELHO)&lt;br&gt;Mat. N Encontradas Base DISA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="1360" width="320" height="60" as="geometry"/></mxCell><mxCell id="matriculas-a10" value="Se o memo foi criado: relê a árvore&lt;br&gt;→ número SEI do memo à APIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1490" width="300" height="60" as="geometry"/></mxCell><mxCell id="matriculas-f10" value="&lt;b&gt;Quem chamou relança o erro&lt;/b&gt;: processo parado,&lt;br&gt;sem memos DISA/DEPROC e sem 1.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="1595" width="340" height="70" as="geometry"/></mxCell><mxCell id="matriculas-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="matriculas-ini" target="matriculas-a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="matriculas-a1" target="matriculas-a1b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="matriculas-a1b" target="matriculas-a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="matriculas-a2" target="matriculas-q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-e5" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exit