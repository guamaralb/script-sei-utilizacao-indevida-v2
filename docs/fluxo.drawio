=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c872" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c873" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c874" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c875" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c876" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c877" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c878" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c879" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c880" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c476" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_geacs_resp_apis / _disa / _deproc. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1260" as="geometry"/></mxCell><mxCell id="c458" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c459" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba geacs_resp_apis / geacs_resp_disa / geacs_resp_deproc de processos_a_processar.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="142" width="330" height="98" as="geometry"/></mxCell><mxCell id="c460" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="268" width="330" height="82" as="geometry"/></mxCell><mxCell id="c461" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="378" width="330" height="40" as="geometry"/></mxCell><mxCell id="c463" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="74" y="446" width="230" height="120" as="geometry"/></mxCell><mxCell id="c462" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="424" y="473" width="270" height="66" as="geometry"/></mxCell><mxCell id="c465" value="▶ processar_linha() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="594" width="330" height="40" as="geometry"/></mxCell><mxCell id="c466" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="662" width="330" height="66" as="geometry"/></mxCell><mxCell id="c467" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linha do processo: script (nome da aba), fluxo (RESP &amp;lt;unidade&amp;gt; - RESPOSTA DA &amp;lt;unidade&amp;gt;), prox_acao, erro e marcador_aguarda. Os resultados do fluxo inicial ficam como estão" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="756" width="330" height="98" as="geometry"/></mxCell><mxCell id="c469" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="74" y="882" width="230" height="90" as="geometry"/></mxCell><mxCell id="c468" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="424" y="902" width="270" height="50" as="geometry"/></mxCell><mxCell id="c472" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="74" y="1000" width="230" height="90" as="geometry"/></mxCell><mxCell id="c471" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="424" y="1025" width="270" height="40" as="geometry"/></mxCell><mxCell id="c474" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="1118" width="330" height="50" as="geometry"/></mxCell><mxCell id="c475" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c476"><mxGeometry x="24" y="1196" width="330" height="40" as="geometry"/></mxCell><mxCell id="c485" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · processar_linha() (fluxo_resposta.py)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;TODO: fluxos ainda não montados.&lt;/b&gt; Base comum dos três; cada main_geacs_resp_*.py define os marcadores &quot;Aguarda&quot; e a função tratar_resposta()&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="656" as="geometry"/></mxCell><mxCell id="c477" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_marcadores() · registrar_tags()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê os marcadores do processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c485"><mxGeometry x="24" y="90" width="330" height="50" as="geometry"/></mxCell><mxCell id="c478" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcador_aguarda()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;O estado atual precisa ser um dos &quot;Aguarda&quot; (manuais) do fluxo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c485"><mxGeometry x="24" y="168" width="330" height="66" as="geometry"/></mxCell><mxCell id="c480" value="Estado não é um &quot;Aguarda&quot;&lt;br&gt;do fluxo?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c485"><mxGeometry x="74" y="262" width="230" height="104" as="geometry"/></mxCell><mxCell id="c479" value="&lt;b&gt;SemMarcadorAguarda&lt;/b&gt;: não aguarda resposta desta unidade (ou o memo ainda não foi assinado). prox_acao = Verificar erro" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c485"><mxGeometry x="424" y="273" width="270" height="82" as="geometry"/></mxCell><mxCell id="c482" value="prox_acao = Aguardar resposta ao memo enviado (coluna marcador_aguarda)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c485"><mxGeometry x="24" y="394" width="330" height="50" as="geometry"/></mxCell><mxCell id="c483" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;tratar_resposta()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;TODO&lt;/b&gt;: o que fazer com a resposta, por marcador (comentário em cada main_geacs_resp_*.py)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c485"><mxGeometry x="24" y="472" width="330" height="66" as="geometry"/></mxCell><mxCell id="c484" value="&lt;b&gt;FluxoNaoMontado&lt;/b&gt;: &quot;Fluxo ... ainda não montado&quot;, sem nenhuma ação no SEI. A prox_acao continua Aguardar resposta ao memo enviado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c485"><mxGeometry x="24" y="566" width="330" height="66" as="geometry"/></mxCell><mxCell id="c486" value="&lt;b&gt;Marcadores &quot;Aguarda&quot; de cada fluxo&lt;/b&gt; (manuais: quem assina o memo coloca o &quot;Aguarda&quot; e remove o &quot;No Bloco&quot;)&lt;br&gt;&lt;br&gt;&lt;b&gt;run_geacs_resp_apis&lt;/b&gt; (TAGS_AGUARDA_RESPOSTA_APIS)&lt;br&gt;01.05.B.1 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;01.05.A.1 - Aguarda APIS: Formato Inválido&lt;br&gt;01.06.1.1 - Aguarda APIS: Matrículas&lt;br&gt;01.07.1 - Aguarda APIS: Período Deps&lt;br&gt;01.10.A.1 - Aguarda APIS: Sem Uso&lt;br&gt;&lt;br&gt;&lt;b&gt;run_geacs_resp_disa&lt;/b&gt; (TAGS_AGUARDA_RESPOSTA_DISA)&lt;br&gt;01.09.B.1 - Aguarda DISA: Validar (Consta)&lt;br&gt;01.09.C.1 - Aguarda DISA: Validar (N Consta)&lt;br&gt;01.09.A.1 - Aguarda DISA: Relat. s/ MANTIS&lt;br&gt;&lt;br&gt;&lt;b&gt;run_geacs_resp_deproc&lt;/b&gt; (TAGS_AGUARDA_RESPOSTA_DEPROC)&lt;br&gt;01.10.B.1 - Aguarda DEPROC: Coparticipação" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1636" y="270" width="420" height="290" as="geometry"/></mxCell><mxCell id="c881" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c459" target="c460"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c882" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c460" target="c461"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c883" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c461" target="c463"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c884" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c463" target="c465"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c885" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c463" target="c462"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c886" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c465" target="c466"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c887" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c466" target="c467"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c888" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c467" target="c469"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c889" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c469" target="c472"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c890" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c469" target="c468"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c891" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c472" target="c474"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c892" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c472" target="c471"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c893" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c474" target="c475"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c894" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c477" target="c478"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c895" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c478" target="c480"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c896" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c480" target="c482"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c897" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c480" target="c479"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c898" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c482" target="c483"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c899" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c483" target="c484"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="geacs-adc-pdf-ant-aut" name="geacs_adc_pdf_ant_aut"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2374" pageHeight="1698" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c900" value="run_geacs_adc_pdf_ant_aut · PDF das planilhas antigas, automático (main_geacs_adc_pdf_ant_aut.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c901" value="Baixa as planilhas de utilização do SEI, insere o PDF de cada uma e deixa o processo aguardando o fluxo inicial. Não avalia bases nem cria memos. Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c902" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c903" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c904" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c905" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c906" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c907" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c908" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c909" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c910" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c911" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c296" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_geacs_adc_pdf_ant_aut. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1260" as="geometry"/></mxCell><mxCell id="c278" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c279" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba geacs_adc_pdf_ant_aut de processos_a_processar.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="142" width="330" height="82" as="geometry"/></mxCell><mxCell id="c280" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="252" width="330" height="82" as="geometry"/></mxCell><mxCell id="c281" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="362" width="330" height="40" as="geometry"/></mxCell><mxCell id="c283" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="74" y="430" width="230" height="120" as="geometry"/></mxCell><mxCell id="c282" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="424" y="457" width="270" height="66" as="geometry"/></mxCell><mxCell id="c285" value="▶ inserir_pdfs_das_planilhas() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="578" width="330" height="40" as="geometry"/></mxCell><mxCell id="c286" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="646" width="330" height="66" as="geometry"/></mxCell><mxCell id="c287" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linha do processo: script, fluxo e prox_acao do ADC PDF ANT AUT; planilhas_sei, pdfs_incluidos, pdfs_na_arvore, pdfs_antigos_a_excluir, processo_reaberto. Os resultados do fluxo inicial ficam como estão" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="740" width="330" height="114" as="geometry"/></mxCell><mxCell id="c289" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="74" y="882" width="230" height="90" as="geometry"/></mxCell><mxCell id="c288" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="424" y="902" width="270" height="50" as="geometry"/></mxCell><mxCell id="c292" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="74" y="1000" width="230" height="90" as="geometry"/></mxCell><mxCell id="c291" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="424" y="1025" width="270" height="40" as="geometry"/></mxCell><mxCell id="c294" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="1118" width="330" height="50" as="geometry"/></mxCell><mxCell id="c295" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c296"><mxGeometry x="24" y="1196" width="330" height="40" as="geometry"/></mxCell><mxCell id="c314" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · inserir_pdfs_das_planilhas()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Baixa as planilhas antigas do SEI e insere o PDF de cada uma. Retomada pelo nº SEI da planilha no nome do PDF (toda a árvore)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="1388" as="geometry"/></mxCell><mxCell id="c297" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;registrar_tags() · garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Confere se o 01 e o 01.00 existem no SEI (faltando, nada é inserido) e lista a árvore" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="24" y="90" width="330" height="82" as="geometry"/></mxCell><mxCell id="c298" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar planilhas&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Três primeiras palavras do nome: Planilha Utilização Titular, Planilha Utilização Dependentes, Anexo RELAÇÃO ATENDIMENTO (sem acento, maiúsculas e preposições; Tit./Dep.; similaridade de 80%)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="24" y="200" width="330" height="114" as="geometry"/></mxCell><mxCell id="c300" value="Nenhuma planilha?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="74" y="342" width="230" height="90" as="geometry"/></mxCell><mxCell id="c299" value="prox_acao = ADC PDF ANT AUT: nenhuma planilha no processo (verificar), sem marcador" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="424" y="354" width="270" height="66" as="geometry"/></mxCell><mxCell id="c303" value="Todos os PDFs já&lt;br&gt;estão na árvore?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="74" y="460" width="230" height="90" as="geometry"/></mxCell><mxCell id="c302" value="▶ deixar_aguardando_fluxo_normal() — coluna 3" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="424" y="480" width="270" height="50" as="geometry"/></mxCell><mxCell id="c306" value="Sem Incluir Documento&lt;br&gt;(fechado no setor)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="74" y="578" width="230" height="120" as="geometry"/></mxCell><mxCell id="c305" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;reabrir_processo_fechado()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;reabrir_processo da sei_automacao (coluna processo_reaberto); o processo continua aberto. Não reabriu: ProcessoFechadoNoSetor" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="424" y="589" width="270" height="98" as="geometry"/></mxCell><mxCell id="c308" value="&lt;b&gt;Para cada planilha sem PDF na árvore&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="24" y="726" width="330" height="40" as="geometry"/></mxCell><mxCell id="c309" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;baixar planilha&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Abre o documento (inicia o download) para dados/geacs_adc_pdf_ant_aut/planilhas_baixadas/. Mais de 60 s (TIMEOUT_DOWNLOAD): erro; o temporário é descartado" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="24" y="794" width="330" height="98" as="geometry"/></mxCell><mxCell id="c310" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;ler_planilha()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Uma aba só (contando as ocultas); Anexo com até 20 beneficiários; linha TOTAL removida; DAT_ATENDIMENTO válida. Senão: ErroAvaliacao, sem PDF" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="24" y="920" width="330" height="98" as="geometry"/></mxCell><mxCell id="c311" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;transformar_xls_em_pdf()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;PDF no layout dos relatórios do MANTIS, com a linha TOTAL. Anexo: modelo próprio, vários beneficiários" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="24" y="1046" width="330" height="82" as="geometry"/></mxCell><mxCell id="c312" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_recarregar_processo() · _anexar_pdf_com_novas_tentativas()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Documento externo PDF &quot;Utilização Tit.|Dep. - &amp;lt;matrícula&amp;gt; - SEI &amp;lt;nº da planilha&amp;gt;&quot; (Anexo: &quot;Utilização Ben. - ...&quot;), Nato-digital, Restrito. Até 3 tentativas; relê a árvore antes de repetir" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="24" y="1156" width="330" height="130" as="geometry"/></mxCell><mxCell id="c313" value="▶ deixar_aguardando_fluxo_normal() — coluna 3" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c314"><mxGeometry x="24" y="1314" width="330" height="50" as="geometry"/></mxCell><mxCell id="c321" value="&lt;b style=&quot;font-size:16px&quot;&gt;3 · deixar_aguardando_fluxo_normal()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Depois dos PDFs: o processo fica aguardando o fluxo inicial (run_geacs_inicial)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="1596" y="270" width="718" height="452" as="geometry"/></mxCell><mxCell id="c316" value="Já tem estado (exceto 01.00)&lt;br&gt;ou é VELHO pelo marcador (00)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c321"><mxGeometry x="74" y="74" width="230" height="120" as="geometry"/></mxCell><mxCell id="c315" value="Continua onde estava, sem marcador novo&lt;br&gt;prox_acao = ADC PDF ANT AUT: PDFs inseridos; processo mantido no estado atual" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c321"><mxGeometry x="424" y="85" width="270" height="98" as="geometry"/></mxCell><mxCell id="c318" value="➕ 01 - Tratado pelo Script&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se faltar&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c321"><mxGeometry x="24" y="222" width="330" height="50" as="geometry"/></mxCell><mxCell id="c319" value="➕ 01.00 - Aguarda Script: Fluxo Normal&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se faltar&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c321"><mxGeometry x="24" y="300" width="330" height="50" as="geometry"/></mxCell><mxCell id="c320" value="prox_acao = ADC PDF ANT AUT: PDFs inseridos; aguarda o fluxo normal" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c321"><mxGeometry x="24" y="378" width="330" height="50" as="geometry"/></mxCell><mxCell id="c912" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c279" target="c280"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c913" value="" sty