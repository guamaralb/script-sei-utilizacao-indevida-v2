        <mxCell id="n-av-f1" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = a ação correspondente ao marcador 1.3" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="n-c-aval"><mxGeometry x="490" y="996" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="n-q5" value="Tem 1.3 - Memos DISA e DEPROC no Bloco?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(enviado sem avaliação)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="n-c-main"><mxGeometry x="470" y="1944" width="440" height="138" as="geometry" /></mxCell>
        <mxCell id="n-c-corr" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_corrigir_novo_sem_avaliacao&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;main.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="n-c-main"><mxGeometry x="1100" y="1944" width="440" height="450" as="geometry" /></mxCell>
        <mxCell id="n-c-obter" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;obter_dados_ui&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;processar_novo.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="n-c-corr"><mxGeometry x="20" y="58" width="400" height="184" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Detalhado na aba 3&lt;/b&gt; →&lt;br&gt;Lê o memo da APIS destinado à GEACS (titular e dependentes).&lt;br&gt;Aqui, sem memo, mais de um ou formato inválido = &lt;b&gt;erro&lt;/b&gt; (nenhum memo à APIS é criado)" link="data:page/id,normal" id="n-c-obter-lk"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="n-c-obter"><mxGeometry x="20" y="58" width="360" height="106" as="geometry" /></mxCell></UserObject>
        <mxCell id="n-c-corrigir" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;corrigir_uso_rede_propria&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;correcao_rede_propria.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="n-c-corr"><mxGeometry x="20" y="278" width="400" height="152" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Detalhado na aba 4&lt;/b&gt; →&lt;br&gt;Rotina de correção com as matrículas do memo da APIS" link="data:page/id,correcao" id="n-c-corrigir-lk"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="n-c-corrigir"><mxGeometry x="20" y="58" width="360" height="74" as="geometry" /></mxCell></UserObject>
        <mxCell id="n-q6" value="Tem 1.3 - Memo DEPROC no Bloco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="n-c-main"><mxGeometry x="470" y="2118" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="n-err6" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): memo DEPROC no bloco sem avaliação da rede própria (combinação inválida)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="n-c-main"><mxGeometry x="20" y="2131" width="260" height="74" as="geometry" /></mxCell>
        <mxCell id="n-q7" value="Tem 1.4 - Memo Não Usou Rede no Bloco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="n-c-main"><mxGeometry x="470" y="2254" width="440" height="102" as="geometry" /></mxCell>
        <mxCell id="n-err7" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): 1.4 sem 1.3 Memos DISA e DEPROC (combinação inválida)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="n-c-main"><mxGeometry x="20" y="2276" width="260" height="58" as="geometry" /></mxCell>
        <mxCell id="n-c-ret" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_processar_novo_ou_retomar&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;main.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="n-c-main"><mxGeometry x="320" y="2392" width="740" height="556" as="geometry" /></mxCell>
        <mxCell id="n-r-esp" value="Esperado = quantidade de marcadores de memo do processo (TAGS_MEMO_NOVO: 1.5 a 1.10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="n-c-ret"><mxGeometry x="320" y="58" width="400" height="58" as="geometry" /></mxCell>
        <mxCell id="n-r-q" value="Qtd. de memos da GEACS = esperado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="n-c-ret"><mxGeometry x="320" y="152" width="400" height="102" as="geometry" /></mxCell>
        <mxCell id="n-r-err" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): memo da GEACS sem marcador; verificar manualmente (evita duplicidade). Registro: qnt_memos_geacs_esperada&lt;br&gt;&lt;b&gt;TODO&lt;/b&gt;: procurar os memos pelo assunto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="n-c-ret"><mxGeometry x="20" y="152" width="260" height="120" as="geometry" /></mxCell>
        <mxCell id="n-r-log" value="Log: fluxo normal do início ou &lt;b&gt;retomada&lt;/b&gt; (tem 1.6, 1.8 ou 1.9: TAGS_RETOMADA_NOVO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="n-c-ret"><mxGeometry x="320" y="290" width="400" height="58" as="geometry" /></mxCell>
        <mxCell id="n-c-pn" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;processar_novo&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;processar_novo.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="n-c-ret"><mxGeometry x="320" y="384" width="400" height="152" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Detalhado na aba 3&lt;/b&gt; →&lt;br&gt;Fluxo normal; as etapas cujo marcador já existe são puladas" link="data:page/id,normal" id="n-c-pn-lk"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="n-c-pn"><mxGeometry x="20" y="58" width="360" height="74" as="geometry" /></mxCell></UserObject>
        <mxCell id="n-nota0" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• Moldura = &lt;b&gt;função&lt;/b&gt; (nome e módulo no topo); caixas dentro = passos na ordem em que o código executa. Funções chamadas aparecem como molduras aninhadas.&lt;br&gt;• Azul: ação · Amarelo: pergunta · Roxo: memo criado e inserido no bloco · Verde: ➕ marcador · Vermelho: erro · Cinza: início/fim · Laranja: detalhado em outra aba (clique).&lt;br&gt;• Erros à esquerda; desvios que param o processo ou seguem outro caminho, à direita. Tracejado: previsto (não implementado).&lt;br&gt;• Legenda completa e tabela de marcadores: aba 8." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="0" width="560" height="170" as="geometry" /></mxCell>
        <mxCell id="n-nota1" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Prefixo &quot;Script v2 - &quot; em todos (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres. Aqui os marcadores aparecem sem o prefixo." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="194" width="560" height="80" as="geometry" /></mxCell>
        <mxCell id="n-nota2" value="&lt;b&gt;Nenhum marcador é adicionado nesta aba.&lt;/b&gt;&lt;br&gt;Ela só decide para onde o processo vai. Ordem das perguntas = ordem do código: vale a primeira verdadeira." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="298" width="560" height="70" as="geometry" /></mxCell>
        <mxCell id="n-nota3" value="&lt;b&gt;Reprocessar um processo parado&lt;/b&gt; (pergunta 2)&lt;br&gt;Corrigir a base (geral ou da rede própria) e remover manualmente 1.2.1 / 1.2.2 no SEI. No fluxo atual, 1.2.1 e 1.2.2 vêm sempre com 1.6 e não param o processo aqui." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="392" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="n-nota4" value="&lt;b&gt;1.3 Memos DISA e DEPROC sem 1.2&lt;/b&gt;&lt;br&gt;Processo encaminhado à DISA e à DEPROC sem avaliação do uso da rede própria (versão anterior). A rotina de correção (aba 4) adiciona 1.4 e/ou 1.2, ou 1.2.1 / 1.2.2." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="506" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="n-nota5" value="&lt;b&gt;Erros&lt;/b&gt;&lt;br&gt;Todo erro sobe até _processar_linha: registrar_erro preenche tipo_erro, erro e, se preciso, prox_acao = Verificar erro. ErroAvaliacao, FormatoMemorandoInvalido e TextoMemoPendente são logados sem traceback; falha inesperada, com logger.exception. &lt;b&gt;Um erro nunca interrompe os demais processos.&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="620" width="560" height="110" as="geometry" /></mxCell>
