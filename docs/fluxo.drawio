=1;fontSize=12;" vertex="1" parent="c114"><mxGeometry x="424" y="399" width="270" height="50" as="geometry"/></mxCell><mxCell id="c58" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c114"><mxGeometry x="424" y="477" width="270" height="40" as="geometry"/></mxCell><mxCell id="c59" value="prox_acao = Assinar memo à APIS (sem memorando)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c114"><mxGeometry x="424" y="545" width="270" height="50" as="geometry"/></mxCell><mxCell id="c71" value="Formato inválido?&lt;br&gt;(não é novo_novo)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c114"><mxGeometry x="74" y="596" width="230" height="120" as="geometry"/></mxCell><mxCell id="c66" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_formato_invalido()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c114"><mxGeometry x="424" y="631" width="270" height="50" as="geometry"/></mxCell><mxCell id="c67" value="📄 &lt;b&gt;MemoApisFormatoInvalido&lt;/b&gt;&lt;br&gt;no bloco 7730341" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c114"><mxGeometry x="424" y="709" width="270" height="50" as="geometry"/></mxCell><mxCell id="c68" value="➕ 1.5 - Memo APIS Formato Inválido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" ver