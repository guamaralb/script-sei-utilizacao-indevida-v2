        <mxCell id="v-p-busca" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;obter_memos_apis_apos_email&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Localiza o e-mail de referência da APIS e lista &lt;b&gt;todos&lt;/b&gt; os memos da APIS posteriores a ele" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="v-c-proc"><mxGeometry x="320" y="58" width="440" height="74" as="geometry" /></mxCell>
