<mxfile host="Electron" type="device"><diagram id="geral" name="1. Visão geral (main.py)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="geral-tit" value="1. Script principal (main.py): leitura e classificação" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-20" width="900" height="40" as="geometry"/></mxCell><mxCell id="geral-ini" value="Início do main.py" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="33" width="260" height="54" as="geometry"/></mxCell><mxCell id="geral-a1" value="Lê dados/inputs/processos_nao_processados.xlsx&lt;br&gt;(aba processos_reais, coluna num_sei)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="300" height="60" as="geometry"/></mxCell><mxCell id="geral-a2" value="Carrega as bases:&lt;br&gt;rede própria (DISA) e base geral" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="210" width="260" height="60" as="geometry"/></mxCell><mxCell id="geral-a3" value="Login no SEI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="290" width="260" height="60" as="geometry"/></mxCell><mxCell id="geral-qloop" value="Há próximo&lt;br&gt;processo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="375" width="220" height="110" as="geometry"/></mxCell><mxCell id="geral-fimA" value="Salva a planilha de controle&lt;br&gt;(dados/controle/processos_processados_&amp;lt;data&amp;gt;.xlsx)&lt;br&gt;e o resumo no log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="395" width="320" height="70" as="geometry"/></mxCell><mxCell id="geral-fim" value="Fim" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="403" width="120" height="54" as="geometry"/></mxCell><mxCell id="geral-a4" value="Abre o processo, lista a árvore,&lt;br&gt;conta docs e memos da GEACS&lt;br&gt;e lê os marcadores &lt;b&gt;do SEI&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="525" width="280" height="70" as="geometry"/></mxCell><mxCell id="geral-q1" value="Tem &lt;b&gt;1&lt;/b&gt; (NOVO)&lt;br&gt;e &lt;b&gt;2&lt;/b&gt; (VELHO)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="635" width="220" height="110" as="geometry"/></mxCell><mxCell id="geral-e1" value="Erro: processo marcado&lt;br&gt;como NOVO e VELHO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="655" width="280" height="70" as="geometry"/></mxCell><mxCell id="geral-q2" value="Tem &lt;b&gt;2&lt;/b&gt;&lt;br&gt;(VELHO)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="775" width="220" height="110" as="geometry"/></mxCell><UserObject label="VELHO&lt;br&gt;(_tratar_velho) →" link="data:page/id,velho" id="geral-s2"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="800" width="280" height="60" as="geometry"/></mxCell></UserObject><mxCell id="geral-q3" value="Tem &lt;b&gt;1&lt;/b&gt;&lt;br&gt;(NOVO)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="915" width="220" height="110" as="geometry"/></mxCell><UserObject label="NOVO já classificado&lt;br&gt;(_tratar_novo) →" link="data:page/id,novo" id="geral-s3"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="940" width="280" height="60" as="geometry"/></mxCell></UserObject><mxCell id="geral-q4" value='Tem outro marcador&lt;br&gt;"Script v2"?' style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1055" width="220" height="110" as="geometry"/></mxCell><mxCell id="geral-e4" value="Erro: marcadores do script&lt;br&gt;sem NOVO/VELHO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="1075" width="280" height="70" as="geometry"/></mxCell><mxCell id="geral-q5" value="Há documento&lt;br&gt;da GEACS&lt;br&gt;na árvore?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="1195" width="220" height="110" as="geometry"/></mxCell><mxCell id="geral-t2" value="➕ 2 - Processo VELHO" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="1223" width="280" height="54" as="geometry"/></mxCell><mxCell id="geral-f2" value="&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Processar VELHO&lt;br&gt;&lt;i&gt;(fluxo VELHO na próxima execução)&lt;/i&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="1215" width="260" height="70" as="geometry"/></mxCell><mxCell id="geral-t1" value="➕ 1 - Processo NOVO" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1353" width="280" height="54" as="geometry"/></mxCell><UserObject label="NOVO – fluxo normal&lt;br&gt;(processar_novo) →" link="data:page/id,normal" id="geral-s1"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="1450" width="280" height="60" as="geometry"/></mxCell></UserObject><mxCell id="geral-prox" value="Registro vira uma linha&lt;br&gt;da planilha de controle;&lt;br&gt;segue para o próximo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="200" height="80" as="geometry"/></mxCell><mxCell id="geral-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="geral-ini" target="geral-a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="geral-a1" target="geral-a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="geral-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;font