        <mxCell id="v-e9" edge="1" parent="1" source="v-q4" target="v-q5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5000;entryY=0;entryDx=0;entryDy=0;" value="Não"><mxGeometry relative="1" as="geometry" /></mxCell>
