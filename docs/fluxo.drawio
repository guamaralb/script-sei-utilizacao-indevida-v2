<mxfile host="app.diagrams.net" type="device"><diagram id="fluxo-completo" name="Fluxo completo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4584" pageHeight="3634" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c276" value="Fluxo do script SEI - Utilização Indevida (v2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="44" as="geometry"/></mxCell><mxCell id="c277" value="Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1200" height="28" as="geometry"/></mxCell><mxCell id="c265" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c266" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c267" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c268" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c269" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c270" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c271" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c272" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c273" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c274" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c275" value="&lt;b&gt;Pendências (TODO)&lt;/b&gt;&lt;br&gt;• no SEI: editar os marcadores renomeados (1 - Tratado pelo Script, 1.5 - Aguarda APIS: Sem Memo p/ GEACS, 1.5 - Aguarda APIS: Formato Inválido, 1.6.1 - Aguarda APIS: Matrículas, 1.7 - Aguarda APIS: Período Deps, 1.10 - Concluído: Memo DEPROC, 1.2.1 - Mat. N Encontradas Base APIS) e cadastrar 0 - Processo VELHO, 1.0 - Aguarda Script: Fluxo Normal, os seis 1.6.2 / 1.8.2 / 1.8.3, os três 1.9 - Aguarda DISA e 1.10 - Aguarda APIS: Sem Uso&lt;br&gt;• blocos dos três memos à DISA e do memo à APIS sem uso (constantes = None)&lt;br&gt;• revisar os textos e assuntos dos memos com TEXTO_DEFINIDO = False&lt;br&gt;• fluxo do processo VELHO&lt;br&gt;• tratar a resposta dos processos parados (APIS e DISA)" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2170" y="100" width="460" height="242" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Carrega as bases, faz login e passa cada processo pelo fluxo. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1526" as="geometry"/></mxCell><mxCell id="c10" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="90" width="330" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria as pastas e o log da execução" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="158" width="330" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;carregar_bases() · carregar_bases_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê processos_nao_processados.xlsx, a base DISA, a base APIS e o MANTIS (rede própria e credenciada)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="236" width="330" height="82" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle e faz login no SEI" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="346" width="330" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="424" width="330" height="40" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_processar_linha()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Abre o processo e lê os marcadores do SEI&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;acessar_processo, registrar_tags&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="492" width="330" height="66" as="geometry"/></mxCell><mxCell id="c18" value="Sem o botão&lt;br&gt;Incluir Documento?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="74" y="586" width="230" height="104" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;reabrir_processo_fechado()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Reabre o processo na unidade (continua aberto) e segue o fluxo. Coluna processo_reaberto&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;reabrir_processo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="424" y="589" width="270" height="98" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Não reabriu&lt;/b&gt; (ou ainda sem o botão): &lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;, nada mais é feito no SEI&lt;br&gt;prox_acao = Verificar erro" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="424" y="715" width="270" height="82" as="geometry"/></mxCell><mxCell id="c21" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;registrar_arvore()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a árvore do processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="822" width="330" height="50" as="geometry"/></mxCell><mxCell id="c22" value="▶ _tratar() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="900" width="330" height="40" as="geometry"/></mxCell><mxCell id="c23" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;De novo, no fim da passagem (se não houve erro)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="968" width="330" height="66" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Erro levantado em qualquer coluna?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;: tipo_erro, erro e prox_acao = Verificar erro (ou a já definida). Inesperado: + traceback" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="1062" width="330" height="82" as="geometry"/></mxCell><mxCell id="c25" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Regrava a planilha de controle (abas processos e historico) depois de cada processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="1172" width="330" height="66" as="geometry"/></mxCell><mxCell id="c27" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="74" y="1266" width="230" height="90" as="geometry"/></mxCell><mxCell id="c26" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="424" y="1291" width="270" height="40" as="geometry"/></mxCell><mxCell id="c29" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="1384" width="330" height="50" as="geometry"/></mxCell><mxCell id="c30" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="24" y="1462" width="330" height="40" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · _tratar()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Separa o processo VELHO e roteia pelos marcadores lidos do SEI. Só adiciona o marcador 1 (e o 0, em _separar_velho); o resto é decidido em processar_novo()&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="2304" as="geometry"/></mxCell><mxCell id="c32" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A combinação de marcadores é possível no fluxo?&lt;br&gt;• no máximo um marcador de estado (★)&lt;br&gt;• no máximo um de cada par: 1.6.2 - Base DISA: Usou RP / 1.6.2 - Base DISA: Não Usou RP, 1.8.2 - MANTIS: Usou RP / 1.8.2 - MANTIS: Não Usou RP e 1.8.3 - MANTIS: Usou RC / 1.8.3 - MANTIS: Não Usou RC&lt;br&gt;• informativo só com estado compatível&lt;br&gt;• 1.6.1 - Aguarda APIS: Matrículas exige 1.2.1 - Mat. N Encontradas Base APIS&lt;br&gt;• 1.7 - Aguarda APIS: Período Deps exige 1.1 - Período Variável p/ Dependentes&lt;br&gt;• cada 1.9 - Aguarda DISA exige o seu par: Validar (Consta) = DISA e MANTIS Usou RP; Validar (N Consta) = DISA Não Usou e MANTIS Usou RP; Relat. s/ MANTIS = DISA Usou e MANTIS Não Usou RP&lt;br&gt;• 1.10 - Aguarda APIS: Sem Uso exige 1.6.2 - Base DISA: Não Usou RP, 1.8.2 - MANTIS: Não Usou RP e 1.8.3 - MANTIS: Não Usou RC&lt;br&gt;• VELHO (0 - Processo VELHO ou 1.3 - Memos DISA e DEPROC no Bloco) sem memos à DISA ou à DEPROC do fluxo atual (1.9, 1.10)…" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="24" y="90" width="330" height="418" as="geometry"/></mxCell><mxCell id="c34" value="Marcadores&lt;br&gt;inconsistentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="74" y="536" width="230" height="90" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;MarcadoresInconsistentes&lt;/b&gt;: nada é feito no SEI&lt;br&gt;prox_acao = Verificar marcadores (corrigir no SEI)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="540" width="270" height="82" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;VELHO&lt;/b&gt; pelos marcadores?&lt;br&gt;0 - Processo VELHO ou&lt;br&gt;1.3 - Memos DISA e DEPROC no Bloco" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="24" y="654" width="330" height="120" as="geometry"/></mxCell><mxCell id="c36" value="▶ _separar_velho()&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;à direita&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="689" width="270" height="50" as="geometry"/></mxCell><mxCell id="c39" value="&lt;font face=&quot;Courier New&quot;&gt;estado_atual()&lt;/font&gt;: marcador de estado do processo" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="24" y="802" width="330" height="50" as="geometry"/></mxCell><mxCell id="c41" value="Estado de parada?&lt;br&gt;1.5 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;1.5 - Aguarda APIS: Formato Inválido&lt;br&gt;1.6.1 - Aguarda APIS: Matrículas&lt;br&gt;1.7 - Aguarda APIS: Período Deps&lt;br&gt;1.9 - Aguarda DISA: Validar (Consta)&lt;br&gt;1.9 - Aguarda DISA: Validar (N Consta)&lt;br&gt;1.9 - Aguarda DISA: Relat. s/ MANTIS&lt;br&gt;1.10 - Aguarda APIS: Sem Uso&lt;br&gt;versão anterior: 1.8.1 - Memo DISA Validar Usos MANTIS, 1.9 - Memo DISA Uso Rede Própria" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="24" y="880" width="330" height="392" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Erro&lt;/b&gt;: parado aguardando resposta ao memo&lt;br&gt;prox_acao = Aguardar resposta ao memo enviado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="1035" width="270" height="82" as="geometry"/></mxCell><mxCell id="c44" value="Estado de conclusão?&lt;br&gt;1.10 - Concluído: Memo DEPROC&lt;br&gt;versão anterior: 1.10 - Concluído: Memos DISA e DEPROC" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="24" y="1300" width="330" height="152" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Concluído&lt;/b&gt;, prox_acao:&lt;br&gt;1.10 - Concluído: Memo DEPROC → assinar DEPROC&lt;br&gt;1.10 - Concluído: Memos DISA e DEPROC → assinar os dois" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="1327" width="270" height="98" as="geometry"/></mxCell><mxCell id="c47" value="NOVO sem estado com&lt;br&gt;1.3 - Memo DEPROC no Bloco?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="74" y="1480" width="230" height="120" as="geometry"/></mxCell><mxCell id="c46" value="Concluído na versão anterior&lt;br&gt;prox_acao = Assinar memo DEPROC" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="1515" width="270" height="50" as="geometry"/></mxCell><mxCell id="c49" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_memos_velho()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê &lt;b&gt;todos os memorandos da GEACS&lt;/b&gt; e procura dois seguidos: &quot;Para: IPSEMG/DISA-UTI-INDEV&quot; e depois &quot;Para: IPSEMG/DEPROC&quot;, os dois datados (&quot;Belo Horizonte, 18 de setembro de 2026.&quot;) antes de 01/10/2026" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="24" y="1628" width="330" height="114" as="geometry"/></mxCell><mxCell id="c51" value="Par sem data&lt;br&gt;legível?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="74" y="1770" width="230" height="90" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: não dá para saber se é VELHO; nada é feito no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="1790" width="270" height="50" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;VELHO&lt;/b&gt; pelos memos&lt;br&gt;da GEACS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="74" y="1888" width="230" height="104" as="geometry"/></mxCell><mxCell id="c53" value="▶ _separar_velho()&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;à direita&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="1915" width="270" height="50" as="geometry"/></mxCell><mxCell id="c58" value="Sem o marcador&lt;br&gt;&lt;b&gt;1 - Tratado pelo Script&lt;/b&gt;?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="74" y="2020" width="230" height="104" as="geometry"/></mxCell><mxCell id="c56" value="➕ 1 - Tratado pelo Script" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="2052" width="270" height="40" as="geometry"/></mxCell><mxCell id="c57" value="▶ processar_novo() do início — coluna 3" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="424" y="2120" width="270" height="50" as="geometry"/></mxCell><mxCell id="c61" value="▶ processar_novo() — coluna 3&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;do início (sem estado ou com 1.0 - Aguarda Script: Fluxo Normal, que o fluxo ALT 1 deixa) ou retomando de 1.6 - Avaliado Uso Rede Própria DISA ou 1.8 - Avaliado Uso Rede Própria MANTIS&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c62"><mxGeometry x="24" y="2166" width="330" height="114" as="geometry"/></mxCell><mxCell id="c130" value="&lt;b style=&quot;font-size:16px&quot;&gt;3 · processar_novo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Memo da APIS, base APIS e base DISA, e as paradas com memo à APIS. Na retomada, as etapas já feitas são puladas (_etapa_feita)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="1596" y="270" width="718" height="3078" as="geometry"/></mxCell><mxCell id="c63" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Usa o &lt;b&gt;último&lt;/b&gt; memo da APIS destinado à GEACS; os documentos depois dele são a rodada. Procura &lt;b&gt;primeiro o modelo com período por dependente&lt;/b&gt; (linha &lt;i&gt;Período de apuração do dependente:&lt;/i&gt;; duplas matrícula + período) e, se não for ele, analisa como novo_novo&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;obter_memos_apis_para_geacs, validar_template, extrair_dados_ui&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="24" y="90" width="330" height="162" as="geometry"/></mxCell><mxCell id="c69" value="Nenhum memo da APIS&lt;br&gt;para a GEACS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="74" y="280" width="230" height="104" as="geometry"/></mxCell><mxCell id="c64" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_sem_memo_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="307" width="270" height="50" as="geometry"/></mxCell><mxCell id="c65" value="📄 &lt;b&gt;MemoApisSemMemo&lt;/b&gt;&lt;br&gt;no bloco 7730344" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="385" width="270" height="50" as="geometry"/></mxCell><mxCell id="c66" value="➕ 1.5 - Aguarda APIS: Sem Memo p/ GEACS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="463" width="270" height="50" as="geometry"/></mxCell><mxCell id="c67" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="541" width="270" height="40" as="geometry"/></mxCell><mxCell id="c68" value="prox_acao = Assinar memo à APIS (sem memorando)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="609" width="270" height="50" as="geometry"/></mxCell><mxCell id="c80" value="Formato inválido?&lt;br&gt;(período por dependente incompleto&lt;br&gt;ou não é novo_novo)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="74" y="660" width="230" height="168" as="geometry"/></mxCell><mxCell id="c75" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_formato_invalido()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="719" width="270" height="50" as="geometry"/></mxCell><mxCell id="c76" value="📄 &lt;b&gt;MemoApisFormatoInvalido&lt;/b&gt;&lt;br&gt;no bloco 7730341" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="797" width="270" height="50" as="geometry"/></mxCell><mxCell id="c77" value="➕ 1.5 - Aguarda APIS: Formato Inválido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="875" width="270" height="50" as="geometry"/></mxCell><mxCell id="c78" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="953" width="270" height="40" as="geometry"/></mxCell><mxCell id="c79" value="prox_acao = Assinar memo à APIS (formato inválido)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1021" width="270" height="50" as="geometry"/></mxCell><mxCell id="c86" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;verificar_base_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A existência das matrículas é conferida &lt;b&gt;só na base APIS&lt;/b&gt; (a base DISA é feita a partir dela). Do memo, vêm com ou sem DV; a base APIS diz qual é a matrícula" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="24" y="1040" width="330" height="98" as="geometry"/></mxCell><mxCell id="c88" value="Matrícula em&lt;br&gt;formato inválido?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="74" y="1166" width="230" height="104" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1198" width="270" height="40" as="geometry"/></mxCell><mxCell id="c96" value="Faltou matrícula&lt;br&gt;na base APIS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="74" y="1298" width="230" height="90" as="geometry"/></mxCell><mxCell id="c90" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_nao_encontradas_base_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;garantir_marcadores_no_sei, incluir_memo_apis_mat_nao_encontradas&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1302" width="270" height="82" as="geometry"/></mxCell><mxCell id="c91" value="➕ 1.2.1 - Mat. N Encontradas Base APIS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1412" width="270" height="50" as="geometry"/></mxCell><mxCell id="c92" value="📄 &lt;b&gt;MemoApisMatNaoEncontradas&lt;/b&gt;&lt;br&gt;no bloco 7711907" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1490" width="270" height="50" as="geometry"/></mxCell><mxCell id="c93" value="➕ 1.6.1 - Aguarda APIS: Matrículas" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1568" width="270" height="50" as="geometry"/></mxCell><mxCell id="c94" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1646" width="270" height="40" as="geometry"/></mxCell><mxCell id="c95" value="prox_acao = Assinar memo à APIS (matrículas não encontradas)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1714" width="270" height="50" as="geometry"/></mxCell><mxCell id="c104" value="Tem 1.2.1 - Mat. N Encontradas Base APIS?&lt;br&gt;(base corrigida)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="24" y="1788" width="330" height="104" as="geometry"/></mxCell><mxCell id="c103" value="➖ 1.2.1 - Mat. N Encontradas Base APIS&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;remove e segue o fluxo (abaixo)&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="1807" width="270" height="66" as="geometry"/></mxCell><mxCell id="c106" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_avaliar_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Uso da rede própria na base DISA. Fora da base DISA = não usou&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;avaliar_uso_rede_propria_disa, registrar_uso, garantir_marcadores_no_sei&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="24" y="1920" width="330" height="98" as="geometry"/></mxCell><mxCell id="c108" value="Resposta inválida&lt;br&gt;na base DISA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="74" y="2046" width="230" height="104" as="geometry"/></mxCell><mxCell id="c107" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="424" y="2078" width="270" height="40" as="geometry"/></mxCell><mxCell id="c113" value="Alguém usou a rede própria&lt;br&gt;segundo a &lt;b&gt;base DISA&lt;/b&gt;?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c130"><mxGeometry x="209" y="2178" width="300" height="104" as="geometry"/></mxCell><mxCell id="c110" value="➕ 1.6.2 - Base DISA: Usou RP" style="shape=hexagon;perimeter=hexagon