        <mxCell id="n3-s4-fim" parent="n3-c-periodo" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" value="&lt;b&gt;Fim&lt;/b&gt;: processo parado" vertex="1">
