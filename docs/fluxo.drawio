<mxfile host="app.diagrams.net" type="device"><diagram id="fluxo-completo" name="Fluxo completo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5186" pageHeight="12883" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c229" value="Fluxo completo — script-sei-utilizacao-indevida-v2 (main.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="c166" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;main()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Script principal: carrega as bases, faz login e processa cada processo da planilha de entrada&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#bac8d3;strokeColor=#23445d;swimlaneFillColor=#f7f9fb;startSize=46;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="4088" height="12723" as="geometry"/></mxCell><mxCell id="c151" value="Início" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c166"><mxGeometry x="1709" y="70" width="280" height="40" as="geometry"/></mxCell><mxCell id="c152" value="Cria as pastas e configura o log (configurar_logging)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c166"><mxGeometry x="1689" y="144" width="320" height="50" as="geometry"/></mxCell><mxCell id="c154" value="remover_marcador existe&lt;br&gt;na sei_automacao?&lt;br&gt;(REMOCAO_DE_MARCADOR_DISPONIVEL)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c166"><mxGeometry x="1699" y="228" width="300" height="130" as="geometry"/></mxCell><mxCell id="c153" value="&lt;b&gt;SystemExit&lt;/b&gt;&lt;br&gt;execução não iniciada (TODO na sei_automacao)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="c166"><mxGeometry x="3744" y="323" width="320" height="66" as="geometry"/></mxCell><mxCell id="c155" value="Lê &lt;i&gt;processos_nao_processados.xlsx&lt;/i&gt;&lt;br&gt;(aba processos_reais, coluna num_sei)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c166"><mxGeometry x="1689" y="423" width="320" height="50" as="geometry"/></mxCell><mxCell id="c156" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;carregar_bases()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Base DISA (UTILIZOU A REDE PRÓPRIA?) e base geral (todas as matrículas; DV retirado dos dependentes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c166"><mxGeometry x="1679" y="507" width="340" height="82" as="geometry"/></mxCell><mxCell id="c157" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;carregar_bases_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;MANTIS rede própria e credenciada: atendimentos por matrícula (data, valor, prestador, procedimento)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c166"><mxGeometry x="1679" y="623" width="340" height="82" as="geometry"/></mxCell><mxCell id="c158" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle geral uma vez" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c166"><mxGeometry x="1679" y="739" width="340" height="50" as="geometry"/></mxCell><mxCell id="c159" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Abre o navegador e faz login (credenciais do .env)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c166"><mxGeometry x="1679" y="823" width="340" height="66" as="geometry"/></mxCell><mxCell id="c150" value="&lt;b&gt;Para cada processo&lt;/b&gt;&lt;br&gt;(contexto_processo: número do processo em cada linha do log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c166"><mxGeometry x="1689" y="923" width="320" height="66" as="geometry"/></mxCell><mxCell id="c149" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;_processar_linha()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Uma passagem do processo: lê a árvore e os marcadores e chama o roteamento. Captura todos os erros: um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;startSize=46;verticalAlign=top;" vertex="1" parent="c166"><mxGeometry x="24" y="1023" width="3650" height="11158" as="geometry"/></mxCell><mxCell id="c142" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;acessar_processo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Abre o processo no SEI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c149"><mxGeometry x="1280" y="70" width="340" height="50" as="geometry"/></mxCell><mxCell id="c143" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_documentos_arvore() → registrar_arvore()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Árvore, documentos e memos da GEACS; docs_rodada = toda a árvore até achar o memo da APIS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c149"><mxGeometry x="1280" y="154" width="340" height="66" as="geometry"/></mxCell><mxCell id="c144" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_marcadores() → registrar_tags()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;marcadores_sei (lidos do SEI) e marcadores_atuais" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c149"><mxGeometry x="1280" y="254" width="340" height="66" as="geometry"/></mxCell><mxCell id="c141" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;_tratar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Roteamento pelos marcadores lidos do SEI: parado, concluído ou segue para processar_novo(). Só adiciona o marcador 1&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;startSize=46;verticalAlign=top;" vertex="1" parent="c149"><mxGeometry x="24" y="354" width="2852" height="10510" as="geometry"/></mxCell><mxCell id="c125" value="Não tem&lt;br&gt;&lt;b&gt;1 - Processo NOVO&lt;/b&gt;?&lt;br&gt;(inclusive com documento da GEACS&lt;br&gt;ou com o antigo 2 - Processo VELHO)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1051" y="70" width="340" height="146" as="geometry"/></mxCell><mxCell id="c122" value="&lt;b&gt;adicionar_tag()&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2498" y="173" width="320" height="40" as="geometry"/></mxCell><mxCell id="c123" value="➕ 1 - Processo NOVO" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2488" y="247" width="340" height="44" as="geometry"/></mxCell><mxCell id="c124" value="processar_novo() do início" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2498" y="325" width="320" height="40" as="geometry"/></mxCell><mxCell id="c126" value="registro.velho = tem &lt;b&gt;1.3 - Memos DISA e DEPROC no Bloco&lt;/b&gt; (enviado à DISA e à DEPROC antes da avaliação)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1061" y="399" width="320" height="66" as="geometry"/></mxCell><mxCell id="c127" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;estado_atual()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Marcador de estado do processo (TAGS_ESTADO_NOVO) ou nenhum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c141"><mxGeometry x="1051" y="499" width="340" height="66" as="geometry"/></mxCell><mxCell id="c129" value="Mais de um marcador&lt;br&gt;de estado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1071" y="599" width="300" height="82" as="geometry"/></mxCell><mxCell id="c128" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;&lt;br&gt;remover manualmente o(s) anterior(es) no SEI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2488" y="670" width="320" height="50" as="geometry"/></mxCell><mxCell id="c131" value="Estado de parada?&lt;br&gt;1.5 (dois), 1.6.1, 1.7, 1.8.1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1071" y="754" width="300" height="98" as="geometry"/></mxCell><mxCell id="c130" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: parado aguardando resposta&lt;br&gt;prox_acao = Aguardar resposta ao memo enviado&lt;br&gt;(TODO: tratar a resposta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2488" y="833" width="320" height="82" as="geometry"/></mxCell><mxCell id="c133" value="Estado de conclusão?&lt;br&gt;1.10 (dois), 1.11 (dois)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1071" y="949" width="300" height="98" as="geometry"/></mxCell><mxCell id="c132" value="Concluído. prox_acao:&lt;br&gt;1.10 DISA e DEPROC → Assinar memos DISA e DEPROC&lt;br&gt;1.10 DEPROC → Assinar memo DEPROC&lt;br&gt;1.11 VELHO DISA → VELHO: assinar memo DISA&lt;br&gt;1.11 VELHO DEPROC → VELHO: assinar memo DEPROC" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2488" y="1028" width="340" height="114" as="geometry"/></mxCell><mxCell id="c135" value="VELHO com MANUAL&lt;br&gt;ou ASSINADO?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1071" y="1176" width="300" height="82" as="geometry"/></mxCell><mxCell id="c134" value="prox_acao = Fora do escopo (tratado manualmente)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2488" y="1247" width="280" height="50" as="geometry"/></mxCell><mxCell id="c137" value="NOVO sem estado com&lt;br&gt;1.3 - Memo DEPROC no Bloco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1071" y="1331" width="300" height="98" as="geometry"/></mxCell><mxCell id="c136" value="Concluído na versão anterior&lt;br&gt;prox_acao = Assinar memo DEPROC e encaminhar" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2488" y="1410" width="280" height="66" as="geometry"/></mxCell><mxCell id="c139" value="NOVO sem estado com&lt;br&gt;1.2.1 ou 1.2.2?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1071" y="1510" width="300" height="82" as="geometry"/></mxCell><mxCell id="c138" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: parado pela versão anterior&lt;br&gt;prox_acao = Verificar matrículas não encontradas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="2488" y="1581" width="320" height="66" as="geometry"/></mxCell><mxCell id="c140" value="Do início (sem estado) ou retomada (estado 1.6, 1.8 ou 1.9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c141"><mxGeometry x="1061" y="1681" width="320" height="50" as="geometry"/></mxCell><mxCell id="c121" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;processar_novo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Fluxo de todos os processos (normal e VELHO = registro.velho). Do início ou retomando pelo estado 1.6, 1.8 ou 1.9 (_etapa_feita pula as etapas já feitas)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;startSize=46;verticalAlign=top;" vertex="1" parent="c141"><mxGeometry x="24" y="1765" width="2394" height="8721" as="geometry"/></mxCell><mxCell id="c85" value="Erros levantados aqui (vermelho) sobem para &lt;b&gt;_processar_linha()&lt;/b&gt;, que chama &lt;b&gt;registrar_erro()&lt;/b&gt; e segue para o próximo processo" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=12;" vertex="1" parent="c121"><mxGeometry x="822" y="70" width="340" height="66" as="geometry"/></mxCell><mxCell id="c84" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Lê o último memo da APIS destinado à GEACS e extrai as instruções&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;startSize=46;verticalAlign=top;" vertex="1" parent="c121"><mxGeometry x="603" y="170" width="778" height="816" as="geometry"/></mxCell><mxCell id="c76" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;obter_memos_apis_para_geacs()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê todos os memorandos da APIS (ler_texto_doc) e mantém os destinados à GEACS (eh_destinado_geacs). Coluna memos_apis_geacs_sei" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c84"><mxGeometry x="24" y="70" width="340" height="82" as="geometry"/></mxCell><mxCell id="c78" value="Nenhum memo para&lt;br&gt;a GEACS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c84"><mxGeometry x="44" y="186" width="300" height="82" as="geometry"/></mxCell><mxCell id="c77" value="levanta &lt;b&gt;MemoApisNaoEncontrado&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="c84"><mxGeometry x="434" y="257" width="320" height="40" as="geometry"/></mxCell><mxCell id="c79" value="Usa o &lt;b&gt;último&lt;/b&gt;. registro.docs_rodada = documentos depois dele (onde memos e PDFs já criados são procurados)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c84"><mxGeometry x="34" y="331" width="320" height="66" as="geometry"/></mxCell><mxCell id="c80" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;validar_template()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Só o modelo novo_novo: Nome completo, Matrícula, Período do titular &lt;b&gt;e&lt;/b&gt; &quot;atualização do levantamento de utilização&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c84"><mxGeometry x="24" y="431" width="340" height="82" as="geometry"/></mxCell><mxCell id="c82" value="Formato inválido?&lt;br&gt;(novo_velho, velho&lt;br&gt;ou faltam campos)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c84"><mxGeometry x="44" y="547" width="300" height="98" as="geometry"/></mxCell><mxCell id="c81" value="levanta &lt;b&gt;FormatoMemorandoInvalido&lt;/b&gt;&lt;br&gt;prox_acao = Verificar formato do memo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="c84"><mxGeometry x="434" y="626" width="320" height="50" as="geometry"/></mxCell><mxCell id="c83" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;extrair_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;DadosUI: nome, matrícula e período do titular, matrículas dos dependentes e se há período variável para dependentes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c84"><mxGeometry x="24" y="710" width="340" height="82" as="geometry"/></mxCell><mxCell id="c92" value="MemoApisNaoEncontrado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c121"><mxGeometry x="842" y="1020" width="300" height="80" as="geometry"/></mxCe