        <mxCell id="g-q3" value="Tem 1 - Processo NOVO?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="g-c-class"><mxGeometry x="560" y="368" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="g-c-novo" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_tratar_novo&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;main.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="g-c-class"><mxGeometry x="1280" y="368" width="400" height="136" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Detalhado na aba 2&lt;/b&gt; →&lt;br&gt;Roteamento do NOVO" link="data:page/id,novo" id="g-c-novo-lk"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="g-c-novo"><mxGeometry x="20" y="58" width="360" height="58" as="geometry" /></mxCell></UserObject>
        <mxCell id="g-q4" value="Tem outro marcador &quot;Script v2 - &quot;?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(TAGS_SCRIPT; PLANILHADO, MANUAL etc. não contam)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="g-c-class"><mxGeometry x="560" y="504" width="440" height="138" as="geometry" /></mxCell>
        <mxCell id="g-err4" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): marcadores do script sem NOVO/VELHO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="g-c-class"><mxGeometry x="20" y="544" width="260" height="58" as="geometry" /></mxCell>
        <mxCell id="g-c-sem" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_tratar_sem_marcadores&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;main.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="g-c-class"><mxGeometry x="320" y="678" width="920" height="438" as="geometry" /></mxCell>
        <mxCell id="g-q-geacs" value="Há documento da GEACS na árvore?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(docs_geacs)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="g-c-sem"><mxGeometry x="20" y="58" width="440" height="102" as="geometry" /></mxCell>
        <mxCell id="g-t2" value="➕ 2 - Processo VELHO" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="g-c-sem"><mxGeometry x="500" y="58" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="g-f-velho" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = Processar VELHO&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;O fluxo VELHO só roda na próxima execução (aba 6)&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="g-c-sem"><mxGeometry x="500" y="144" width="400" height="58" as="geometry" /></mxCell>
        <mxCell id="g-t1" value="➕ 1 - Processo NOVO" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="g-c-sem"><mxGeometry x="40" y="196" width="400" height="50" as="geometry" /></mxCell>
        <mxCell id="g-c-pn" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;processar_novo&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;processar_novo.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="g-c-sem"><mxGeometry x="40" y="282" width="400" height="136" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Detalhado na aba 3&lt;/b&gt; →&lt;br&gt;Fluxo normal do NOVO, &lt;b&gt;na mesma execução&lt;/b&gt;" link="data:page/id,normal" id="g-c-pn-lk"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="g-c-pn"><mxGeometry x="20" y="58" width="360" height="58" as="geometry" /></mxCell></UserObject>
        <mxCell id="g-err-exc" value="&lt;b&gt;except&lt;/b&gt; (qualquer etapa acima): &lt;b&gt;registrar_erro&lt;/b&gt;(registro, e) preenche tipo_erro e erro (e prox_acao = Verificar erro, se vazia).&lt;br&gt;ErroAvaliacao, FormatoMemorandoInvalido, TextoMemoPendente: sem traceback. Outras: logger.exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="g-c-linha"><mxGeometry x="650" y="1544" width="440" height="90" as="geometry" /></mxCell>
        <mxCell id="g-a-fimproc" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;log_fim_processo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;registro.to_dict() vira uma linha da planilha de controle; segue para o próximo processo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="g-c-main"><mxGeometry x="670" y="2276" width="440" height="74" as="geometry" /></mxCell>
        <mxCell id="g-nota0" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• Moldura = &lt;b&gt;função&lt;/b&gt; (nome e módulo no topo); caixas dentro = passos na ordem em que o código executa. Funções chamadas aparecem como molduras aninhadas.&lt;br&gt;• Azul: ação · Amarelo: pergunta · Roxo: memo criado e inserido no bloco · Verde: ➕ marcador · Vermelho: erro · Cinza: início/fim · Laranja: detalhado em outra aba (clique).&lt;br&gt;• Erros à esquerda; desvios que param o processo ou seguem outro caminho, à direita. Tracejado: previsto (não implementado).&lt;br&gt;• Legenda completa e tabela de marcadores: aba 8." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="0" width="560" height="170" as="geometry" /></mxCell>
        <mxCell id="g-nota1" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Prefixo &quot;Script v2 - &quot; em todos (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres. Aqui os marcadores aparecem sem o prefixo." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="194" width="560" height="80" as="geometry" /></mxCell>
        <mxCell id="g-nota2" value="&lt;b&gt;Classificação&lt;/b&gt;&lt;br&gt;NOVO: nenhum documento da GEACS na árvore. VELHO: já existe documento da GEACS.&lt;br&gt;1 - Processo NOVO segue na mesma execução para o fluxo normal (aba 3); 2 - Processo VELHO só é tratado na execução seguinte (aba 6)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="298" width="560" height="100" as="geometry" /></mxCell>
        <mxCell id="g-nota3" value="&lt;b&gt;Marcadores manuais&lt;/b&gt;&lt;br&gt;PLANILHADO e UTILIZAÇÃO INSERIDA (e MANUAL/ASSINADO) não contam na pergunta &quot;Tem outro marcador Script v2 - ?&quot; e não impedem a classificação." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="422" width="560" height="80" as="geometry" /></mxCell>
        <mxCell id="g-nota4" value="&lt;b&gt;Erros&lt;/b&gt;&lt;br&gt;Todo erro sobe até _processar_linha: registrar_erro preenche tipo_erro, erro e, se preciso, prox_acao = Verificar erro. ErroAvaliacao, FormatoMemorandoInvalido e TextoMemoPendente são logados sem traceback; falha inesperada, com logger.exception. &lt;b&gt;Um erro nunca interrompe os demais processos.&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="526" width="560" height="110" as="geometry" /></mxCell>
        <mxCell id="g-nota5" value="&lt;b&gt;Desfecho de cada processo&lt;/b&gt;&lt;br&gt;Todo caminho termina com uma prox_acao (Registro.ProxAcao) ou com erro. O registro vira uma linha da planilha de controle e o loop volta a &quot;Há próximo processo?&quot; (seta tracejada)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="660" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="g-e1" edge="1" parent="1" source="g-ini" target="g-c-main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3938;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g-e2" edge="1" parent="1" source="g-a-ler" target="g-a-bases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5000;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
