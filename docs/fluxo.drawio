ource="c548" target="c552"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c908" value="Sim (e segue)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c548" target="c547"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c909" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c552" target="c556"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c910" value="Sim (e segue)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c552" target="c550"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c911" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c550" target="c551"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c912" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c556" target="c558"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c913" value="Sim (e segue)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c556" target="c555"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="deproc-calcula-copa" name="deproc_calcula_copa"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1596" pageHeight="2276" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c914" value="run_deproc_calcula_copa · Cálculo da coparticipação na DEPROC (main_deproc_calcula_copa.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c915" value="Na unidade da DEPROC, com os marcadores da DEPROC. Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c916" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c917" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c918" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c919" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c920" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c921" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c922" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c923" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c924" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c925" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c454" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_deproc_calcula_copa -d DD/MM/AAAA (data de geração da base DEPROC, obrigatória). Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1488" as="geometry"/></mxCell><mxCell id="c436" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="90" width="330" height="40" as="geometry"/></mxCell><mxCell id="c434" value="ler_argumentos():&lt;br&gt;sem -d DD/MM/AAAA&lt;br&gt;(ou data inválida/futura)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="74" y="158" width="230" height="152" as="geometry"/></mxCell><mxCell id="c433" value="argparse mostra o erro e encerra (código 2), antes do log, do login e de qualquer ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="424" y="201" width="270" height="66" as="geometry"/></mxCell><mxCell id="c437" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba deproc_calcula_copa de processos_a_processar.xlsx e a base DEPROC (Relatório Base 2 - MANTIS, aba Resultado, matrículas com DV)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="338" width="330" height="114" as="geometry"/></mxCell><mxCell id="c438" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da DEPROC (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="480" width="330" height="82" as="geometry"/></mxCell><mxCell id="c439" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="590" width="330" height="40" as="geometry"/></mxCell><mxCell id="c441" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="74" y="658" width="230" height="120" as="geometry"/></mxCell><mxCell id="c440" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="424" y="685" width="270" height="66" as="geometry"/></mxCell><mxCell id="c443" value="▶ processar_deproc() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="806" width="330" height="40" as="geometry"/></mxCell><mxCell id="c444" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="874" width="330" height="66" as="geometry"/></mxCell><mxCell id="c445" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linha do processo: script, fluxo (DEPROC - COPARTICIPAÇÃO), prox_acao, erro, data_geracao_base_deproc, marcadores_deproc_* e tag_deproc_*. Os marcadores da GEACS e os resultados do fluxo inicial ficam como estão" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="968" width="330" height="114" as="geometry"/></mxCell><mxCell id="c447" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="74" y="1110" width="230" height="90" as="geometry"/></mxCell><mxCell id="c446" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="424" y="1130" width="270" height="50" as="geometry"/></mxCell><mxCell id="c450" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="74" y="1228" width="230" height="90" as="geometry"/></mxCell><mxCell id="c449" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="424" y="1253" width="270" height="40" as="geometry"/></mxCell><mxCell id="c452" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="1346" width="330" height="50" as="geometry"/></mxCell><mxCell id="c453" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c454"><mxGeometry x="24" y="1424" width="330" height="40" as="geometry"/></mxCell><mxCell id="c482" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · processar_deproc()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Na unidade da DEPROC: apura a coparticipação, anexa o relatório e cria o MemoGeacsCalculoCopa (da DEPROC à GEACS). Marcadores da DEPROC (mesmo prefixo &quot;v2: &quot;)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="1966" as="geometry"/></mxCell><mxCell id="c455" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;registrar_tags() · conferir_marcadores_deproc()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;No máximo um estado, e estado só com o 01. De novo no fim da passagem" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="90" width="330" height="82" as="geometry"/></mxCell><mxCell id="c457" value="Marcadores&lt;br&gt;inconsistentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="74" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c456" value="&lt;b&gt;MarcadoresInconsistentes&lt;/b&gt;: prox_acao = Verificar marcadores inconsistentes" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="424" y="212" width="270" height="66" as="geometry"/></mxCell><mxCell id="c460" value="Tem 01.02 - No Bloco GEACS:&lt;br&gt;Memo Cálculo COPA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="74" y="318" width="230" height="120" as="geometry"/></mxCell><mxCell id="c459" value="Sem ler mais nada&lt;br&gt;prox_acao = DEPROC: assinar memo de resultado da coparticipação e encaminhar à GEACS" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="424" y="337" width="270" height="82" as="geometry"/></mxCell><mxCell id="c463" value="Tem 01.02.1 - Encaminhado GEACS:&lt;br&gt;Memo Cálculo COPA (manual)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="74" y="466" width="230" height="120" as="geometry"/></mxCell><mxCell id="c462" value="Concluído, sem ler mais nada&lt;br&gt;prox_acao = DEPROC: memo de resultado da coparticipação encaminhado à GEACS (concluído)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="424" y="485" width="270" height="82" as="geometry"/></mxCell><mxCell id="c466" value="Sem Incluir Documento?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="74" y="614" width="230" height="90" as="geometry"/></mxCell><mxCell id="c465" value="&lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;: não está aberto na DEPROC (não reabre)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="424" y="634" width="270" height="50" as="geometry"/></mxCell><mxCell id="c468" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Os três que o script adiciona (TAGS_DEPROC): 01, 01.01 e 01.02" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="732" width="330" height="66" as="geometry"/></mxCell><mxCell id="c469" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_documentos_arvore() · obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Último memo da APIS destinado à GEACS (define a rodada). Sem memo ou formato inválido: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="826" width="330" height="98" as="geometry"/></mxCell><mxCell id="c470" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_memo_deproc_assinado()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memo DEPROC da GEACS na rodada (PADRAO_ASSUNTO_MEMO_DEPROC), assinado por Bruna Miiller Lavarini. Sem o memo ou sem a assinatura: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="952" width="330" height="98" as="geometry"/></mxCell><mxCell id="c471" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;apurar_coparticipacao()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linhas com SEI = processo; confere as matrículas com o memo da APIS (MatriculasDivergentes); filtra pelo período de apuração. Nenhuma linha: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="1078" width="330" height="98" as="geometry"/></mxCell><mxCell id="c472" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_conferir_configuracao()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Antes de qualquer documento: bloco BLOCO_MEMO_GEACS_CALCULO_COPA (7765003), signatário (Danúbia Lacerda Gomes de Oliveira), texto do memo e data de geração da base (-d da execução). Faltando: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="1204" width="330" height="114" as="geometry"/></mxCell><mxCell id="c473" value="➕ 01 - Tratado pelo Script&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se faltar&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="1346" width="330" height="50" as="geometry"/></mxCell><mxCell id="c476" value="Há coparticipação no período?&lt;br&gt;(atendimento e total ≠ 0)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="74" y="1424" width="230" height="120" as="geometry"/></mxCell><mxCell id="c474" value="📎 PDF Coparticipação - &amp;lt;matrícula&amp;gt; - &amp;lt;data&amp;gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;extrato de utilização, sem as linhas de valor 0; retomada pelo nome na rodada&lt;/span&gt;" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="424" y="1429" width="270" height="110" as="geometry"/></mxCell><mxCell id="c475" value="➕ 01.01 - Relatório Copart. Anexado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="424" y="1567" width="270" height="50" as="geometry"/></mxCell><mxCell id="c479" value="📄 &lt;b&gt;MemoGeacsCalculoCopa&lt;/b&gt;&lt;br&gt;no bloco 7765003 (BLOCO_MEMO_GEACS_CALCULO_COPA); tabelas: beneficiário (iniciais), matrícula, vínculo e valor (sem os de valor 0) e totais (apurado, descontado, em aberto)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="1640" width="330" height="98" as="geometry"/></mxCell><mxCell id="c480" value="➕ 01.02 - No Bloco GEACS: Memo Cálculo COPA&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;↻ remove o 01.01&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="1766" width="330" height="66" as="geometry"/></mxCell><mxCell id="c481" value="prox_acao = DEPROC: assinar memo de resultado da coparticipação e encaminhar à GEACS&lt;br&gt;Depois de assinar (manual): ➕ 01.02.1, ➖ 01.02" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c482"><mxGeometry x="24" y="1860" width="330" height="82" as="geometry"/></mxCell><mxCell id="c926" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c434" target="c437"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c927" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c434" target="c433"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c928" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c437" target="c438"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c929" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c438" target="c439"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c930" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c439" target="c441"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c931" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555