        <mxCell id="velho-q2" value="Tem algum marcador &lt;b&gt;2.2&lt;/b&gt;&lt;br&gt;(conclusão)?&lt;br&gt;2.2 - Excel Transformado em PDF&lt;br&gt;ou 2.2 - Relatório de UI Refeito" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="velho-q3" value="Tem as duas pendências &lt;b&gt;2.1&lt;/b&gt;?&lt;br&gt;(2.1 - Transformar Excel em PDF&lt;br&gt;&lt;b&gt;e&lt;/b&gt; 2.1 - Refazer Relatório de UI)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="685" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="velho-q4" value="Tem&lt;br&gt;&lt;b&gt;2.1 - Transformar Excel em PDF&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
