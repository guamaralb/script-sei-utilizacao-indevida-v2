        <mxCell id="correcao-n0" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Os marcadores aparecem com o &lt;b&gt;nome completo&lt;/b&gt;, como estão cadastrados no SEI. Todos levam o prefixo &lt;b&gt;&quot;Script v2 - &quot;&lt;/b&gt; (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="correcao-n1" value="&lt;b&gt;Quem chama&lt;/b&gt;&lt;br&gt;- main.py (_tratar_novo): matrículas lidas do memo da APIS destinado à GEACS;&lt;br&gt;- script de correção: matrículas da planilha compilada (colunas matricula_titular e matriculas_dependentes)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="195" width="320" height="185" as="geometry" />
        </mxCell>
        <mxCell id="correcao-n2" value="&lt;b&gt;Marcadores só com o processo reaberto&lt;/b&gt;&lt;br&gt;Todo marcador desta rotina é adicionado depois de reabrir o processo na unidade." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="565" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="correcao-n3" value="&lt;b&gt;Memo de correção só existe se alguém NÃO usou&lt;/b&gt; (MemoDisaUsoRede levanta ValueError se todos usaram). É identificado na árvore pelo assunto (PADRAO_ASSUNTO_MEMO_USO_REDE, aceita a grafia antiga &quot;Rede Prória&quot;)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="1530" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="correcao-n4" value="&lt;b&gt;Ordem: ➕ 1.4 - Memo Não Usou Rede no Bloco antes de ➕ 1.2 - Avaliado Se Usou Rede Própria&lt;/b&gt;&lt;br&gt;Se falhar entre os dois, a próxima execução entra pela retomada (tem 1.4 - Memo Não Usou Rede no Bloco, sem 1.2 - Avaliado Se Usou Rede Própria) e só adiciona 1.2 - Avaliado Se Usou Rede Própria." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1780" width="340" height="210" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
