e="1" parent="1" source="c318" target="c319"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c941" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c319" target="c320"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="geacs-adc-pdf-ant-man" name="geacs_adc_pdf_ant_man"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2374" pageHeight="1538" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c942" value="run_geacs_adc_pdf_ant_man · PDF das planilhas antigas, manual (main_geacs_adc_pdf_ant_man.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c943" value="As planilhas que o Chrome não baixa, colocadas à mão em dados/geacs_adc_pdf_ant_man/planilhas. Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c944" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c945" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c946" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c947" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c948" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c949" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c950" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c951" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c952" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c953" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c340" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_geacs_adc_pdf_ant_man. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1228" as="geometry"/></mxCell><mxCell id="c322" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c323" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba geacs_adc_pdf_ant_man de processos_a_processar.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="142" width="330" height="82" as="geometry"/></mxCell><mxCell id="c324" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="252" width="330" height="82" as="geometry"/></mxCell><mxCell id="c325" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="362" width="330" height="40" as="geometry"/></mxCell><mxCell id="c327" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="74" y="430" width="230" height="120" as="geometry"/></mxCell><mxCell id="c326" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="424" y="457" width="270" height="66" as="geometry"/></mxCell><mxCell id="c329" value="▶ inserir_pdfs_da_pasta() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="578" width="330" height="40" as="geometry"/></mxCell><mxCell id="c330" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="646" width="330" height="66" as="geometry"/></mxCell><mxCell id="c331" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linha do processo: script, fluxo e prox_acao do ADC PDF ANT MAN; mesmas colunas do ADC PDF ANT AUT" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="740" width="330" height="82" as="geometry"/></mxCell><mxCell id="c333" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="74" y="850" width="230" height="90" as="geometry"/></mxCell><mxCell id="c332" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="424" y="870" width="270" height="50" as="geometry"/></mxCell><mxCell id="c336" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="74" y="968" width="230" height="90" as="geometry"/></mxCell><mxCell id="c335" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="424" y="993" width="270" height="40" as="geometry"/></mxCell><mxCell id="c338" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="1086" width="330" height="50" as="geometry"/></mxCell><mxCell id="c339" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c340"><mxGeometry x="24" y="1164" width="330" height="40" as="geometry"/></mxCell><mxCell id="c354" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · inserir_pdfs_da_pasta()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;O ADC PDF ANT AUT sem o download: planilhas colocadas à mão em dados/geacs_adc_pdf_ant_man/planilhas&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="1090" as="geometry"/></mxCell><mxCell id="c341" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;registrar_tags() · garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Confere se o 01 e o 01.00 existem no SEI e lista a árvore" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="24" y="74" width="330" height="82" as="geometry"/></mxCell><mxCell id="c342" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;arquivos do processo na pasta&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Nome: &amp;lt;nº do processo com _ no lugar da barra&amp;gt;-&amp;lt;nome do documento na árvore&amp;gt;.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="24" y="184" width="330" height="66" as="geometry"/></mxCell><mxCell id="c344" value="Nenhum arquivo&lt;br&gt;do processo?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="74" y="278" width="230" height="90" as="geometry"/></mxCell><mxCell id="c343" value="prox_acao = ADC PDF ANT MAN: nenhuma planilha na pasta (verificar), sem marcador" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="424" y="290" width="270" height="66" as="geometry"/></mxCell><mxCell id="c347" value="Algum arquivo fora dos três padrões,&lt;br&gt;sem documento na árvore&lt;br&gt;ou com dois do mesmo nome?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="74" y="396" width="230" height="168" as="geometry"/></mxCell><mxCell id="c346" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: nenhum PDF inserido" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="424" y="460" width="270" height="40" as="geometry"/></mxCell><mxCell id="c349" value="&lt;b&gt;Para cada arquivo sem PDF na árvore&lt;/b&gt; (o que o ADC PDF ANT AUT já inseriu não é duplicado)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="24" y="592" width="330" height="50" as="geometry"/></mxCell><mxCell id="c350" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;ler_planilha()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Mesmas regras do ADC PDF ANT AUT" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="24" y="670" width="330" height="50" as="geometry"/></mxCell><mxCell id="c351" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;transformar_xls_em_pdf()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;PDF no layout dos relatórios do MANTIS, com a linha TOTAL. Anexo: modelo próprio, vários beneficiários" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="24" y="748" width="330" height="82" as="geometry"/></mxCell><mxCell id="c352" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_recarregar_processo() · _anexar_pdf_com_novas_tentativas()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Documento externo PDF &quot;Utilização Tit.|Dep. - &amp;lt;matrícula&amp;gt; - SEI &amp;lt;nº da planilha&amp;gt;&quot; (Anexo: &quot;Utilização Ben. - ...&quot;), Nato-digital, Restrito. Até 3 tentativas; relê a árvore antes de repetir" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="24" y="858" width="330" height="130" as="geometry"/></mxCell><mxCell id="c353" value="▶ deixar_aguardando_fluxo_normal() — coluna 3" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c354"><mxGeometry x="24" y="1016" width="330" height="50" as="geometry"/></mxCell><mxCell id="c361" value="&lt;b style=&quot;font-size:16px&quot;&gt;3 · deixar_aguardando_fluxo_normal()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Depois dos PDFs: o processo fica aguardando o fluxo inicial (run_geacs_inicial)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="1596" y="270" width="718" height="452" as="geometry"/></mxCell><mxCell id="c356" value="Já tem estado (exceto 01.00)&lt;br&gt;ou é VELHO pelo marcador (00)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c361"><mxGeometry x="74" y="74" width="230" height="120" as="geometry"/></mxCell><mxCell id="c355" value="Continua onde estava, sem marcador novo&lt;br&gt;prox_acao = ADC PDF ANT MAN: PDFs inseridos; processo mantido no estado atual" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c361"><mxGeometry x="424" y="85" width="270" height="98" as="geometry"/></mxCell><mxCell id="c358" value="➕ 01 - Tratado pelo Script&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se faltar&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c361"><mxGeometry x="24" y="222" width="330" height="50" as="geometry"/></mxCell><mxCell id="c359" value="➕ 01.00 - Aguarda Script: Fluxo Normal&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se faltar&lt;/span&gt;" style="shape=hexa