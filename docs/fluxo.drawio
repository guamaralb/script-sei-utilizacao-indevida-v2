="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1596" pageHeight="1756" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c836" value="run_geacs_canc_memo_deproc_ant · Cancelar o memo DEPROC antigo (main_geacs_canc_memo_deproc_ant.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c837" value="Na unidade da GEACS. Não altera a prox_acao. Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c838" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c839" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c840" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c841" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c842" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c843" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c844" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c845" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c846" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c847" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c380" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_geacs_canc_memo_deproc_ant. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1244" as="geometry"/></mxCell><mxCell id="c362" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c363" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba geacs_canc_memo_deproc_ant de processos_a_processar.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="142" width="330" height="82" as="geometry"/></mxCell><mxCell id="c364" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="252" width="330" height="82" as="geometry"/></mxCell><mxCell id="c365" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="362" width="330" height="40" as="geometry"/></mxCell><mxCell id="c367" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="74" y="430" width="230" height="120" as="geometry"/></mxCell><mxCell id="c366" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="424" y="457" width="270" height="66" as="geometry"/></mxCell><mxCell id="c369" value="▶ cancelar_memos_deproc_antigos() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="578" width="330" height="40" as="geometry"/></mxCell><mxCell id="c370" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="646" width="330" height="66" as="geometry"/></mxCell><mxCell id="c371" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Não altera a prox_acao: só script, ultima_passagem, data_execucao e as colunas canc_memo_deproc_ant_* (o erro vai para canc_memo_deproc_ant_tipo_erro / _erro)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="740" width="330" height="98" as="geometry"/></mxCell><mxCell id="c373" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="74" y="866" width="230" height="90" as="geometry"/></mxCell><mxCell id="c372" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="424" y="886" width="270" height="50" as="geometry"/></mxCell><mxCell id="c376" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="74" y="984" width="230" height="90" as="geometry"/></mxCell><mxCell id="c375" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="424" y="1009" width="270" height="40" as="geometry"/></mxCell><mxCell id="c378" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="1102" width="330" height="50" as="geometry"/></mxCell><mxCell id="c379" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c380"><mxGeometry x="24" y="1180" width="330" height="40" as="geometry"/></mxCell><mxCell id="c403" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · cancelar_memos_deproc_antigos()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cancela todos os memos DEPROC antigos da GEACS, que serão ou já foram substituídos por uma nova versão. Não lê nem adiciona marcadores&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="1446" as="geometry"/></mxCell><mxCell id="c382" value="Sem Incluir Documento&lt;br&gt;(fechado no setor)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="74" y="90" width="230" height="120" as="geometry"/></mxCell><mxCell id="c381" value="&lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;: não reabre, nada é cancelado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="424" y="125" width="270" height="50" as="geometry"/></mxCell><mxCell id="c384" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_documentos_arvore()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Todos os memorandos da GEACS - Utilização (toda a árvore, não só a rodada)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="24" y="238" width="330" height="66" as="geometry"/></mxCell><mxCell id="c385" value="&lt;b&gt;Para cada memorando da GEACS&lt;/b&gt;: lê o texto (encontrar_memos_deproc_antigos)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="24" y="332" width="330" height="50" as="geometry"/></mxCell><mxCell id="c387" value="Falta algum dos três trechos?&lt;br&gt;&quot;Para: IPSEMG/DEPROC&quot;&lt;br&gt;&quot;Assunto: Levantamento de coparticipação - utilização indevida da assistência à saúde&quot;&lt;br&gt;&quot;levantamento dos valores de coparticipação referentes aos atendimentos efetivamente realizados&quot;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="39" y="410" width="300" height="248" as="geometry"/></mxCell><mxCell id="c386" value="Não é o memo DEPROC antigo: ignorado" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="424" y="509" width="270" height="50" as="geometry"/></mxCell><mxCell id="c390" value="Sem data legível&lt;br&gt;(&quot;Belo Horizonte, 18 de&lt;br&gt;setembro de 2026.&quot;)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="74" y="686" width="230" height="136" as="geometry"/></mxCell><mxCell id="c389" value="Não cancela: vai para canc_memo_deproc_ant_nao_cancelados (erro no fim)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="424" y="729" width="270" height="50" as="geometry"/></mxCell><mxCell id="c393" value="Datado a partir de&lt;br&gt;15/10/2026?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="74" y="850" width="230" height="104" as="geometry"/></mxCell><mxCell id="c392" value="Não é antigo: ignorado" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="424" y="882" width="270" height="40" as="geometry"/></mxCell><mxCell id="c395" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;selecionar_doc() · cancelar_doc()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Motivo: &quot;Documento será ou já foi substituído por uma nova versão&quot;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="24" y="982" width="330" height="66" as="geometry"/></mxCell><mxCell id="c397" value="Sem a opção&lt;br&gt;Cancelar Documento?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="74" y="1076" width="230" height="104" as="geometry"/></mxCell><mxCell id="c396" value="Já cancelado, assinado ou sem permissão: vai para canc_memo_deproc_ant_nao_cancelados e segue para os outros" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c403"><mxGeometry x="424" y="1087" width="270" height="82" as="geometry"/></mxCell><mxCell id="c400" value="Algum memo antigo&lt;br&gt;não cancelado?" style="rhombus