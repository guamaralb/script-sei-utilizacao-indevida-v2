ecao-f4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="script-correcao-e23" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="script-correcao-q4" target="script-correcao-a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="script-correcao-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="script-correcao-a5" target="script-correcao-s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="script-correcao-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="script-correcao-prox" target="script-correcao-qloop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="450"/></Array></mxGeometry></mxCell><mxCell id="script-correcao-n1" value="&lt;b&gt;Objetivo&lt;/b&gt;&lt;br&gt;Corrigir os NOVOS encaminhados à DISA e à DEPROC &lt;b&gt;sem&lt;/b&gt; avaliação do uso da rede própria. Nenhum marcador é adicionado na triagem: só a rotina de correção adiciona." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="385" width="260" height="130" as="geometry"/></mxCell><mxCell id="script-correcao-n2" value='&lt;b&gt;Erros (caixas vermelhas)&lt;/b&gt;&lt;br&gt;registrar_erro(registro, e) preenche tipo_erro, erro e, se preciso, prox_acao = "Verificar erro".&lt;br&gt;ErroAvaliacao / FormatoMemorandoInvalido: log sem traceback. Falha inesperada: logger.exception.&lt;br&gt;O processo termina e o loop segue: &lt;b&gt;um erro nunca interrompe os demais&lt;/b&gt;.' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1290" y="1225" width="280" height="150" as="geometry"/></mxCell><mxCell id="script-correcao-n3" value="&lt;b&gt;Os dois main nunca se importam&lt;/b&gt;: a rotina de correção fica em correcao_rede_propria.py e é usada pelos dois scripts." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="1390" width="260" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="legenda" name="8. Legenda e marcadores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="legenda-tit" value="8. Legenda e marcadores (tags.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="-20" width="900" height="40" as="geometry"/></mxCell><mxCell id="legenda-leg-t" value="Legenda" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="45" width="200" height="30" as="geometry"/></mxCell><mxCell id="legenda-leg0" value="Início / fim" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="88" width="230" height="34" as="geometry"/></mxCell><mxCell id="legenda-leg1" value="Ação do script" style="rounde