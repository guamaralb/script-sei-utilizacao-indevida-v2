185" value="➖ 01.08 - Avaliado Uso Rede Própria MANTIS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="1088" y="1694" width="240" height="50" as="geometry"/></mxCell><mxCell id="c186" value="prox_acao = Assinar memo à APIS (nenhum uso nas bases)&lt;br&gt;&lt;b&gt;sem DEPROC&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="1088" y="1772" width="240" height="66" as="geometry"/></mxCell><mxCell id="c187" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_finalizar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Número SEI dos memos criados (registrar_numeros_memos)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="511" y="2010" width="330" height="66" as="geometry"/></mxCell><mxCell id="c221" value="Volta para a coluna 1&lt;br&gt;(planilha de controle)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c222"><mxGeometry x="24" y="2104" width="330" height="50" as="geometry"/></mxCell><mxCell id="c847" value="Funções usadas em vários pontos" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3826" y="240" width="500" height="34" as="geometry"/></mxCell><mxCell id="c266" value="&lt;b&gt;Marcadores&lt;/b&gt; (prefixo &quot;v2: &quot;; os da versão anterior, &quot;v2v: &quot;; ★ = estado: no máximo um)&lt;br&gt;00 - Processo VELHO&lt;br&gt;01 - Tratado pelo Script&lt;br&gt;01.01 - Período Variável p/ Dependentes&lt;br&gt;01.02.1 - Mat. N Encontradas Base APIS&lt;br&gt;★ 01.00 - Aguarda Script: Fluxo Normal (adicionado pelo fluxo ADC PDF ANT AUT)&lt;br&gt;★ 01.05.B - No Bloco APIS: Sem Memo p/ GEACS&lt;br&gt;★ 01.05.A - No Bloco APIS: Formato Inválido&lt;br&gt;★ 01.06 - Avaliado Uso Rede Própria DISA&lt;br&gt;★ 01.06.1 - No Bloco APIS: Matrículas&lt;br&gt;★ 01.07 - No Bloco APIS: Período Deps&lt;br&gt;★ 01.08 - Avaliado Uso Rede Própria MANTIS&lt;br&gt;★ 01.09.B - No Bloco DISA: Validar (Consta)&lt;br&gt;★ 01.09.C - No Bloco DISA: Validar (N Consta)&lt;br&gt;★ 01.09.A - No Bloco DISA: Relat. s/ MANTIS&lt;br&gt;★ 01.10.B - No Bloco DEPROC: Coparticipação&lt;br&gt;★ 01.10.A - No Bloco APIS: Sem Uso&lt;br&gt;★ 01.12 - No Bloco APIS: Todas as Infos (run_geacs_todas_infos)&lt;br&gt;&lt;i&gt;Manuais, depois da assinatura (quem coloca remove o &quot;No Bloco&quot;):&lt;/i&gt;&lt;br&gt;★ 01.05.B.1 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;★ 01.05.A.1 - Aguarda APIS: Formato Inválido&lt;br&gt;★ 01.06.1.1 - Aguarda APIS: Matrículas&lt;br&gt;★ 01.07.1 - Aguarda APIS: Período Deps&lt;br&gt;★ 01.09.B.1 - Aguarda DISA: Validar (Consta)&lt;br&gt;★ 01.09.C.1 - Aguarda DISA: Validar (N Consta)&lt;br&gt;★ 01.09.A.1 - Aguarda DISA: Relat. s/ MANTIS&lt;br&gt;★ 01.10.B.1 - Aguarda DEPROC: Coparticipação&lt;br&gt;★ 01.10.A.1 - Aguarda APIS: Sem Uso&lt;br&gt;★ 01.12.1 - Encaminhado APIS: Todas as Infos (conclusão)&lt;br&gt;&lt;i&gt;Versão anterior:&lt;br&gt;01.06.2 / 01.08.2 / 01.08.3 - Usou / Não Usou RP e RC (não são mais adicionados)&lt;br&gt;01.02 - Avaliado Se Usou Rede Própria&lt;br&gt;01.02.2 - Mat. N Encontradas Base DISA (não é mais conferido)&lt;br&gt;01.03 - Memos DISA e DEPROC no Bloco, 01.03 - Memo DEPROC no Bloco (não são mais lidos)&lt;br&gt;01.04 - Memo Não Usou Rede no Bloco&lt;br&gt;★ 01.08.1 - Memo DISA Validar Usos MANTIS&lt;br&gt;★ 01.09 - Memo DISA Uso Rede Própria&lt;br&gt;★ 01.10 - Concluído: Memos DISA e DEPROC&lt;br&gt;★ 01.11 - VELHO Concluído: Memo DISA&lt;br&gt;★ 01.11 - VELHO Concluído: Memo DEPROC&lt;/i&gt;" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3826" y="280" width="718" height="658" as="geometry"/></mxCell><mxCell id="c235" value="&lt;b style=&quot;font-size:16px&quot;&gt;_separar_velho()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Processo VELHO&lt;/b&gt; (enviado à DISA e à DEPROC antes da avaliação): marcado e &lt;b&gt;não processado&lt;/b&gt;. TODO: definir o fluxo do VELHO&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=66;" vertex="1" parent="1"><mxGeometry x="3826" y="978" width="718" height="678" as="geometry"/></mxCell><mxCell id="c224" value="Processo fechado&lt;br&gt;no setor?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="74" y="90" width="230" height="90" as="geometry"/></mxCell><mxCell id="c223" value="&lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;: não reabre, nada é feito no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="424" y="110" width="270" height="50" as="geometry"/></mxCell><mxCell id="c228" value="Tem MANUAL?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="74" y="208" width="230" height="90" as="geometry"/></mxCell><mxCell id="c226" value="➖ 01.00 - Aguarda Script: Fluxo Normal&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se tiver&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="424" y="220" width="270" height="66" as="geometry"/></mxCell><mxCell id="c227" value="prox_acao = Fora do escopo (tratado manualmente)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="424" y="314" width="270" height="50" as="geometry"/></mxCell><mxCell id="c231" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="24" y="380" width="330" height="40" as="geometry"/></mxCell><mxCell id="c232" value="➕ 00 - Processo VELHO&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se ainda não tiver&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="24" y="448" width="330" height="50" as="geometry"/></mxCell><mxCell id="c233" value="➖ 01.00 - Aguarda Script: Fluxo Normal&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se tiver&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="24" y="526" width="330" height="50" as="geometry"/></mxCell><mxCell id="c234" value="prox_acao = VELHO: não processado (fluxo ainda não definido)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c235"><mxGeometry x="24" y="604" width="330" height="50" as="geometry"/></mxCell><mxCell id="c240" value="&lt;b style=&quot;font-size:16px&quot;&gt;adicionar_tag()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Única forma de adicionar marcador (cada ➕ do diagrama)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;