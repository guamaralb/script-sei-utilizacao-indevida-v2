        <mxCell id="m-tit" value="5. Matrículas não encontradas (&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;marcar_matriculas_nao_encontradas&lt;/font&gt;&lt;/b&gt;, matriculas_nao_encontradas.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="-80" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="m-ini" value="&lt;b&gt;Entrada&lt;/b&gt; (corrigir_uso_rede_propria; previsto: VELHO &quot;Refazer relatório de UI&quot;)&lt;br&gt;avaliar_uso levantou MatriculasNaoEncontradas (resultado de cada base) + marcadores do ramo" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="0" width="520" height="70" as="geometry" /></mxCell>
        <mxCell id="m-c-main" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;marcar_matriculas_nao_encontradas&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;matriculas_nao_encontradas.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#bac8d3;strokeColor=#23445d;swimlaneFillColor=#f7f9fb;" vertex="1" parent="1"><mxGeometry x="0" y="106" width="1380" height="1624" as="geometry" /></mxCell>
        <mxCell id="m-a-reg" value="Registro (planilha de controle):&lt;br&gt;base geral → titular_nao_encontrado_base_geral, deps_nao_encontrados_base_geral&lt;br&gt;rede própria → titular_nao_encontrado, deps_nao_encontrados&lt;br&gt;&lt;b&gt;prox_acao&lt;/b&gt; = Verificar matrículas não encontradas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="58" width="440" height="106" as="geometry" /></mxCell>
        <mxCell id="m-a-gar" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;garantir_marcadores_no_sei&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[marcador da base geral (1.2.1/2.1.1) e/ou da rede própria (1.2.2/2.1.2), conforme as bases afetadas]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="200" width="440" height="74" as="geometry" /></mxCell>
        <mxCell id="m-err-gar" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): marcador não cadastrado no SEI. Nenhum memo nem marcador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="m-c-main"><mxGeometry x="20" y="208" width="260" height="58" as="geometry" /></mxCell>
        <mxCell id="m-q-geral" value="Faltou matrícula na &lt;b&gt;base geral&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="310" width="440" height="100" as="geometry" /></mxCell>
        <mxCell id="m-c-incl" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;incluir_memo_apis_mat_nao_encontradas&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;matriculas_nao_encontradas.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="m-c-main"><mxGeometry x="320" y="446" width="1040" height="496" as="geometry" /></mxCell>
        <mxCell id="m-i-qbloco" value="BLOCO_MEMO_APIS_MAT_NAO_ENCONTRADAS configurado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="m-c-incl"><mxGeometry x="320" y="58" width="400" height="102" as="geometry" /></mxCell>
        <mxCell id="m-i-errbloco" value="&lt;b&gt;Erro&lt;/b&gt; (ErroAvaliacao): bloco não configurado. Sem memo e sem marcador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="m-c-incl"><mxGeometry x="20" y="80" width="260" height="58" as="geometry" /></mxCell>
        <mxCell id="m-i-qarv" value="Memo à APIS já está na árvore?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;(encontrar_memo_mat_nao_encontradas, pelo assunto)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="m-c-incl"><mxGeometry x="320" y="196" width="400" height="138" as="geometry" /></mxCell>
        <mxCell id="m-i-ret" value="&lt;b&gt;Retomada&lt;/b&gt;: não recria o memo&lt;br&gt;Registro: memo_apis_mat_nao_encontradas_na_arvore, memo_apis_mat_nao_encontradas_sei" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="m-c-incl"><mxGeometry x="760" y="220" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="m-i-memo" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;incluir_doc_sei_memo · inserir_bloco_ass&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Cria &lt;b&gt;MemoApisMatNaoEncontradas&lt;/b&gt; e insere no bloco &lt;b&gt;7711907&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Devolve à APIS para conferir as matrículas: retificar e reencaminhar à GEACS-Utilização se houver erro; se estiver correta, encaminhar à IPSEMG/GEACS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="m-c-incl"><mxGeometry x="320" y="370" width="400" height="106" as="geometry" /></mxCell>
        <mxCell id="m-t-geral" value="➕ 1.2.1 (NOVO) ou 2.1.1 (VELHO) - Mat. N Encontradas Base Geral&lt;br&gt;&lt;font style=&quot;font-weight:normal;font-size:10px&quot;&gt;Também indica que o memo à APIS está no bloco&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="978" width="440" height="60" as="geometry" /></mxCell>
        <mxCell id="m-a-prox" value="&lt;b&gt;prox_acao&lt;/b&gt; = Assinar memo à APIS (matrículas não encontradas) e encaminhar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="1074" width="440" height="58" as="geometry" /></mxCell>
        <mxCell id="m-q-rede" value="Faltou matrícula na &lt;b&gt;base da rede própria&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="1168" width="440" height="102" as="geometry" /></mxCell>
        <mxCell id="m-t-rede" value="➕ 1.2.2 (NOVO) ou 2.1.2 (VELHO) - Mat. N Encontradas Base DISA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="1306" width="440" height="50" as="geometry" /></mxCell>
        <mxCell id="m-q-criado" value="O memo à APIS foi criado nesta execução?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="1392" width="440" height="102" as="geometry" /></mxCell>
        <mxCell id="m-a-num" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;_registrar_numero_memo_apis&lt;/font&gt;&lt;/b&gt;&lt;br&gt;memos_geacs_novos: relê a árvore e preenche memo_apis_mat_nao_encontradas_sei (falha só gera log)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="m-c-main"><mxGeometry x="620" y="1530" width="440" height="74" as="geometry" /></mxCell>
        <mxCell id="m-fim" value="&lt;b&gt;Fim&lt;/b&gt;: quem chamou relança o erro&lt;br&gt;Processo parado, sem memos DISA/DEPROC e sem 1.2" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="1766" width="480" height="60" as="geometry" /></mxCell>
        <mxCell id="m-nota0" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• Moldura = &lt;b&gt;função&lt;/b&gt; (nome e módulo no topo); caixas dentro = passos na ordem em que o código executa. Funções chamadas aparecem como molduras aninhadas.&lt;br&gt;• Azul: ação · Amarelo: pergunta · Roxo: memo criado e inserido no bloco · Verde: ➕ marcador · Vermelho: erro · Cinza: início/fim · Laranja: detalhado em outra aba (clique).&lt;br&gt;• Erros à esquerda; desvios que param o processo ou seguem outro caminho, à direita. Tracejado: previsto (não implementado).&lt;br&gt;• Legenda completa e tabela de marcadores: aba 8." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="0" width="560" height="170" as="geometry" /></mxCell>
        <mxCell id="m-nota1" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Prefixo &quot;Script v2 - &quot; em todos (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres. Aqui os marcadores aparecem sem o prefixo." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="194" width="560" height="80" as="geometry" /></mxCell>
        <mxCell id="m-nota2" value="&lt;b&gt;Quem chama&lt;/b&gt; (com os marcadores do ramo)&lt;br&gt;• rotina de correção (aba 4), com o processo reaberto: 1.2.1 / 1.2.2;&lt;br&gt;• fluxo VELHO &quot;Refazer relatório de UI&quot; (previsto, aba 6): 2.1.1 / 2.1.2.&lt;br&gt;O fluxo normal (aba 3) &lt;b&gt;não&lt;/b&gt; usa esta rotina: chama só incluir_memo_apis_mat_nao_encontradas." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="298" width="560" height="110" as="geometry" /></mxCell>
        <mxCell id="m-nota3" value="&lt;b&gt;avaliar_uso procura nas duas bases antes de parar&lt;/b&gt;: &quot;Faltou na base geral?&quot; e &quot;Faltou na base da rede própria?&quot; podem dar Sim no mesmo processo.&lt;br&gt;Nos processos o titular vem com DV e os dependentes sem DV." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="432" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="m-nota4" value="&lt;b&gt;Memo à APIS&lt;/b&gt;&lt;br&gt;Não altere o assunto: ele identifica o memo na árvore (PADRAO_ASSUNTO_MEMO_MAT_NAO_ENCONTRADAS). Se já existe sem o marcador, é retomada: só os marcadores são adicionados." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="546" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="m-nota5" value="&lt;b&gt;Próximas execuções&lt;/b&gt;&lt;br&gt;Com esses marcadores o processo dá erro e não é processado. Para reprocessar: corrigir a base e remover os marcadores manualmente no SEI." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="660" width="560" height="80" as="geometry" /></mxCell>
        <mxCell id="m-nota6" value="&lt;b&gt;Erros&lt;/b&gt;&lt;br&gt;Todo erro sobe até _processar_linha: registrar_erro preenche tipo_erro, erro e, se preciso, prox_acao = Verificar erro. ErroAvaliacao, FormatoMemorandoInvalido e TextoMemoPendente são logados sem traceback; falha inesperada, com logger.exception. &lt;b&gt;Um erro nunca interrompe os demais processos.&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="764" width="560" height="110" as="geometry" /></mxCell>
        <mxCell id="m-e1" edge="1" parent="1" source="m-ini" target="m-c-main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6087;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
