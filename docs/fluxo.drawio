abelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="matriculas-t8" target="matriculas-a8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="matriculas-a8" target="matriculas-q9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="1310"/><mxPoint x="440" y="1310"/></Array></mxGeometry></mxCell><mxCell id="matriculas-e17" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="matriculas-q3" target="matriculas-q9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-e18" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="matriculas-q9" target="matriculas-t9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="matriculas-t9" target="matriculas-a10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="1520"/></Array></mxGeometry></mxCell><mxCell id="matriculas-e20" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="matriculas-q9" target="matriculas-a10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="matriculas-a10" target="matriculas-f10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="matriculas-n1" value='&lt;b&gt;Quem chama&lt;/b&gt; (com os marcadores do ramo)&lt;br&gt;- processar_novo: 1.2.1 / 1.2.2;&lt;br&gt;- rotina de correção (já com o processo reaberto): 1.2.1 / 1.2.2;&lt;br&gt;- fluxo VELHO "Refazer relatório" (previsto): 2.1.1 / 2.1.2.' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="255" width="240" height="150" as="geometry"/></mxCell><mxCell id="matriculas-n2" value="&lt;b&gt;avaliar_uso procura nas duas bases antes de parar&lt;/b&gt;, por isso as duas perguntas podem dar Sim no mesmo processo.&lt;br&gt;Nos processos o titular vem com DV e os dependentes sem DV." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="625" width="240" height="150" as="geometry"/></mxCell><mxCell id="matriculas-n3" value="&lt;b&gt;Memo à APIS&lt;/b&gt;&lt;br&gt;Não altere o assunto: ele identifica o memo na árvore (PADRAO_ASSUNTO_MEMO_MAT_NAO_ENCONTRADAS). ➕1.2.1/2.1.1 só depois do memo no bloco: o marcador também indica que o memo está no bloco." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="925" width="280" height="150" as="geometry"/></mxCell><mxCell id="matriculas-n4" value="&lt;b&gt;Próximas execuções&lt;/b&gt;&lt;br&gt;Com 1.2.1/1.2.2 ou 2.1.1/2.1.2 o processo dá erro e não é processado. Para reprocessar: corrigir a base e remover os marcadores manualmente no SEI." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="0" y="1490" width="240" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="velho" name="6. VELHO"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="velho-tit" value="6. VELHO: roteamento (main._tratar_velho) e instruções (processar_velho) — somente estrutura" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="-20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="velho-ini" value="Entrada: processo com &lt;b&gt;2&lt;/b&gt; (VELHO)&lt;br&gt;(classificado em execução anterior)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="300" height="60" as="geometry"/></mxCell><mxCell id="velho-q1" value="Tem &lt;b&gt;2.1.1&lt;/b&gt;&lt;br&gt;ou &lt;b&gt;2.1.2&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="125" width="220" height="110" as="geometry"/></mxCell><mxCell id="velho-e1" value="Erro: processo parado&lt;br&gt;(matrículas não encontradas)&lt;br&gt;&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;Verificar matrículas não encontradas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="135" width="300" height="90" as="geometry"/></mxCell><mxCell id="velho-q2" value="Tem algum&lt;br&gt;&lt;b&gt;2.2&lt;/b&gt;&lt;br&gt;(conclusão)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="265" width="220" height="110" as="geometry"/></mxCell><mxCell id="velho-f2" value="Stub: fluxo após conclusão&lt;br&gt;&lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;VELHO: fluxo após conclusão&lt;br&gt;(não implementado)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="280" width="300" height="80" as="geometry"/></mxCell><mxCell id="velho-q3" value="Tem as duas&lt;br&gt;pendências &lt;b&gt;2.1&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="405" width="220" height="110" as="geometry"/></mxCell><mxCell id="velho-e3" value="Erro: marcado para transformar&lt;br&gt;Excel em PDF e para refazer&lt;br&gt;o relatório de UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="420" width="300" height="80" as="geometry"/></mxCell><mxCell id="velho-q4" value="Tem &lt;b&gt;2.1 Transformar&lt;br&gt;Excel em PDF&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="550" width="240" height="120" as="geometry"/></mxCell><mxCell id="velho-f4" value="Stub &lt;b&gt;prox_acao:&lt;/b&gt;&lt;br&gt;VELHO: transformar Excel&lt;br&gt;em PDF (não implementado)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fill