cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c878" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c879" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c880" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c881" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c882" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c883" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c884" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c885" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c886" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c887" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c538" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_geacs_verificar_marcadores. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1286" as="geometry"/></mxCell><mxCell id="c520" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c521" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba geacs_verificar_marcadores de processos_a_processar.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="142" width="330" height="82" as="geometry"/></mxCell><mxCell id="c522" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="252" width="330" height="82" as="geometry"/></mxCell><mxCell id="c523" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="362" width="330" height="40" as="geometry"/></mxCell><mxCell id="c525" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="74" y="430" width="230" height="120" as="geometry"/></mxCell><mxCell id="c524" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="424" y="457" width="270" height="66" as="geometry"/></mxCell><mxCell id="c527" value="▶ verificar_marcadores(linha_processo()) — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="578" width="330" height="50" as="geometry"/></mxCell><mxCell id="c528" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="656" width="330" height="66" as="geometry"/></mxCell><mxCell id="c529" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Não altera a prox_acao (nem fluxo e erro dos outros fluxos): só script, ultima_passagem, data_execucao, as colunas de marcadores e verificar_marcadores_inconsistencia / verificar_marcadores_erro (antes das de marcadores, em amarelo)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="750" width="330" height="130" as="geometry"/></mxCell><mxCell id="c531" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="74" y="908" width="230" height="90" as="geometry"/></mxCell><mxCell id="c530" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="424" y="928" width="270" height="50" as="geometry"/></mxCell><mxCell id="c534" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="74" y="1026" width="230" height="90" as="geometry"/></mxCell><mxCell id="c533" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="424" y="1051" width="270" height="40" as="geometry"/></mxCell><mxCell id="c536" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="1144" width="330" height="50" as="geometry"/></mxCell><mxCell id="c537" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c538"><mxGeometry x="24" y="1222" width="330" height="40" as="geometry"/></mxCell><mxCell id="c559" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · verificar_marcadores() · conferir_processo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Lê os marcadores e confere a prox_acao da planilha de controle com eles e com os memorandos, sem nenhuma ação no SEI. Cada problema vai para verificar_marcadores_inconsistencia&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="1198" as="geometry"/></mxCell><mxCell id="c539" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_marcadores() · registrar_tags()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Marcadores do processo no SEI" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="24" y="90" width="330" height="50" as="geometry"/></mxCell><mxCell id="c540" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;colunas_tags() · demais_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Uma coluna tag_* por marcador válido na GEACS (TAGS_VALIDOS_GEACS, 30). Os outros (v2v:, 01.06.2 / 01.08.2 / 01.08.3, manuais, antigos) vão juntos para demais_marcadores" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="24" y="168" width="330" height="98" as="geometry"/></mxCell><mxCell id="c542" value="Planilha de controle&lt;br&gt;não lida?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="74" y="294" width="230" height="104" as="geometry"/></mxCell><mxCell id="c541" value="A prox_acao não é conferida (só os memorandos)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="424" y="321" width="270" height="50" as="geometry"/></mxCell><mxCell id="c545" value="conferir_marcadores():&lt;br&gt;combinação impossível?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="74" y="426" width="230" height="120" as="geometry"/></mxCell><mxCell id="c544" value="Inconsistência: os problemas (prox_acao esperada: Verificar marcadores inconsistentes)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="424" y="453" width="270" height="66" as="geometry"/></mxCell><mxCell id="c548" value="conferir_prox_acao():&lt;br&gt;prox_acao não é a do estado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="74" y="574" width="230" height="120" as="geometry"/></mxCell><mxCell id="c547" value="Inconsistência: prox_acao esperada (No Bloco: assinar; Aguarda: aguardar resposta; 00: VELHO; 01.00: ADC aguarda; sem estado: vazia ou erro). Sempre aceitas: erros, ADC sem planilhas / estado mantido, DEPROC:" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="424" y="577" width="270" height="114" as="geometry"/></mxCell><mxCell id="c552" value="No Bloco / Aguarda&lt;br&gt;de memo?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="74" y="722" width="230" height="104" as="geometry"/></mxCell><mxCell id="c550" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_caso_disa_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;caso_disa_mantis da planilha (se preenchido) é o do memo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="424" y="741" width="270" height="66" as="geometry"/></mxCell><mxCell id="c551" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_memo_do_marcador()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memo pelo assunto na árvore (No Bloco: na rodada); relatórios RP / RC que ele cita antes dele; memo_*_sei da planilha na árvore; No Bloco Sem Memo com memo da APIS para a GEACS" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="424" y="835" width="270" height="114" as="geometry"/></mxCell><mxCell id="c556" value="Retomada&lt;br&gt;(01.06, 01.08)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="74" y="958" width="230" height="90" as="geometry"/></mxCell><mxCell id="c555" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_retomada()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memo do fluxo na rodada sem o marcador (o geacs_inicial o reaproveita)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="424" y="970" width="270" height="66" as="geometry"/></mxCell><mxCell id="c558" value="Planilha: tag_*, demais_marcadores, marcadores_finais e verificar_marcadores_inconsistencia (erro: verificar_marcadores_erro; sem ler os marcadores, as colunas deles ficam como estavam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c559"><mxGeometry x="24" y="1076" width="330" height="98" as="geometry"/></mxCell><mxCell id="c888" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c521" target="c522"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c889" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c522" target="c523"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c890" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c523" target="c525"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c891" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c525" target="c527"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c892" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c525" target="c524"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c893" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c527" target="c528"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell