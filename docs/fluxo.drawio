dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c166"><mxGeometry x="1679" y="12559" width="340" height="66" as="geometry"/></mxCell><mxCell id="c165" value="Fim" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c166"><mxGeometry x="1709" y="12659" width="280" height="40" as="geometry"/></mxCell><mxCell id="c230" value="Funções chamadas em vários pontos" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="4288" y="40" width="600" height="34" as="geometry"/></mxCell><mxCell id="c227" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Legenda&lt;/b&gt;&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=34;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="4288" y="80" width="818" height="1090" as="geometry"/></mxCell><mxCell id="c215" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Moldura: função; molduras aninhadas = funções chamadas por ela&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;startSize=62;verticalAlign=top;" vertex="1" parent="c227"><mxGeometry x="24" y="58" width="380" height="160" as="geometry"/></mxCell><mxCell id="c214" value="passos na ordem de execução; desvios à direita" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c215"><mxGeometry x="24" y="86" width="320" height="50" as="geometry"/></mxCell><mxCell id="c216" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Função chamada (o que ela faz)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c227"><mxGeometry x="44" y="252" width="340" height="50" as="geometry"/></mxCell><mxCell id="c217" value="&lt;b&gt;função()&lt;/b&gt; detalhada na coluna da direita" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="54" y="336" width="320" height="40" as="geometry"/></mxCell><mxCell id="c219" value="Pergunta" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="64" y="410" width="300" height="80" as="geometry"/></mxCell><mxCell id="c218" value="desvio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="474" y="480" width="320" height="40" as="geometry"/></mxCell><mxCell id="c220" value="➕ Marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="44" y="554" width="340" height="44" as="geometry"/></mxCell><mxCell id="c221" value="➖ Marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontStyle=1;fontSize=12;fontColor=#8a5a00;" vertex="1" parent="c227"><mxGeometry x="44" y="632" width="340" height="44" as="geometry"/></mxCell><mxCell id="c222" value="📄 Memo criado e inserido no bloco" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="44" y="710" width="340" height="40" as="geometry"/></mxCell><mxCell id="c223" value="📎 Relatório PDF anexado (documento externo)" style="shape=document;boundedLbl=1;size=0.15;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="44" y="784" width="340" height="50" as="geometry"/></mxCell><mxCell id="c224" value="&lt;b&gt;Erro&lt;/b&gt; (processo termina com registrar_erro)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="54" y="868" width="320" height="40" as="geometry"/></mxCell><mxCell id="c225" value="Início / fim / prox_acao" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="74" y="942" width="280" height="40" as="geometry"/></mxCell><mxCell id="c226" value="Seta tracejada: volta ao fluxo principal. Seta vermelha: leva a erro" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="44" y="1016" width="340" height="50" as="geometry"/></mxCell><mxCell id="c228" value="&lt;b&gt;Pendências (TODO)&lt;/b&gt;&lt;br&gt;• remover_marcador na sei_automacao (sem ele o main não inicia)&lt;br&gt;• cadastrar no SEI: 1.10 Memos DISA e DEPROC, 1.11 VELHO Memo DISA, 1.11 VELHO Memo DEPROC&lt;br&gt;• revisar textos: MemoDisa, MemoDeprocRedeCredenciada, memos à APIS (TEXTO_DEFINIDO)&lt;br&gt;• tratar a resposta dos processos parados e dos VELHOS que aguardam a DISA&lt;br&gt;• pesquisa da utilização indevida em si" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4288" y="1230" width="420" height="178" as="geometry"/></mxCell><mxCell id="c173" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;adicionar_tag()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Única forma de adicionar marcador. Se for marcador de estado, remove o estado anterior (primeiro adiciona, depois remove)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=62;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="4288" y="1468" width="798" height="583" as="geometry"/></mxCell><mxCell id="c167" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;adicionar_marcador()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;sei_automacao: adiciona o marcador no SEI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c173"><mxGeometry x="24" y="86" width="340" height="50" as="geometry"/></mxCell><mxCell id="c168" value="➕ marcador (coluna marcadores_adicionados)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="c173"><mxGeometry x="24" y="170" width="340" height="44" as="geometry"/></mxCell><mxCell id="c171" value="É marcador de estado?&lt;br&gt;(TAGS_ESTADO_NOVO)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c173"><mxGeometry x="44" y="248" width="300" height="82" as="geometry"/></mxCell><mxCell id="c169" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;remover_tag() → remover_marcador()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Para cada outro estado presente. Placeholder: NotImplementedError enquanto a sei_automacao não tiver remover_marcador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c173"><mxGeometry x="434" y="319" width="340" height="82" as="geometry"/></mxCell><mxCell id="c170" value="➖ estado anterior&lt;br&gt;(coluna marcadores_removidos)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontStyle=1;fontSize=12;fontColor=#8a5a00;" vertex="1" parent="c173"><mxGeometry x="434" y="435" width="340" height="50" as="geometry"/></mxCell><mxCell id="c172" value="Fim" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c173"><mxGeometry x="54" y="519" width="280" height="40" as="geometry"/></mxCell><mxCell id="c177" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;adicionar_tag_se_ausente()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Para os informativos (1.1, 1.2.1, 1.2.2) na retomada&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=46;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="4288" y="2111" width="758" height="278" as="geometry"/></mxCell><mxCell id="c175" value="Já tem o marcador?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c177"><mxGeometry x="34" y="70" width="300" height="80" as="geometry"/></mxCell><mxCell id="c174" value="Não faz nada (log de retomada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="c177"><mxGeometry x="414" y="140" width="320" height="40" as="geometry"/></mxCell><mxCell id="c176" value="&lt;b&gt;adicionar_tag()&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="c177"><mxGeometry x="24" y="214" width="320" height="40" as="geometry"/></mxCell><mxCell id="c187" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;_parar_com_memo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Memos à APIS que param o processo até a resposta&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=46;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="4288" y="2449" width="388" height="748" as="geometry"/></mxCell><mxCell id="c178" value="&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;br&gt;tag_antes e marcador da parada" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="c187"><mxGeometry x="34" y="70" width="320" height="50" as="geometry"/></mxCell><mxCell id="c179" value="&lt;b&gt;adicionar_tag_se_ausente()&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="c187"><mxGeometry x="34" y="154" width="320" height="40" as="geometry"/></mxCell><mxCell id="c180" value="➕ tag_antes, se houver (ex.: 1.1)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="c187"><mxGeometry x="24" y="228" width="340" height="44" as="geometry"/></mxCell><mxCell id="c181" value="&lt;b&gt;incluir_memo()&lt;/b&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.05;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="c187"><mxGeometry x="34" y="306" width="320" height="40" as="geometry"/></mxCell><mxCell id="c182" value="📄 memo da parada no bloco" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="c187"><mxGeometry x="24" y="380" width="340" hei