ll id="c98" value="Tem 1.2.1 - Mat. N Encontradas Base APIS?&lt;br&gt;(base corrigida)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="24" y="1772" width="330" height="104" as="geometry"/></mxCell><mxCell id="c97" value="➖ 1.2.1 - Mat. N Encontradas Base APIS&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;remove e segue o fluxo (abaixo)&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="424" y="1791" width="270" height="66" as="geometry"/></mxCell><mxCell id="c100" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_avaliar_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Uso da rede própria na base DISA. Fora da base DISA = não usou&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;avaliar_uso_rede_propria_disa, registrar_uso, garantir_marcadores_no_sei&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="24" y="1904" width="330" height="98" as="geometry"/></mxCell><mxCell id="c102" value="Resposta inválida&lt;br&gt;na base DISA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="74" y="2030" width="230" height="104" as="geometry"/></mxCell><mxCell id="c101" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="424" y="2062" width="270" height="40" as="geometry"/></mxCell><mxCell id="c107" value="Alguém usou a rede própria&lt;br&gt;segundo a &lt;b&gt;base DISA&lt;/b&gt;?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="209" y="2162" width="300" height="104" as="geometry"/></mxCell><mxCell id="c104" value="➕ 1.6.2 - Base DISA: Usou RP" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="106" y="2326" width="240" height="40" as="geometry"/></mxCell><mxCell id="c105" value="➕ 1.6.2 - Base DISA: Não Usou RP" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="372" y="2326" width="240" height="50" as="geometry"/></mxCell><mxCell id="c106" value="➕ 1.6 - Avaliado Uso Rede Própria DISA&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;pulado na retomada; remove o estado anterior&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="194" y="2436" width="330" height="66" as="geometry"/></mxCell><mxCell id="c116" value="Período variável&lt;br&gt;para dependentes?&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;(nunca no modelo com período por dependente)&lt;/span&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="74" y="2530" width="230" height="152" as="geometry"/></mxCell><mxCell id="c110" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_periodo_variavel()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="424" y="2581" width="270" height="50" as="geometry"/></mxCell><mxCell id="c111" value="➕ 1.1 - Período Variável p/ Dependentes" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="424" y="2659" width="270" height="50" as="geometry"/></mxCell><mxCell id="c112" value="📄 &lt;b&gt;MemoApisPeriodoDependentes&lt;/b&gt;&lt;br&gt;no bloco 7730905" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="424" y="2737" width="270" height="50" as="geometry"/></mxCell><mxCell id="c113" value="➕ 1.7 - Aguarda APIS: Período Deps" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="424" y="2815" width="270" height="50" as="geometry"/></mxCell><mxCell id="c114" value="➖ 1.6 - Avaliado Uso Rede Própria DISA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="424" y="2893" width="270" height="50" as="geometry"/></mxCell><mxCell id="c115" value="prox_acao = Assinar memo à APIS (período dos dependentes)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="424" y="2971" width="270" height="50" as="geometry"/></mxCell><mxCell id="c123" value="▶ _avaliar_mantis_e_criar_docs() — coluna 4" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c124"><mxGeometry x="24" y="2998" width="330" height="40" as="geometry"/></mxCell><mxCell id="c217" value="&lt;b style=&quot;font-size:16px&quot;&gt;4 · _avaliar_mantis_e_criar_docs()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;MANTIS e a comparação base DISA × MANTIS, pelo processo inteiro (alguém usou). O memo à DISA depende só da rede própria (RP); a rede credenciada (RC) só separa DEPROC de APIS quando ninguém usou a RP. Cada caso tem o seu memo e o seu bloco. &lt;b&gt;Os relatórios RP e RC de quem usou entram em todos os casos&lt;/b&gt;; &lt;b&gt;quem vai para a DISA não vai para a DEPROC&lt;/b&gt;&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="2374" y="270" width="1352" height="2652" as="geometry"/></mxCell><mxCell id="c125" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;avaliar_uso_rede_propria_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Atendimentos no período do titular (no modelo com período por dependente, no de cada dependente), nas duas redes&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;interpretar_periodo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="24" y="90" width="330" height="98" as="geometry"/></mxCell><mxCell id="c127" value="Período ou data&lt;br&gt;de atendimento&lt;br&gt;inválidos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="74" y="216" width="230" height="104" as="geometry"/></mxCell><mxCell id="c126" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="424" y="248" width="270" height="40" as="geometry"/></mxCell><mxCell id="c129" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_registrar_uso_mantis() · usos_mantis_alem_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Planilha: uso nas duas redes, caso_disa_mantis e mats_uso_mantis_alem_disa (RP no MANTIS e fora da base DISA)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="24" y="348" width="330" height="98" as="geometry"/></mxCell><mxCell id="c130" value="Escolhe o memo pelo caso (abaixo) e o monta &lt;b&gt;antes de qualquer ação no SEI&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="24" y="474" width="330" height="50" as="geometry"/></mxCell><mxCell id="c132" value="Texto do memo&lt;br&gt;pendente?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="74" y="552" width="230" height="90" as="geometry"/></mxCell><mxCell id="c131" value="&lt;b&gt;TextoMemoPendente&lt;/b&gt;&lt;br&gt;nada é criado no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="424" y="572" width="270" height="50" as="geometry"/></mxCell><mxCell id="c135" value="Bloco do memo (DISA ou&lt;br&gt;APIS sem uso) não&lt;br&gt;configurado (None)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="74" y="670" width="230" height="152" as="geometry"/></mxCell><mxCell id="c134" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;&lt;br&gt;nada é criado no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c217"><mxGeometry x="424" y="721" width="270" height="50" as="geometry"/></mxCell><mxCell id="c137" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&g