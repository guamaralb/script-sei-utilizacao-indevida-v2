x="1" parent="1"><mxGeometry x="380" y="866" width="340" height="46" as="geometry"/></mxCell><mxCell id="legenda-s13" value="Conclusão do 2.1 Transformar Excel em PDF" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="866" width="300" height="46" as="geometry"/></mxCell><mxCell id="legenda-o13" value="Não implementado" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="866" width="300" height="46" as="geometry"/></mxCell><mxCell id="legenda-m14" value="➕ 2.2 - Relatório de UI Refeito" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize=12;dashed=1;dashPattern=6 4;fontColor=#555555;opacity=70;" vertex="1" parent="1"><mxGeometry x="380" y="924" width="340" height="46" as="geometry"/></mxCell><mxCell id="legenda-s14" value="Conclusão do 2.1 Refazer Relatório de UI" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="924" width="300" height="46" as="geometry"/></mxCell><mxCell id="legenda-o14" value="Não implementado (após a pesquisa)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="924" width="300" height="46" as="geometry"/></mxCell><mxCell id="legenda-n1" value="&lt;b&gt;Numeração&lt;/b&gt;&lt;br&gt;Primeiro número = ramo (1 NOVO, 2 VELHO); número após o ponto = ordem de inserção. &lt;b&gt;Mesmo número = alternativas&lt;/b&gt; (o processo recebe um ou outro).&lt;br&gt;Nomes idênticos aos do SEI (máx. 50 caracteres). Manuais: PLANILHADO, UTILIZAÇÃO INSERIDA, MANUAL, ASSINADO." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="1025" width="340" height="160" as="geometry"/></mxCell><mxCell id="legenda-n2" value="&lt;b&gt;Sequências típicas&lt;/b&gt;&lt;br&gt;NOVO normal: 1 → [1.1] → 1.2 → 1.3&lt;br&gt;NOVO corrigido: 1 → 1.3 Memos DISA e DEPROC → [1.4] → 1.2&lt;br&gt;NOVO parado: 1 → 1.2.1 e/ou 1.2.2&lt;br&gt;VELHO: 2 → 2.1 → [2.1.1/2.1.2] → 2.2" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="1025" width="320" height="160" as="geometry"/></mxCell><mxCell id="legenda-n3" value="&lt;b&gt;Blocos de assinatura&lt;/b&gt;&lt;br&gt;7697744: memos DISA e DEPROC (fluxo normal)&lt;br&gt;7707212: memo de correção&lt;br&gt;7711907: memo à APIS (matrículas não encontradas)&lt;br&gt;&lt;br&gt;&lt;b&gt;Antes de criar qualquer memo&lt;/b&gt;: garantir_marcadores_no_sei." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="1025" width="320" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
