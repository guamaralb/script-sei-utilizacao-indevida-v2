"c182"><mxGeometry x="556" y="1544" width="240" height="50" as="geometry"/></mxCell><mxCell id="c148" value="prox_acao = VELHO: assinar memo DISA&lt;br&gt;(sem DEPROC)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="556" y="1622" width="240" height="66" as="geometry"/></mxCell><mxCell id="c149" value="📎 PDF Utilização Tit./Dep. &lt;b&gt;RC&lt;/b&gt;" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="822" y="1240" width="240" height="46" as="geometry"/></mxCell><mxCell id="c150" value="📄 &lt;b&gt;MemoDeprocRedeCredenciada&lt;/b&gt; (complementar)&lt;b&gt;&lt;/b&gt;&lt;br&gt;no bloco 7697744" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="822" y="1314" width="240" height="66" as="geometry"/></mxCell><mxCell id="c151" value="➕ 1.11 - VELHO Concluído: Memo DEPROC" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="822" y="1408" width="240" height="50" as="geometry"/></mxCell><mxCell id="c152" value="➖ 1.8 - Avaliado Uso Rede Própria MANTIS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="822" y="1486" width="240" height="50" as="geometry"/></mxCell><mxCell id="c153" value="prox_acao = VELHO: assinar memo DEPROC" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="822" y="1564" width="240" height="50" as="geometry"/></mxCell><mxCell id="c154" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_finalizar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Número SEI dos memos criados (registrar_numeros_memos)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="378" y="1982" width="330" height="66" as="geometry"/></mxCell><mxCell id="c181" value="Volta para a coluna 1&lt;br&gt;(planilha de controle)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="2076" width="330" height="50" as="geometry"/></mxCell><mxCell id="c339" value="Funções usadas em vários pontos" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3560" y="230" width="500" height="34" as="geometry"/></mxCell><mxCell id="c212" value="&lt;b&gt;Marcadores&lt;/b&gt; (prefixo &quot;Script v2 - &quot;; ★ = estado: no máximo um)&lt;br&gt;1 - Tratado pelo Script&lt;br&gt;1.1 - Período Variável p/ Dependentes&lt;br&gt;1.2.1 - Mat. N Encontradas Base Geral&lt;br&gt;1.2.2 - Mat. N Encontradas Base DISA&lt;br&gt;★ 1.5 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;★ 1.5 - Aguarda APIS: Formato Inválido&lt;br&gt;★ 1.6 - Avaliado Uso Rede Própria DISA&lt;br&gt;★ 1.6.1 - Aguarda APIS: Matrículas&lt;br&gt;★ 1.7 - Aguarda APIS: Período Deps&lt;br&gt;★ 1.8 - Avaliado Uso Rede Própria MANTIS&lt;br&gt;★ 1.9 - Memo DISA Uso Rede Própria&lt;br&gt;★ 1.10 - Concluído: Memos DISA e DEPROC&lt;br&gt;★ 1.10 - Concluído: Memo DEPROC&lt;br&gt;★ 1.11 - VELHO Concluído: Memo DISA&lt;br&gt;★ 1.11 - VELHO Concluído: Memo DEPROC&lt;br&gt;&lt;i&gt;Versão anterior:&lt;br&gt;1.2 - Avaliado Se Usou Rede Própria&lt;br&gt;1.3 - Memos DISA e DEPROC no Bloco (= VELHO)&lt;br&gt;1.3 - Memo DEPROC no Bloco&lt;br&gt;1.4 - Memo Não Usou Rede no Bloco&lt;br&gt;★ 1.8.1 - Memo DISA Validar Usos MANTIS&lt;/i&gt;" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3560" y="270" width="718" height="370" as="geometry"/></mxCell><mxCell id="c187" value="&lt;b style=&quot;font-size:16px&quot;&gt;adicionar_tag()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Única forma de adicionar marcador (cada ➕ do diagrama)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="680" width="718" height="266" as="geometry"/></mxCell><mxCell id="c183" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;adicionar_marcador()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;sei_automacao" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c187"><mxGeometry x="24" y="74" width="330" height="50" as="geometry"/></mxCell><mxCell id="c185" value="É marcador de estado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c187"><mxGeometry x="74" y="152" width="230" height="90" as="geometry"/></mxCell><mxCell id="c184" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;remover_tag()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Remove os outros estados (cada ➖ do diagrama)&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;remover_marcador&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c187"><mxGeometry x="424" y="156" width="270" height="82" as="geometry"/></mxCell><mxCell id="c192" value="&lt;b style=&quot;font-size:16px&quot;&gt;adicionar_tag_se_ausente()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Informativos (1.1 - Período Variável p/ Dependentes, 1.2.1 - Mat. N Encontradas Base Geral, 1.2.2 - Mat. N Encontradas Base DISA): na retomada, não adiciona de novo&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=66;" vertex="1" parent="1"><mxGeometry x="3560" y="986" width="718" height="272" as="geometry"/></mxCell><mxCell id="c189" value="Já tem o marcador?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c192"><mxGeometry x="74" y="90" width="230" height="90" as="geometry"/></mxCell><mxCell id="c188" value="Não faz nada" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c192"><mxGeometry x="424" y="115" width="270" height="40" as="geometry"/></mxCell><mxCell id="c191" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;adicionar_tag()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c192"><mxGeometry x="24" y="208" width="330" height="40" as="geometry"/></mxCell><mxCell id="c198" value="&lt;b style=&quot;font-size:16px&quot;&gt;incluir_memo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cada 📄 do diagrama. Retomada: procura o memo pelo assunto na rodada&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="1298" width="718" height="334" as="geometry"/></mxCell><mxCell id="c193" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_memo_geacs_por_assunto()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c198"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c195" value="Já existe?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c198"><mxGeometry x="74" y="142" width="230" height="90" as="geometry"/></mxCell><mxCell id="c194" value="Não recria (coluna &amp;lt;memo&amp;gt;_na_arvore)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c198"><mxGeometry x="424" y="162" width="270" height="50" as="geometry"/></mxCell><mxCell id="c197" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;incluir_doc_sei_memo() · inserir_bloco_ass()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o memo e insere no bloco" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c198"><mxGeometry x="24" y="260" width="330" height="50" as="geometry"/></mxCell><mxCell id="c204" value="&lt;b style=&quot;font-size:16px&quot;&gt;incluir_relatorios()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cada 📎 do diagrama. Um PDF do titular e um dos dependentes, só de quem tem atendimento&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="1672" width="718" height="392" as="geometry"/></mxCell><mxCell id="c199" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_doc_por_nome()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Procura na rodada &quot;PDF Utilização Tit.|Dep. RP|RC - &amp;lt;matrícula&amp;gt;&quot;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c204"><mxGeometry x="24" y="74" width="330" height="66" as="geometry"/></mxCell><mxCell id="c201" value="Já anexado?" style="rhombus;fillColor=#fff2cc;strokeCol