;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c710" target="c715"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1134" value="Sim (e segue)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c710" target="c707"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1135" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c707" target="c708"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1136" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c708" target="c709"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1137" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c715" target="c718"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1138" value="Sim (e segue)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c715" target="c714"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1139" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c718" target="c720"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1140" value="Sim (e segue)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c718" target="c717"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1141" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c720" target="c721"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="geacs-todas-infos" name="geacs_todas_infos"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1596" pageHeight="2832" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1142" value="run_geacs_todas_infos · Retorno final à APIS com todas as informações (main_geacs_todas_infos.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c1143" value="Na unidade da GEACS, depois do retorno da DEPROC (01.10.1). Caminho pela DISA: TODO. Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c1144" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c1145" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1146" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c1147" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1148" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1149" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1150" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1151" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c1152" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1153" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c612" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_geacs_todas_infos. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1308" as="geometry"/></mxCell><mxCell id="c595" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c596" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba geacs_todas_infos de processos_a_processar.xlsx e carrega as bases APIS, DISA e MANTIS (a DEPROC, por ano, quando um processo precisa)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="142" width="330" height="114" as="geometry"/></mxCell><mxCell id="c594" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da GEACS (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="284" width="330" height="82" as="geometry"/></mxCell><mxCell id="c597" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="394" width="330" height="40" as="geometry"/></mxCell><mxCell id="c599" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="74" y="462" width="230" height="120" as="geometry"/></mxCell><mxCell id="c598" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="424" y="489" width="270" height="66" as="geometry"/></mxCell><mxCell id="c601" value="▶ processar_todas_infos() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="610" width="330" height="40" as="geometry"/></mxCell><mxCell id="c602" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="678" width="330" height="66" as="geometry"/></mxCell><mxCell id="c603" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linha do processo: script, fluxo e prox_acao; colunas memo_calculo_copa_*, ano_base_deproc_todas_infos, caminho_todas_infos, valores_todas_infos, divergencias_todas_infos e memo_apis_todas_infos_*. Os resultados do fluxo inicial ficam como estão" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="772" width="330" height="130" as="geometry"/></mxCell><mxCell id="c605" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="74" y="930" width="230" height="90" as="geometry"/></mxCell><mxCell id="c604" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="424" y="950" width="270" height="50" as="geometry"/></mxCell><mxCell id="c608" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="74" y="1048" width="230" height="90" as="geometry"/></mxCell><mxCell id="c607" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="424" y="1073" width="270" height="40" as="geometry"/></mxCell><mxCell id="c610" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="1166" width="330" height="50" as="geometry"/></mxCell><mxCell id="c611" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c612"><mxGeometry x="24" y="1244" width="330" height="40" as="geometry"/></mxCell><mxCell id="c651" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · processar_todas_infos()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Retorno final à APIS depois do retorno da DEPROC (MemoApisComTodasAsInformacoes). Cada valor é lido do SEI e recalculado das bases: se não baterem, nada é criado&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="2522" as="geometry"/></mxCell><mxCell id="c613" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_marcadores() · conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;As regras do fluxo inicial" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="90" width="330" height="50" as="geometry"/></mxCell><mxCell id="c615" value="Marcadores inconsistentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="74" y="168" width="230" height="90" as="geometry"/></mxCell><mxCell id="c614" value="&lt;b&gt;MarcadoresInconsistentes&lt;/b&gt;: prox_acao = Verificar marcadores inconsistentes, sem ação" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="180" width="270" height="66" as="geometry"/></mxCell><mxCell id="c618" value="Com o 01.12 - No Bloco APIS: Todas as Infos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="74" y="286" width="230" height="104" as="geometry"/></mxCell><mxCell id="c617" value="prox_acao = Assinar memo à APIS (todas as informações) e encaminhar" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="313" width="270" height="50" as="geometry"/></mxCell><mxCell id="c621" value="Com o 01.12.1 - Encaminhado APIS: Todas as Infos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="74" y="418" width="230" height="104" as="geometry"/></mxCell><mxCell id="c620" value="prox_acao = Memo à APIS (todas as informações) encaminhado (concluído)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="445" width="270" height="50" as="geometry"/></mxCell><mxCell id="c624" value="Sem o 01.10.B.1 - Aguarda DEPROC: Coparticipação?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="74" y="550" width="230" height="104" as="geometry"/></mxCell><mxCell id="c623" value="&lt;b&gt;SemAguardaDeproc&lt;/b&gt;: sem ação" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="582" width="270" height="40" as="geometry"/></mxCell><mxCell id="c626" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;base_deproc_da_planilha()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Ano e data das colunas ano_base_deproc e data_geracao_base_deproc da planilha de controle (gravadas pelo deproc_calcula_copa). Só com uma das duas: a única base da pasta com esse valor. Carrega essa base (BaseDeproc)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="682" width="330" height="114" as="geometry"/></mxCell><mxCell id="c628" value="Sem a base&lt;br&gt;(ou fora da pasta)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="74" y="824" width="230" height="104" as="geometry"/></mxCell><mxCell id="c627" value="&lt;b&gt;SemAnoBaseDeproc&lt;/b&gt;: sem ação" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="856" width="270" height="40" as="geometry"/></mxCell><mxCell id="c631" value="Sem Incluir Documento&lt;br&gt;(fechado no setor)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="74" y="956" width="230" height="120" as="geometry"/></mxCell><mxCell id="c630" value="&lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;: não reabre, nada é criado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="991" width="270" height="50" as="geometry"/></mxCell><mxCell id="c633" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;O 01.12 cadastrado na GEACS" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="1104" width="330" height="50" as="geometry"/></mxCell><mxCell id="c634" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Último memo da APIS destinado à GEACS: define a rodada" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="1182" width="330" height="66" as="geometry"/></mxCell><mxCell id="c635" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;memo_calculo_copa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;MemoGeacsCalculoCopa da DEPROC na rodada (pelo assunto), com &quot;assinado eletronicamente por&quot;. Sem ele ou sem assinatura: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="1276" width="330" height="82" as="geometry"/></mxCell><mxCell id="c636" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;identificar_caminho()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memo da GEACS à DISA (um dos 3 assuntos) na rodada?" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="1386" width="330" height="66" as="geometry"/></mxCell><mxCell id="c639" value="Passou pela DISA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="74" y="1480" width="230" height="90" as="geometry"/></mxCell><mxCell id="c637" value="Sem documento da IPSEMG/DISA depois do memo: &lt;b&gt;RespostaDisaPendente&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="1500" width="270" height="50" as="geometry"/></mxCell><mxCell id="c638" value="Com resposta: &lt;b&gt;LeituraDisaNaoImplementada&lt;/b&gt; (TODO: ler a rede própria da resposta da DISA)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="1578" width="270" height="66" as="geometry"/></mxCell><mxCell id="c642" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;apurar_todas_infos()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Coparticipação: tabela do memo da DEPROC (por matrícula, total e Valor total em aberto; sem essa linha, em aberto = total apurado) x base DEPROC do ano (apurar_coparticipacao). RC/RP: TOTAL de cada PDF do MANTIS da rodada (baixado e lido com pypdf) x bases do MANTIS no período. Uso da RP sem DISA, PDF faltando ou sobrando: divergência&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;ler_coparticipacao_do_memo() · recalcular_mantis() · baixar_pdf() · total_do_pdf()&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="1652" width="330" height="210" as="geometry"/></mxCell><mxCell id="c644" value="Algum valor diverge?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="74" y="1890" width="230" height="90" as="geometry"/></mxCell><mxCell id="c643" value="&lt;b&gt;ValoresDivergentes&lt;/b&gt;: coluna divergencias_todas_infos, nada é criado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="424" y="1910" width="270" height="50" as="geometry"/></mxCell><mxCell id="c646" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;montar_beneficiarios()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Titular e dependentes: iniciais / matrícula, RC, RP, coparticipação &lt;b&gt;em aberto&lt;/b&gt; (o já descontado em folha não é somado) e o PDF de cada rede. Detalhamento da coparticipação: relatório da DEPROC (sem coparticipação: o memo da DEPROC)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="2008" width="330" height="130" as="geometry"/></mxCell><mxCell id="c647" value="📄 &lt;b&gt;MemoApisComTodasAsInformacoes&lt;/b&gt;&lt;br&gt;no bloco 7768786" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="2166" width="330" height="50" as="geometry"/></mxCell><mxCell id="c648" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;incluir_memo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Retomada: memo já na rodada (pelo assunto) não é recriado" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="2244" width="330" height="66" as="geometry"/></mxCell><mxCell id="c649" value="➕ v2: 01.12 - No Bloco APIS: Todas as Infos (↻ remove o 01.10.1)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="2338" width="330" height="50" as="geometry"/></mxCell><mxCell id="c650" value="prox_acao = Assinar memo à APIS (todas as informações) e encaminhar. Depois da assinatura, manual: ➕ 01.12.1 - Encaminhado APIS: Todas as Infos, ➖ 01.12" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c651"><mxGeometry x="24" y="2416" width="330" height="82" as="geometry"/></mxCell><mxCell id="c1154" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c596" target="c594"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1155" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c594" target="c597"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1156" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c597" target="c599"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1157" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c599" target="c601"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell