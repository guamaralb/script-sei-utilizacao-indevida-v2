Dx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;fontColor=#2e7d32;" edge="1" parent="1" source="normal-q9" target="normal-t9a"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="normal-e24" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;fontColor=#c62828;" edge="1" parent="1" source="normal-q9" target="normal-t9b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="normal-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="normal-t9a" target="normal-a10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="1940"/></Array></mxGeometry></mxCell><mxCell id="normal-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="normal-t9b" target="normal-a10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="normal-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="normal-a10" target="normal-f10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="normal-n1" value='&lt;b&gt;Invariante: marcadores de conclusão só depois dos memos no bloco&lt;/b&gt;&lt;br&gt;Ordem: memos → ➕1.2 → ➕1.3. Se o script falhar no meio, o processo fica com 1 e com memos da GEACS; na próxima execução ele cai em "Erro: memos sem marcador de conclusão" em vez de duplicar memos.' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="1495" width="260" height="190" as="geometry"/></mxCell><mxCell id="normal-n2" value="&lt;b&gt;Erros de avaliar_uso&lt;/b&gt; (ErroAvaliacao):&lt;br&gt;- resposta inválida na base (nem SIM nem NÃO);&lt;br&gt;- dependentes citados sem matrícula (AVERIGUAR, modelo velho);&lt;br&gt;- matrícula em formato inválido;&lt;br&gt;- sem matrícula de titular.&lt;br&gt;Matrícula repetida: um SIM prevalece." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="615" width="260" height="170" as="geometry"/></mxCell><mxCell id="normal-n3" value="&lt;b&gt;Memo DISA só existe se alguém usou&lt;/b&gt; (MemoDisa levanta ValueError se ninguém usou). A DEPROC recebe &lt;b&gt;sempre&lt;/b&gt; todos os beneficiários." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="1365" width="260" height="110" as="geometry"/></mxCell><mxCell id="normal-n4" value="&lt;b&gt;Os períodos não entram na consulta&lt;/b&gt; da rede própria; só vão para a planilha de controle." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="380" width="260" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="correcao" name="4. Rotina de correção"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="correcao-tit" value="4. Rotina de correção (correcao_rede_propria.corrigir_uso_rede_propria)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="-20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="correcao-ini" value="Entrada: NOVO com &lt;b&gt;1.3 Memos DISA e DEPROC&lt;/b&gt;&lt;br&gt;no Bloco e &lt;b&gt;sem 1.2&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="40" width="320" height="60" as="geometry"/></mxCell><mxCell id="correcao-q1" value="Tem &lt;b&gt;1.4&lt;/b&gt;?&lt;br&gt;(retomada)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="135" width="220" height="110" as="geometry"/></mxCell><mxCell id="correcao-a1" value="Confere o memo de correção&lt;br&gt;na árvore (pelo assunto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="160" width="260" height="60" as="geometry"/></mxCell><mxCell id="correcao-e1" value="Erro: 1.4 presente, mas memo&lt;br&gt;não está na árvore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="155" width="280" height="70" as="geometry"/></mxCell><mxCell id="correcao-a1b" value="Reabre o processo na unidade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="260" width="260" height="60" as="geometry"/></mxCell><mxCell id="correcao-t1" value="➕ 1.2 - Avaliado Se Usou Rede Própria" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.08;fixedSize=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;fontSize