8"><mxGeometry x="24" y="2052" width="330" height="50" as="geometry"/></mxCell><mxCell id="c377" value="Funções usadas em vários pontos" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3560" y="230" width="500" height="34" as="geometry"/></mxCell><mxCell id="c235" value="&lt;b&gt;Marcadores&lt;/b&gt; (prefixo &quot;Script v2 - &quot;; ★ = estado: no máximo um; ◆ = par: no máximo um de cada)&lt;br&gt;0 - Processo VELHO&lt;br&gt;1 - Tratado pelo Script&lt;br&gt;1.1 - Período Variável p/ Dependentes&lt;br&gt;1.2.1 - Mat. N Encontradas Base APIS&lt;br&gt;★ 1.5 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;★ 1.5 - Aguarda APIS: Formato Inválido&lt;br&gt;★ 1.6 - Avaliado Uso Rede Própria DISA&lt;br&gt;★ 1.6.1 - Aguarda APIS: Matrículas&lt;br&gt;◆ 1.6.2 - Base DISA: Usou RP&lt;br&gt;◆ 1.6.2 - Base DISA: Não Usou RP&lt;br&gt;★ 1.7 - Aguarda APIS: Período Deps&lt;br&gt;★ 1.8 - Avaliado Uso Rede Própria MANTIS&lt;br&gt;◆ 1.8.2 - MANTIS: Usou RP&lt;br&gt;◆ 1.8.2 - MANTIS: Não Usou RP&lt;br&gt;★ 1.9 - Aguarda DISA: Validar (Consta)&lt;br&gt;★ 1.9 - Aguarda DISA: Validar (N Consta)&lt;br&gt;★ 1.9 - Aguarda DISA: Relatório&lt;br&gt;★ 1.10 - Concluído: Memo DEPROC&lt;br&gt;&lt;i&gt;Versão anterior:&lt;br&gt;1.2 - Avaliado Se Usou Rede Própria&lt;br&gt;1.2.2 - Mat. N Encontradas Base DISA&lt;br&gt;1.3 - Memos DISA e DEPROC no Bloco (= VELHO)&lt;br&gt;1.3 - Memo DEPROC no Bloco&lt;br&gt;1.4 - Memo Não Usou Rede no Bloco&lt;br&gt;★ 1.8.1 - Memo DISA Validar Usos MANTIS&lt;br&gt;★ 1.9 - Memo DISA Uso Rede Própria&lt;br&gt;★ 1.10 - Concluído: Memos DISA e DEPROC&lt;br&gt;★ 1.11 - VELHO Concluído: Memo DISA&lt;br&gt;★ 1.11 - VELHO Concluído: Memo DEPROC&lt;/i&gt;" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3560" y="270" width="718" height="498" as="geometry"/></mxCell><mxCell id="c205" value="&lt;b style=&quot;font-size:16px&quot;&gt;_separar_velho()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Processo VELHO&lt;/b&gt; (enviado à DISA e à DEPROC antes da avaliação): marcado e &lt;b&gt;não processado&lt;/b&gt;. TODO: definir o fluxo do VELHO&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=66;" vertex="1" parent="1"><mxGeometry x="3560" y="808" width="718" height="428" as="geometry"/></mxCell><mxCell id="c200" value="Tem MANUAL&lt;br&gt;ou ASSINADO?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c205"><mxGeometry x="74" y="90" width="230" height="90" as="geometry"/></mxCell><mxCell id="c199" value="prox_acao = Fora do escopo (tratado manualmente)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c205"><mxGeometry x="424" y="110" width="270" height="50" as="geometry"/></mxCell><mxCell id="c202" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c205"><mxGeometry x="24" y="208" width="330" height="40" as="geometry"/></mxCell><mxCell id="c203" value="➕ 0 - Processo VELHO&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se ainda não tiver&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c205"><mxGeometry x="24" y="276" width="330" height="50" as="geometry"/></mxCell><mxCell id="c204" value="prox_acao = VELHO: não processado (fluxo ainda não definido)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c205"><mxGeometry x="24" y="354" width="330" height="50" as="geometry"/></mxCell><mxCell id="c210" value="&lt;b style=&quot;font-size:16px&quot;&gt;adicionar_tag()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Única forma de adicionar marcador (cada ➕ do diagrama)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="1276" width="718" height="312" as="geometry"/></mxCell><mxCell id="c206" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;adicionar_marcador()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;sei_automacao" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c210"><mxGeometry x="24" y="74" width="330" height="50" as="geometry"/></mxCell><mxCell id="c208" value="É de um grupo de&lt;br&gt;alternativos? (estado ★&lt;br&gt;ou par 1.6.2 / 1.8.2)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c210"><mxGeometry x="74" y="152" width="230" height="136" as="geometry"/></mxCell><mxCell id="c207" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;remover_tag()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Remove o outro do grupo (cada ➖ do diagrama)&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;remover_marcador&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c210"><mxGeometry x="424" y="179" width="270" height="82" as="geometry"/></mxCell><mxCell id="c215" value="&lt;b style=&quot;font-size:16px&quot;&gt;adicionar_tag_se_ausente()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Retomada: 0 - Processo VELHO, 1.1 - Período Variável p/ Dependentes e 1.2.1 - Mat. N Encontradas Base APIS não são adicionados de novo&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=66;" vertex="1" parent="1"><mxGeometry x="3560" y="1628" width="718" height="272" as="geometry"/></mxCell><mxCell id="c212" value="Já tem o marcador?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c215"><mxGeometry x="74" y="90" width="230" height="90" as="geometry"/></mxCell><mxCell id="c211" value="Não faz nada" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c215"><mxGeometry x="424" y="115" width="270" height="40" as="geometry"/></mxCell><mxCell id="c214" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;adicionar_tag()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c215"><mxGeometry x="24" y="208" width="330" height="40" as="geometry"/></mxCell><mxCell id="c221" value="&lt;b style=&quot;font-size:16px&quot;&gt;incluir_memo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cada 📄 do diagrama. Retomada: procura o memo pelo assunto na rodada&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="1940" width="718" height="334" as="geometry"/></mxCell><mxCell id="c216" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_memo_geacs_por_assunto()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c221"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c218" value="Já existe?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c221"><mxGeometry x="74" y="142" width="230" height="90" as="geometry"/></mxCell><mxCell id="c217" value="Não recria (coluna &amp;lt;memo&amp;gt;_na_arvore)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c221"><mxGeometry x="424" y="162" width="270" height="50" as="geometry"/></mxCell><mxCell id="c220" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;incluir_doc_sei_memo() · inserir_bloco_ass()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o memo e insere no bloco" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c221"><mxGeometry x="24" y="260" width="330" height="50" as="geometry"/></mxCell><mxCell id="c227" value="&lt;b style=&quot;font-size:16px&quot;&gt;incluir_relatorios()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cada 📎 do diagrama. Um PDF do titular e um dos dependentes, só de quem tem atendimento&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="2314" width="718" height="392" as="geometry"/></mxCell><mxCell id="c222" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_doc_por_nome()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Procura na rodada &quot;PDF Utilização Tit.|Dep. RP|RC - &amp;lt;matrícula&amp;gt;&quot;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="24" y="74" width="330" height="66" as="geometry"/></mxCell><mxCell id="c224" value="Já anexado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="74" y="168" width="230" height="90" as="geometry"/></mxCell><mxCell id="c223" value="Não anexa de novo" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="424" y="193" width="270" height="40" as="geometry"/></mxCell><mxCell id="c226" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;transformar_xls_em_pdf() · incluir_doc_externo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Gera o PDF e anexa: tipo PDF, Nato-digital, Restrito" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c227"><mxGeometry x="24" y="286" width="330" height="82" as="geometry"/></mxCell><mxCell id="c232" value="&lt;b style=&quot;font-size:16px&quot;&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Antes de criar memos e relatórios&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="2746" width="718" height="298" as="geometry"/></mxCell><mxCell id="c228" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_ler_marcadores_da_unidade()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Tela Gerenciar Marcador, sem salvar (uma vez por execução; relida uma vez se faltar algum nome)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c232"><mxGeometry x="24" y="74" width="330" height="82" as="geometry"/></mxCell><mxCell id="c230" value="Falta marcador&lt;br&gt;no SEI?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c232"><mxGeometry x="74" y="184" width="230" height="90" as="geometry"/></mxCell><mxCell id="c229" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: nada é criado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c232"><mxGeometry x="424" y="209" width="270" height="40" as="geometry"/></mxCell><mxCell id="c234" value="&lt;b style=&quot;font-size:16px&quot;&gt;_parar_com_memo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Paradas com memo à APIS e à DISA: confere o bloco → [➕ marcador anterior] → 📄 memo → ➕ marcador da parada → _finalizar()&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=82;" vertex="1" parent="1"><mxGeometry x="3560" y="3084" width="378" height="180" as="geometry"/></mxCell><mxCell id="c233" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei() · incluir_memo() · adicionar_tag()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c234"><mxGeometry x="24" y="106" width="330" height="50" as="geometry"/></mxCell><mxCell id="c259" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c260" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c261" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11;fontStyle=1;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1"