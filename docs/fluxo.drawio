c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c184"><mxGeometry x="24" y="74" width="330" height="50" as="geometry"/></mxCell><mxCell id="c182" value="É marcador de estado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c184"><mxGeometry x="74" y="152" width="230" height="90" as="geometry"/></mxCell><mxCell id="c181" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;remover_tag()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Remove os outros estados (cada ➖ do diagrama)&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;remover_marcador&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c184"><mxGeometry x="424" y="156" width="270" height="82" as="geometry"/></mxCell><mxCell id="c189" value="&lt;b style=&quot;font-size:16px&quot;&gt;adicionar_tag_se_ausente()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Informativos (1.1, 1.2.1, 1.2.2): na retomada, não adiciona de novo&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="576" width="718" height="256" as="geometry"/></mxCell><mxCell id="c186" value="Já tem o marcador?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c189"><mxGeometry x="74" y="74" width="230" height="90" as="geometry"/></mxCell><mxCell id="c185" value="Não faz nada" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c189"><mxGeometry x="424" y="99" width="270" height="40" as="geometry"/></mxCell><mxCell id="c188" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;adicionar_tag()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c189"><mxGeometry x="24" y="192" width="330" height="40" as="geometry"/></mxCell><mxCell id="c195" value="&lt;b style=&quot;font-size:16px&quot;&gt;incluir_memo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cada 📄 do diagrama. Retomada: procura o memo pelo assunto na rodada&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3560" y="872" width="718" height="334" as="geometry"/></mxCell><mxCell id="c190" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_memo_geacs_por_assunto()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c195"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c192" value="Já existe?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c195"><mxGeometry x="74" y="142" width="230" height="90" as="geometry"/></mxCell><mxCell id="c191" value="Não recria (coluna &amp;lt;memo&amp;gt;_na_arvore)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c195"><mxGeometry x="424" y="162" width="270" height="50" as="geometry"/></mxCell><mxCell id="c194" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;incluir_doc_sei_memo() · inserir_bloco_ass()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o memo e insere no bloco" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c195"><mxGeometry x="24" y="260" width="330" height="50" as="geometry"/></mxCell><mxCell id="c201" value="&lt;b styl