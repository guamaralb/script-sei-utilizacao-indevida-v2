        <mxCell id="s-q14" value="Tem 1.4 - Memo Não Usou Rede no Bloco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="s-c-aval"><mxGeometry x="800" y="536" width="360" height="102" as="geometry" /></mxCell>
        <mxCell id="s-a14-arv" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;_listar_arvore&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Registro: qnt_memos_geacs_na_arvore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="s-c-aval"><mxGeometry x="1200" y="536" width="360" height="58" as="geometry" /></mxCell>
        <mxCell id="s-c14-verif" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;verificar_memo_uso_rede&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;correcao_rede_propria.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="s-c-aval"><mxGeometry x="1200" y="630" width="360" height="152" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Detalhado na aba 4&lt;/b&gt; →&lt;br&gt;Confere o memo de correção na árvore (pelo assunto); não achou: erro" link="data:page/id,correcao" id="s-c14-verif-lk"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="s-c14-verif"><mxGeometry x="20" y="58" width="320" height="74" as="geometry" /></mxCell></UserObject>
        <mxCell id="s-f14" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = Assinar memo de uso da rede própria e encaminhar" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="s-c-aval"><mxGeometry x="1200" y="818" width="360" height="58" as="geometry" /></mxCell>
        <mxCell id="s-f-nada" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = Nada a fazer" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="s-c-aval"><mxGeometry x="800" y="674" width="360" height="50" as="geometry" /></mxCell>
        <mxCell id="s-q-13" value="Tem 1.3 - Memos DISA e DEPROC no Bloco?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="s-c-aval"><mxGeometry x="320" y="890" width="440" height="102" as="geometry" /></mxCell>
        <mxCell id="s-f-fora" value="&lt;b&gt;Fim&lt;/b&gt;: prox_acao = Fora do escopo (não se enquadra na correção)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="s-c-aval"><mxGeometry x="800" y="912" width="360" height="58" as="geometry" /></mxCell>
        <mxCell id="s-a-arv" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;_listar_arvore&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Lista a árvore&lt;br&gt;Registro: qnt_memos_geacs_na_arvore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="s-c-aval"><mxGeometry x="320" y="1028" width="440" height="74" as="geometry" /></mxCell>
        <mxCell id="s-c-corr" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;corrigir_uso_rede_propria&lt;/b&gt;&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot; color=&quot;#333333&quot;&gt;correcao_rede_propria.py&lt;/font&gt;" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=14;fontStyle=0;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="s-c-aval"><mxGeometry x="320" y="1138" width="440" height="152" as="geometry" /></mxCell>
        <UserObject label="&lt;b&gt;Detalhado na aba 4&lt;/b&gt; →&lt;br&gt;Rotina de correção com as matrículas da planilha (matricula_titular, matriculas_dependentes)" link="data:page/id,correcao" id="s-c-corr-lk"><mxCell style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.06;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="s-c-corr"><mxGeometry x="20" y="58" width="400" height="74" as="geometry" /></mxCell></UserObject>
        <mxCell id="s-err-exc" value="&lt;b&gt;except&lt;/b&gt; (qualquer etapa acima): &lt;b&gt;registrar_erro&lt;/b&gt;(registro, e) preenche tipo_erro e erro.&lt;br&gt;ErroAvaliacao: sem traceback. Outras: logger.exception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="s-c-linha"><mxGeometry x="590" y="1404" width="440" height="74" as="geometry" /></mxCell>
        <mxCell id="s-a-fimproc" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;log_fim_processo&lt;/font&gt;&lt;/b&gt;&lt;br&gt;registro.to_dict() vira uma linha da planilha de controle; segue para o próximo processo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="s-c-main"><mxGeometry x="610" y="2058" width="440" height="74" as="geometry" /></mxCell>
        <mxCell id="s-nota0" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;• Moldura = &lt;b&gt;função&lt;/b&gt; (nome e módulo no topo); caixas dentro = passos na ordem em que o código executa. Funções chamadas aparecem como molduras aninhadas.&lt;br&gt;• Azul: ação · Amarelo: pergunta · Roxo: memo criado e inserido no bloco · Verde: ➕ marcador · Vermelho: erro · Cinza: início/fim · Laranja: detalhado em outra aba (clique).&lt;br&gt;• Erros à esquerda; desvios que param o processo ou seguem outro caminho, à direita. Tracejado: previsto (não implementado).&lt;br&gt;• Legenda completa e tabela de marcadores: aba 8." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="0" width="560" height="170" as="geometry" /></mxCell>
        <mxCell id="s-nota1" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Prefixo &quot;Script v2 - &quot; em todos (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres. Aqui os marcadores aparecem sem o prefixo." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="194" width="560" height="80" as="geometry" /></mxCell>
        <mxCell id="s-nota2" value="&lt;b&gt;Objetivo&lt;/b&gt;&lt;br&gt;Corrigir os NOVOS encaminhados à DISA e à DEPROC &lt;b&gt;sem&lt;/b&gt; avaliação do uso da rede própria. Nenhum marcador é adicionado na triagem (_avaliar_processo): só a rotina de correção (aba 4) adiciona." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="298" width="560" height="90" as="geometry" /></mxCell>
        <mxCell id="s-nota3" value="&lt;b&gt;Os dois main nunca se importam&lt;/b&gt;: a rotina de correção fica em correcao_rede_propria.py e é usada pelos dois scripts." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="412" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="s-nota4" value="&lt;b&gt;Pendente&lt;/b&gt;: este script ainda trata 1.2.2 como processo parado (no fluxo normal atual, 1.2.2 não para o processo)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="496" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="s-nota5" value="&lt;b&gt;Erros&lt;/b&gt;&lt;br&gt;Todo erro sobe até _processar_linha: registrar_erro preenche tipo_erro, erro e, se preciso, prox_acao = Verificar erro. ErroAvaliacao, FormatoMemorandoInvalido e TextoMemoPendente são logados sem traceback; falha inesperada, com logger.exception. &lt;b&gt;Um erro nunca interrompe os demais processos.&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="-620" y="580" width="560" height="110" as="geometry" /></mxCell>
        <mxCell id="s-e1" edge="1" parent="1" source="s-ini" target="s-c-main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3879;entryY=0;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry" /></mxCell>
