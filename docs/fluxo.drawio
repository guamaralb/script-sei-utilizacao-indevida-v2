<mxfile host="app.diagrams.net" type="device"><diagram id="fluxo-completo" name="Fluxo completo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4318" pageHeight="3012" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c223" value="Fluxo do script SEI - Utilização Indevida (v2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="44" as="geometry"/></mxCell><mxCell id="c224" value="Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1200" height="28" as="geometry"/></mxCell><mxCell id="c213" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c214" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c215" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c216" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c217" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c218" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c219" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c220" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c221" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c222" value="&lt;b&gt;Pendências (TODO)&lt;/b&gt;&lt;br&gt;• remover_marcador na sei_automacao (sem ele o main não inicia)&lt;br&gt;• no SEI: editar os marcadores renomeados (1 - Tratado pelo Script, 1.5 - Aguarda APIS: Sem Memo p/ GEACS, 1.5 - Aguarda APIS: Formato Inválido, 1.6.1 - Aguarda APIS: Matrículas, 1.7 - Aguarda APIS: Período Deps, 1.10 - Concluído: Memo DEPROC) e cadastrar 1.10 - Concluído: Memos DISA e DEPROC, 1.11 - VELHO Concluído: Memo DISA e 1.11 - VELHO Concluído: Memo DEPROC&lt;br&gt;• revisar os textos dos memos com TEXTO_DEFINIDO = False&lt;br&gt;• tratar a resposta dos processos parados e dos VELHOS que aguardam a DISA" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1960" y="100" width="460" height="194" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Carrega as bases, faz login e passa cada processo pelo fluxo. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1392" as="geometry"/></mxCell><mxCell id="c10" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="90" width="330" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria as pastas e o log da execução" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="158" width="330" height="50" as="geometry"/></mxCell><mxCell id="c13" value="remover_marcador existe&lt;br&gt;na sei_automacao?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="74" y="236" width="230" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;SystemExit&lt;/b&gt;: execução não iniciada&lt;br&gt;(TODO na sei_automacao)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="424" y="271" width="270" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;carregar_bases() · carregar_bases_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê processos_nao_processados.xlsx, a base DISA, a base geral e o MANTIS (rede própria e credenciada)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="384" width="330" height="82" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle e faz login no SEI" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="494" width="330" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="572" width="330" height="40" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_processar_linha()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Abre o processo e lê a árvore e os marcadores do SEI&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;acessar_processo, registrar_arvore, registrar_tags&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="640" width="330" height="98" as="geometry"/></mxCell><mxCell id="c19" value="▶ _tratar() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="766" width="330" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;De novo, no fim da passagem (se não houve erro)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="834" width="330" height="66" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Erro levantado em qualquer coluna?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;: tipo_erro, erro e prox_acao = Verificar erro (ou a já definida). Inesperado: + traceback" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="928" width="330" height="82" as="geometry"/></mxCell><mxCell id="c22" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Regrava a planilha de controle (abas processos e historico) depois de cada processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="1038" width="330" height="66" as="geometry"/></mxCell><mxCell id="c24" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="74" y="1132" width="230" height="90" as="geometry"/></mxCell><mxCell id="c23" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="424" y="1157" width="270" height="40" as="geometry"/></mxCell><mxCell id="c26" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="1250" width="330" height="50" as="geometry"/></mxCell><mxCell id="c27" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="1328" width="330" height="40" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · _tratar()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Roteamento pelos marcadores lidos do SEI. Só adiciona o marcador 1; o resto é decidido em processar_novo()&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="1822" as="geometry"/></mxCell><mxCell id="c29" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A combinação de marcadores é possível no fluxo?&lt;br&gt;• no máximo um marcador de estado (★)&lt;br&gt;• informativo só com estado compatível&lt;br&gt;• 1.6.1 - Aguarda APIS: Matrículas exige 1.2.1 - Mat. N Encontradas Base Geral&lt;br&gt;• 1.7 - Aguarda APIS: Período Deps exige 1.1 - Período Variável p/ Dependentes&lt;br&gt;• 1.11 - VELHO Concluído: Memo DISA e 1.11 - VELHO Concluído: Memo DEPROC exigem 1.3 - Memos DISA e DEPROC no Bloco&lt;br&gt;• VELHO sem 1.9 - Memo DISA Uso Rede Própria, 1.10 - Concluído: Memos DISA e DEPROC e 1.10 - Concluído: Memo DEPROC…" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="24" y="90" width="330" height="258" as="geometry"/></mxCell><mxCell id="c31" value="Marcadores&lt;br&gt;inconsistentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="74" y="376" width="230" height="90" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;MarcadoresInconsistentes&lt;/b&gt;: nada é feito no SEI&lt;br&gt;prox_acao = Verificar marcadores (corrigir no SEI)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="424" y="380" width="270" height="82" as="geometry"/></mxCell><mxCell id="c35" value="Sem o marcador&lt;br&gt;&lt;b&gt;1 - Tratado pelo Script&lt;/b&gt;?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="74" y="494" width="230" height="104" as="geometry"/></mxCell><mxCell id="c33" value="➕ 1 - Tratado pelo Script" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="424" y="526" width="270" height="40" as="geometry"/></mxCell><mxCell id="c34" value="▶ processar_novo() do início — coluna 3" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="424" y="594" width="270" height="50" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;VELHO&lt;/b&gt; = tem &lt;b&gt;1.3 - Memos DISA e DEPROC no Bloco&lt;/b&gt; (já enviado à DISA e à DEPROC)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;estado_atual()&lt;/font&gt;: marcador de estado do processo" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="24" y="640" width="330" height="82" as="geometry"/></mxCell><mxCell id="c40" value="Estado de parada?&lt;br&gt;1.5 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;1.5 - Aguarda APIS: Formato Inválido&lt;br&gt;1.6.1 - Aguarda APIS: Matrículas&lt;br&gt;1.7 - Aguarda APIS: Período Deps&lt;br&gt;1.8.1 - Memo DISA Validar Usos MANTIS" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="24" y="750" width="330" height="232" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Erro&lt;/b&gt;: parado aguardando resposta ao memo&lt;br&gt;prox_acao = Aguardar resposta ao memo enviado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="424" y="825" width="270" height="82" as="geometry"/></mxCell><mxCell id="c43" value="Estado de conclusão?&lt;br&gt;1.10 - Concluído: Memos DISA e DEPROC&lt;br&gt;1.10 - Concluído: Memo DEPROC&lt;br&gt;1.11 - VELHO Concluído: Memo DISA&lt;br&gt;1.11 - VELHO Concluído: Memo DEPROC" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="24" y="1010" width="330" height="200" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Concluído&lt;/b&gt;, prox_acao:&lt;br&gt;1.10 - Concluído: Memos DISA e DEPROC → assinar os dois&lt;br&gt;1.10 - Concluído: Memo DEPROC → assinar DEPROC&lt;br&gt;1.11 - VELHO Concluído: Memo DISA → VELHO: assinar memo DISA&lt;br&gt;1.11 - VELHO Concluído: Memo DEPROC → VELHO: assinar memo DEPROC" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="424" y="1029" width="270" height="162" as="geometry"/></mxCell><mxCell id="c46" value="VELHO com MANUAL&lt;br&gt;ou ASSINADO?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="74" y="1238" width="230" height="90" as="geometry"/></mxCell><mxCell id="c45" value="prox_acao = Fora do escopo (tratado manualmente)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="424" y="1258" width="270" height="50" as="geometry"/></mxCell><mxCell id="c49" value="NOVO sem estado com&lt;br&gt;1.3 - Memo DEPROC no Bloco?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="74" y="1356" width="230" height="120" as="geometry"/></mxCell><mxCell id="c48" value="Concluído na versão anterior&lt;br&gt;prox_acao = Assinar memo DEPROC" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="424" y="1391" width="270" height="50" as="geometry"/></mxCell><mxCell id="c52" value="NOVO sem estado com&lt;br&gt;1.2.1 - Mat. N Encontradas Base Geral ou 1.2.2 - Mat. N Encontradas Base DISA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="74" y="1504" width="230" height="168" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Erro&lt;/b&gt;: parado pela versão anterior&lt;br&gt;prox_acao = Verificar matrículas não encontradas" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="424" y="1555" width="270" height="66" as="geometry"/></mxCell><mxCell id="c54" value="▶ processar_novo() — coluna 3&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;do início ou retomando de 1.6 - Avaliado Uso Rede Própria DISA, 1.8 - Avaliado Uso Rede Própria MANTIS ou 1.9 - Memo DISA Uso Rede Própria&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="24" y="1700" width="330" height="98" as="geometry"/></mxCell><mxCell id="c116" value="&lt;b style=&quot;font-size:16px&quot;&gt;3 · processar_novo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Memo da APIS, base geral e base DISA, e as paradas com memo à APIS. Na retomada, as etapas já feitas são puladas (_etapa_feita)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="1596" y="270" width="718" height="2702" as="geometry"/></mxCell><mxCell id="c56" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Usa o &lt;b&gt;último&lt;/b&gt; memo da APIS destinado à GEACS; os documentos depois dele são a rodada&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;obter_memos_apis_para_geacs, validar_template, extrair_dados_ui&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="24" y="90" width="330" height="98" as="geometry"/></mxCell><mxCell id="c62" value="Nenhum memo da APIS&lt;br&gt;para a GEACS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="74" y="216" width="230" height="104" as="geometry"/></mxCell><mxCell id="c57" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_sem_memo_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="243" width="270" height="50" as="geometry"/></mxCell><mxCell id="c58" value="📄 &lt;b&gt;MemoApisSemMemo&lt;/b&gt;&lt;br&gt;no bloco 7730344" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="321" width="270" height="50" as="geometry"/></mxCell><mxCell id="c59" value="➕ 1.5 - Aguarda APIS: Sem Memo p/ GEACS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="399" width="270" height="50" as="geometry"/></mxCell><mxCell id="c60" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="477" width="270" height="40" as="geometry"/></mxCell><mxCell id="c61" value="prox_acao = Assinar memo à APIS (sem memorando)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="545" width="270" height="50" as="geometry"/></mxCell><mxCell id="c73" value="Formato inválido?&lt;br&gt;(não é novo_novo)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="74" y="596" width="230" height="120" as="geometry"/></mxCell><mxCell id="c68" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_formato_invalido()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="631" width="270" height="50" as="geometry"/></mxCell><mxCell id="c69" value="📄 &lt;b&gt;MemoApisFormatoInvalido&lt;/b&gt;&lt;br&gt;no bloco 7730341" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="709" width="270" height="50" as="geometry"/></mxCell><mxCell id="c70" value="➕ 1.5 - Aguarda APIS: Formato Inválido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="787" width="270" height="50" as="geometry"/></mxCell><mxCell id="c71" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="865" width="270" height="40" as="geometry"/></mxCell><mxCell id="c72" value="prox_acao = Assinar memo à APIS (formato inválido)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="933" width="270" height="50" as="geometry"/></mxCell><mxCell id="c79" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_avaliar_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Procura titular e dependentes na base geral e na base DISA. Confere no SEI os marcadores desta etapa e, se faltou na base geral, também 1.2.1 - Mat. N Encontradas Base Geral e 1.6.1 - Aguarda APIS: Matrículas&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;avaliar_uso_rede_propria_disa, registrar_uso, garantir_marcadores_no_sei&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="24" y="976" width="330" height="146" as="geometry"/></mxCell><mxCell id="c81" value="Matrícula inválida ou&lt;br&gt;resposta inválida na&lt;br&gt;base DISA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="74" y="1150" width="230" height="136" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="1198" width="270" height="40" as="geometry"/></mxCell><mxCell id="c83" value="➕ 1.2.2 - Mat. N Encontradas Base DISA&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;só se faltou na base DISA (conta como não usou)&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="24" y="1314" width="330" height="66" as="geometry"/></mxCell><mxCell id="c84" value="➕ 1.6 - Avaliado Uso Rede Própria DISA&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;pulado na retomada&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="24" y="1408" width="330" height="50" as="geometry"/></mxCell><mxCell id="c85" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="24" y="1486" width="330" height="40" as="geometry"/></mxCell><mxCell id="c87" value="VELHO e alguém com SIM&lt;br&gt;na base DISA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="74" y="1554" width="230" height="104" as="geometry"/></mxCell><mxCell id="c86" value="Sem ação: aguarda a DISA&lt;br&gt;prox_acao = VELHO: aguardar retorno da DISA" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="1573" width="270" height="66" as="geometry"/></mxCell><mxCell id="c95" value="Faltou matrícula&lt;br&gt;na base geral?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="74" y="1686" width="230" height="90" as="geometry"/></mxCell><mxCell id="c89" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_nao_encontradas_base_geral()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;incluir_memo_apis_mat_nao_encontradas&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="1698" width="270" height="66" as="geometry"/></mxCell><mxCell id="c90" value="➕ 1.2.1 - Mat. N Encontradas Base Geral" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="1792" width="270" height="50" as="geometry"/></mxCell><mxCell id="c91" value="📄 &lt;b&gt;MemoApisMatNaoEncontradas&lt;/b&gt;&lt;br&gt;no bloco 7711907" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="1870" width="270" height="50" as="geometry"/></mxCell><mxCell id="c92" value="➕ 1.6.1 - Aguarda APIS: Matrículas" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="1948" width="270" height="50" as="geometry"/></mxCell><mxCell id="c93" value="➖ 1.6 - Avaliado Uso Rede Própria DISA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="2026" width="270" height="50" as="geometry"/></mxCell><mxCell id="c94" value="prox_acao = Assinar memo à APIS (matrículas não encontradas)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="2104" width="270" height="50" as="geometry"/></mxCell><mxCell id="c108" value="Período variável&lt;br&gt;para dependentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="74" y="2170" width="230" height="104" as="geometry"/></mxCell><mxCell id="c102" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_periodo_variavel()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="2197" width="270" height="50" as="geometry"/></mxCell><mxCell id="c103" value="➕ 1.1 - Período Variável p/ Dependentes" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="2275" width="270" height="50" as="geometry"/></mxCell><mxCell id="c104" value="📄 &lt;b&gt;MemoApisPeriodoDependentes&lt;/b&gt;&lt;br&gt;no bloco 7730905" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="2353" width="270" height="50" as="geometry"/></mxCell><mxCell id="c105" value="➕ 1.7 - Aguarda APIS: Período Deps" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="2431" width="270" height="50" as="geometry"/></mxCell><mxCell id="c106" value="➖ 1.6 - Avaliado Uso Rede Própria DISA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="2509" width="270" height="50" as="geometry"/></mxCell><mxCell id="c107" value="prox_acao = Assinar memo à APIS (período dos dependentes)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="424" y="2587" width="270" height="50" as="geometry"/></mxCell><mxCell id="c115" value="▶ _avaliar_mantis_e_criar_docs() — coluna 4" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c116"><mxGeometry x="24" y="2638" width="330" height="40" as="geometry"/></mxCell><mxCell id="c182" value="&lt;b style=&quot;font-size:16px&quot;&gt;4 · _avaliar_mantis_e_criar_docs()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;MANTIS, relatórios em PDF e memos DISA/DEPROC. O memo à DISA depende só do uso da rede própria (RP) no MANTIS; RC = rede credenciada&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="2374" y="270" width="1086" height="2150" as="geometry"/></mxCell><mxCell id="c117" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;avaliar_uso_rede_propria_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Atendimentos no período do titular, nas duas redes&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;interpretar_periodo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="74" width="330" height="82" as="geometry"/></mxCell><mxCell id="c119" value="Período ou data&lt;br&gt;de atendimento&lt;br&gt;inválidos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="74" y="184" width="230" height="104" as="geometry"/></mxCell><mxCell id="c118" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="424" y="216" width="270" height="40" as="geometry"/></mxCell><mxCell id="c121" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_registrar_uso_mantis() · usos_mantis_alem_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Base DISA × MANTIS rede própria&lt;/b&gt;, por beneficiário:&lt;br&gt;• DISA sim × MANTIS sim → memo à DISA validar (&quot;consta na planilha&quot;)&lt;br&gt;• DISA não × MANTIS sim → memo à DISA validar (&quot;NÃO consta na planilha&quot;; coluna mats_uso_mantis_alem_disa)&lt;br&gt;• DISA sim × MANTIS não → nada para a DISA&lt;br&gt;• DISA não × MANTIS não → nada para a DISA&lt;br&gt;Quem decide o memo à DISA é só o MANTIS; a base DISA muda só o texto do memo. (No VELHO, SIM na base DISA já parou o processo na coluna 3.)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="316" width="330" height="258" as="geometry"/></mxCell><mxCell id="c122" value="Monta os memos &lt;b&gt;antes de qualquer ação no SEI&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="602" width="330" height="40" as="geometry"/></mxCell><mxCell id="c124" value="Texto do memo&lt;br&gt;pendente?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="74" y="670" width="230" height="90" as="geometry"/></mxCell><mxCell id="c123" value="&lt;b&gt;TextoMemoPendente&lt;/b&gt;&lt;br&gt;nada é criado no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="424" y="690" width="270" height="50" as="geometry"/></mxCell><mxCell id="c126" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Os marcadores que serão adicionados existem no SEI?" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="788" width="330" height="66" as="geometry"/></mxCell><mxCell id="c127" value="➕ 1.8 - Avaliado Uso Rede Própria MANTIS&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;pulado na retomada&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="882" width="330" height="66" as="geometry"/></mxCell><mxCell id="c128" value="➖ 1.6 - Avaliado Uso Rede Própria DISA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="976" width="330" height="40" as="geometry"/></mxCell><mxCell id="c155" value="Processo VELHO?&lt;br&gt;Alguém usou a RP no MANTIS?&lt;br&gt;(ou já tem 1.9 - Memo DISA Uso Rede Própria)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="393" y="1044" width="300" height="136" as="geometry"/></mxCell><mxCell id="c129" value="📎 PDF Utilização Tit./Dep. &lt;b&gt;RP&lt;/b&gt;" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="1240" width="240" height="46" as="geometry"/></mxCell><mxCell id="c130" value="📄 &lt;b&gt;MemoDisa&lt;/b&gt; (validar RP)&lt;b&gt;&lt;/b&gt;&lt;br&gt;no bloco 7697744" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="1314" width="240" height="50" as="geometry"/></mxCell><mxCell id="c131" value="➕ 1.9 - Memo DISA Uso Rede Própria" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="1392" width="240" height="50" as="geometry"/></mxCell><mxCell id="c132" value="➖ 1.8 - Avaliado Uso Rede Própria MANTIS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="1470" width="240" height="50" as="geometry"/></mxCell><mxCell id="c133" value="📎 PDF Utilização Tit./Dep. &lt;b&gt;RC&lt;/b&gt;&lt;br&gt;(só de quem usou)" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="1548" width="240" height="62" as="geometry"/></mxCell><mxCell id="c134" value="📄 &lt;b&gt;MemoDeproc&lt;/b&gt;&lt;br&gt;no bloco 7697744" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c182"><mxGeometry x="24" y="1638" width="240" height="50" as="geometry"/></mxCell><mxCell id="c135" v