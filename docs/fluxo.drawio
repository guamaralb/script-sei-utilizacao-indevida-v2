o_geacs_por_assunto()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Só se houver memo da GEACS na rodada: lê os memos (do mais recente ao mais antigo) e compara com PADRAO_ASSUNTO_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="c193"><mxGeometry x="24" y="86" width="340" height="82" as="geometry"/></mxCell><mxCell id="c190" value="Memo já existe?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="c193"><mxGeometry x="44" y="202" width="300" height="80" as="geometry"/></mxCell><mxCell id="c189" value="Retomada: não recria&lt;br&gt;(&amp;lt;memo&amp;gt;_na_arvore e &amp;lt;memo&amp;gt;_sei); quem chamou só adiciona o marcador" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="c193"><mxGeometry x="434" y="272" width="280" height="66" as="geometry"/></mxCell><mxCell id="c191" value="📄 incluir_doc_sei_memo(): cria o memo&lt;br&gt;(&amp;lt;memo&amp;gt;_criado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="c193"><mxGeometry x="24" y="372" width="340" height="50" as="geometry"/></mxCell><mxCell id="c192" value="📄 inserir_bloco_ass(bloco)&lt;br&gt;(&amp;lt;memo&amp;gt;_inserido_bloco)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="c193"><mxGeometry x="24" y="456" width="340" height="50" as="geometry"/></mxCell><mxCell id="c201" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size:14px&quot;&gt;&lt;b&gt;incluir_relatorios() → _incluir()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal&quot;&gt;Um PDF para o titular e outro para os dependentes, só de quem tem atendimento na rede&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;c