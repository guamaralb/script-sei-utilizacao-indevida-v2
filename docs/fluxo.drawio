<mxfile host="app.diagrams.net" type="device"><diagram id="fluxo-completo" name="Fluxo completo"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4318" pageHeight="3344" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c247" value="Fluxo do script SEI - Utilização Indevida (v2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="44" as="geometry"/></mxCell><mxCell id="c248" value="Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1200" height="28" as="geometry"/></mxCell><mxCell id="c236" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c237" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c238" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c239" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c240" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c241" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c242" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c243" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c244" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c245" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c246" value="&lt;b&gt;Pendências (TODO)&lt;/b&gt;&lt;br&gt;• remover_marcador na sei_automacao (sem ele o main não inicia)&lt;br&gt;• no SEI: editar os marcadores renomeados (1 - Tratado pelo Script, 1.5 - Aguarda APIS: Sem Memo p/ GEACS, 1.5 - Aguarda APIS: Formato Inválido, 1.6.1 - Aguarda APIS: Matrículas, 1.7 - Aguarda APIS: Período Deps, 1.10 - Concluído: Memo DEPROC, 1.2.1 - Mat. N Encontradas Base APIS) e cadastrar 0 - Processo VELHO, os quatro 1.6.2 / 1.8.2 e os três 1.9 - Aguarda DISA&lt;br&gt;• blocos dos três memos à DISA (constantes = None)&lt;br&gt;• revisar os textos e assuntos dos memos com TEXTO_DEFINIDO = False&lt;br&gt;• fluxo do processo VELHO&lt;br&gt;• tratar a resposta dos processos parados (APIS e DISA)" style="shape=note;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2170" y="100" width="460" height="226" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Carrega as bases, faz login e passa cada processo pelo fluxo. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1392" as="geometry"/></mxCell><mxCell id="c10" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="90" width="330" height="40" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria as pastas e o log da execução" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="158" width="330" height="50" as="geometry"/></mxCell><mxCell id="c13" value="remover_marcador existe&lt;br&gt;na sei_automacao?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="74" y="236" width="230" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;SystemExit&lt;/b&gt;: execução não iniciada&lt;br&gt;(TODO na sei_automacao)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="424" y="271" width="270" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;carregar_bases() · carregar_bases_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê processos_nao_processados.xlsx, a base DISA, a base APIS e o MANTIS (rede própria e credenciada)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="384" width="330" height="82" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle e faz login no SEI" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="494" width="330" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="572" width="330" height="40" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_processar_linha()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Abre o processo e lê a árvore e os marcadores do SEI&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;acessar_processo, registrar_arvore, registrar_tags&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="640" width="330" height="98" as="geometry"/></mxCell><mxCell id="c19" value="▶ _tratar() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="766" width="330" height="40" as="geometry"/></mxCell><mxCell id="c20" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;De novo, no fim da passagem (se não houve erro)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="834" width="330" height="66" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Erro levantado em qualquer coluna?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;: tipo_erro, erro e prox_acao = Verificar erro (ou a já definida). Inesperado: + traceback" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="928" width="330" height="82" as="geometry"/></mxCell><mxCell id="c22" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Regrava a planilha de controle (abas processos e historico) depois de cada processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="1038" width="330" height="66" as="geometry"/></mxCell><mxCell id="c24" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="74" y="1132" width="230" height="90" as="geometry"/></mxCell><mxCell id="c23" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="424" y="1157" width="270" height="40" as="geometry"/></mxCell><mxCell id="c26" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="1250" width="330" height="50" as="geometry"/></mxCell><mxCell id="c27" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c28"><mxGeometry x="24" y="1328" width="330" height="40" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · _tratar()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Separa o processo VELHO e roteia pelos marcadores lidos do SEI. Só adiciona o marcador 1 (e o 0, em _separar_velho); o resto é decidido em processar_novo()&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="2160" as="geometry"/></mxCell><mxCell id="c29" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;conferir_marcadores()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A combinação de marcadores é possível no fluxo?&lt;br&gt;• no máximo um marcador de estado (★)&lt;br&gt;• no máximo um de cada par: 1.6.2 - Base DISA: Usou RP / 1.6.2 - Base DISA: Não Usou RP e 1.8.2 - MANTIS: Usou RP / 1.8.2 - MANTIS: Não Usou RP&lt;br&gt;• informativo só com estado compatível&lt;br&gt;• 1.6.1 - Aguarda APIS: Matrículas exige 1.2.1 - Mat. N Encontradas Base APIS&lt;br&gt;• 1.7 - Aguarda APIS: Período Deps exige 1.1 - Período Variável p/ Dependentes&lt;br&gt;• cada 1.9 - Aguarda DISA exige o seu par: Validar (Consta) = DISA e MANTIS Usou RP; Validar (N Consta) = DISA Não Usou e MANTIS Usou; Relatório = DISA Usou e MANTIS Não Usou&lt;br&gt;• VELHO (0 - Processo VELHO ou 1.3 - Memos DISA e DEPROC no Bloco) sem memos à DISA ou à DEPROC do fluxo atual (1.9, 1.10)…" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="24" y="90" width="330" height="338" as="geometry"/></mxCell><mxCell id="c31" value="Marcadores&lt;br&gt;inconsistentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="74" y="456" width="230" height="90" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;MarcadoresInconsistentes&lt;/b&gt;: nada é feito no SEI&lt;br&gt;prox_acao = Verificar marcadores (corrigir no SEI)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="460" width="270" height="82" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;VELHO&lt;/b&gt; pelos marcadores?&lt;br&gt;0 - Processo VELHO ou&lt;br&gt;1.3 - Memos DISA e DEPROC no Bloco" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="24" y="574" width="330" height="120" as="geometry"/></mxCell><mxCell id="c33" value="▶ _separar_velho()&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;à direita&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="609" width="270" height="50" as="geometry"/></mxCell><mxCell id="c36" value="&lt;font face=&quot;Courier New&quot;&gt;estado_atual()&lt;/font&gt;: marcador de estado do processo" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="24" y="722" width="330" height="50" as="geometry"/></mxCell><mxCell id="c38" value="Estado de parada?&lt;br&gt;1.5 - Aguarda APIS: Sem Memo p/ GEACS&lt;br&gt;1.5 - Aguarda APIS: Formato Inválido&lt;br&gt;1.6.1 - Aguarda APIS: Matrículas&lt;br&gt;1.7 - Aguarda APIS: Período Deps&lt;br&gt;1.9 - Aguarda DISA: Validar (Consta)&lt;br&gt;1.9 - Aguarda DISA: Validar (N Consta)&lt;br&gt;1.9 - Aguarda DISA: Relatório&lt;br&gt;versão anterior: 1.8.1 - Memo DISA Validar Usos MANTIS, 1.9 - Memo DISA Uso Rede Própria" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="24" y="800" width="330" height="360" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Erro&lt;/b&gt;: parado aguardando resposta ao memo&lt;br&gt;prox_acao = Aguardar resposta ao memo enviado" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="939" width="270" height="82" as="geometry"/></mxCell><mxCell id="c41" value="Estado de conclusão?&lt;br&gt;1.10 - Concluído: Memo DEPROC&lt;br&gt;versão anterior: 1.10 - Concluído: Memos DISA e DEPROC" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="24" y="1188" width="330" height="152" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Concluído&lt;/b&gt;, prox_acao:&lt;br&gt;1.10 - Concluído: Memo DEPROC → assinar DEPROC&lt;br&gt;1.10 - Concluído: Memos DISA e DEPROC → assinar os dois" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="1215" width="270" height="98" as="geometry"/></mxCell><mxCell id="c44" value="NOVO sem estado com&lt;br&gt;1.3 - Memo DEPROC no Bloco?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="74" y="1368" width="230" height="120" as="geometry"/></mxCell><mxCell id="c43" value="Concluído na versão anterior&lt;br&gt;prox_acao = Assinar memo DEPROC" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="1403" width="270" height="50" as="geometry"/></mxCell><mxCell id="c46" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_memos_velho()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê &lt;b&gt;todos os memorandos da GEACS&lt;/b&gt; e procura dois seguidos: &quot;Para: IPSEMG/DISA-UTI-INDEV&quot; e depois &quot;Para: IPSEMG/DEPROC&quot;, os dois datados (&quot;Belo Horizonte, 18 de setembro de 2026.&quot;) antes de 01/10/2026" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="24" y="1516" width="330" height="114" as="geometry"/></mxCell><mxCell id="c48" value="Par sem data&lt;br&gt;legível?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="74" y="1658" width="230" height="90" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: não dá para saber se é VELHO; nada é feito no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="1678" width="270" height="50" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;VELHO&lt;/b&gt; pelos memos&lt;br&gt;da GEACS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="74" y="1776" width="230" height="104" as="geometry"/></mxCell><mxCell id="c50" value="▶ _separar_velho()&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;à direita&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="1803" width="270" height="50" as="geometry"/></mxCell><mxCell id="c55" value="Sem o marcador&lt;br&gt;&lt;b&gt;1 - Tratado pelo Script&lt;/b&gt;?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="74" y="1908" width="230" height="104" as="geometry"/></mxCell><mxCell id="c53" value="➕ 1 - Tratado pelo Script" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="1940" width="270" height="40" as="geometry"/></mxCell><mxCell id="c54" value="▶ processar_novo() do início — coluna 3" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="424" y="2008" width="270" height="50" as="geometry"/></mxCell><mxCell id="c58" value="▶ processar_novo() — coluna 3&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;do início ou retomando de 1.6 - Avaliado Uso Rede Própria DISA ou 1.8 - Avaliado Uso Rede Própria MANTIS&lt;/span&gt;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c59"><mxGeometry x="24" y="2054" width="330" height="82" as="geometry"/></mxCell><mxCell id="c127" value="&lt;b style=&quot;font-size:16px&quot;&gt;3 · processar_novo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Memo da APIS, base APIS e base DISA, e as paradas com memo à APIS. Na retomada, as etapas já feitas são puladas (_etapa_feita)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="1596" y="270" width="718" height="2998" as="geometry"/></mxCell><mxCell id="c60" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Usa o &lt;b&gt;último&lt;/b&gt; memo da APIS destinado à GEACS; os documentos depois dele são a rodada&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;obter_memos_apis_para_geacs, validar_template, extrair_dados_ui&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="24" y="90" width="330" height="98" as="geometry"/></mxCell><mxCell id="c66" value="Nenhum memo da APIS&lt;br&gt;para a GEACS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="74" y="216" width="230" height="104" as="geometry"/></mxCell><mxCell id="c61" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_sem_memo_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="243" width="270" height="50" as="geometry"/></mxCell><mxCell id="c62" value="📄 &lt;b&gt;MemoApisSemMemo&lt;/b&gt;&lt;br&gt;no bloco 7730344" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="321" width="270" height="50" as="geometry"/></mxCell><mxCell id="c63" value="➕ 1.5 - Aguarda APIS: Sem Memo p/ GEACS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;