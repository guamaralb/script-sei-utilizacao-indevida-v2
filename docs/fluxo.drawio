        <mxCell id="geral-n0" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Os marcadores aparecem com o &lt;b&gt;nome completo&lt;/b&gt;, como estão cadastrados no SEI. Todos levam o prefixo &lt;b&gt;&quot;Script v2 - &quot;&lt;/b&gt; (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="geral-n1" value="&lt;b&gt;Desfecho de cada processo&lt;/b&gt;&lt;br&gt;Todo caminho (prox_acao, fim de subfluxo ou erro) termina o processo atual. O registro vira uma linha da planilha e o loop volta a &quot;Há próximo processo?&quot; (seta tracejada)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="940" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="geral-n4" value="&lt;b&gt;Classificação&lt;/b&gt;&lt;br&gt;NOVO: nenhum documento da GEACS na árvore.&lt;br&gt;VELHO: já existe documento da GEACS.&lt;br&gt;O marcador 1 - Processo NOVO segue na mesma execução; o 2 - Processo VELHO só é tratado na execução seguinte." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="1920" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="geral-n2" value="&lt;b&gt;Marcadores manuais&lt;/b&gt;&lt;br&gt;PLANILHADO e UTILIZAÇÃO INSERIDA não contam na pergunta &quot;Tem outro marcador com o prefixo Script v2 - ?&quot; e não impedem a classificação." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1650" y="1675" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="geral-n3" value="&lt;b&gt;Erros (caixas vermelhas)&lt;/b&gt;&lt;br&gt;As setas vermelhas e grossas mostram &lt;b&gt;em que ponto exato&lt;/b&gt; o fluxo leva a erro.&lt;br&gt;registrar_erro(registro, e) preenche tipo_erro, erro e, se preciso, prox_acao = &quot;Verificar erro&quot;.&lt;br&gt;ErroAvaliacao / FormatoMemorandoInvalido: log sem traceback. Falha inesperada: logger.exception.&lt;br&gt;O processo termina e o loop segue: &lt;b&gt;um erro nunca interrompe os demais&lt;/b&gt;." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1650" y="940" width="340" height="210" as="geometry" />
        </mxCell>
