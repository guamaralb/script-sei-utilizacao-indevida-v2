        <mxCell id="l-mm1" value="MANUAL, ASSINADO (sem prefixo)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1245" width="440" height="40" as="geometry" /></mxCell>
        <mxCell id="l-ms1" value="Manuais; tiram o processo do escopo do script de correção" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="1245" width="420" height="40" as="geometry" /></mxCell>
        <mxCell id="l-mo1" value="Manualmente" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="1245" width="320" height="40" as="geometry" /></mxCell>
        <mxCell id="l-n0" value="&lt;b&gt;Numeração&lt;/b&gt;&lt;br&gt;Primeiro número = ramo (1 NOVO, 2 VELHO); número após o ponto = ordem de inserção. &lt;b&gt;Mesmo número = alternativas&lt;/b&gt; (o processo recebe um ou outro).&lt;br&gt;O SEI limita o nome a &lt;b&gt;50 caracteres&lt;/b&gt;. Os nomes em tags.py precisam ser idênticos aos do SEI: para renomear, edite o marcador existente no SEI e atualize tags.py.&lt;br&gt;&lt;b&gt;TODO&lt;/b&gt;: cadastrar no SEI os marcadores 1.5 a 1.10." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="1313" width="440" height="150" as="geometry" /></mxCell>
        <mxCell id="l-n1" value="&lt;b&gt;Ciclo de vida&lt;/b&gt;&lt;br&gt;NOVO normal: 1 → [1.2.2] → 1.6 → 1.8 → [1.9] → 1.10&lt;br&gt;Parado pelo memo da APIS: 1 → 1.5 (um dos dois)&lt;br&gt;Parado pela base geral: 1 → [1.2.2] → 1.6 → 1.2.1 → 1.6.1&lt;br&gt;Parado pelo período: 1 → [1.2.2] → 1.6 → 1.1 → 1.7&lt;br&gt;Parado pelo MANTIS: 1 → [1.2.2] → 1.6 → 1.8 → 1.8.1&lt;br&gt;Versão anterior: 1 → [1.1] → 1.2 → 1.3 (um dos dois)&lt;br&gt;Correção: 1 → 1.3 Memos DISA e DEPROC → [1.4] → 1.2&lt;br&gt;VELHO: 2 → 2.1 → [2.1.1/2.1.2] → 2.2" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="1313" width="420" height="210" as="geometry" /></mxCell>
        <mxCell id="l-n2" value="&lt;b&gt;Blocos de assinatura&lt;/b&gt;&lt;br&gt;7697744: memos DISA e DEPROC (fluxo normal)&lt;br&gt;7707212: memo de correção&lt;br&gt;7730344: memo à APIS (sem memorando)&lt;br&gt;7730341: memo à APIS (formato inválido)&lt;br&gt;7730905: memo à APIS (período dos dependentes)&lt;br&gt;7730939: memo à DISA (validar usos do MANTIS)&lt;br&gt;7711907: memo à APIS (matrículas não encontradas)&lt;br&gt;&lt;br&gt;&lt;b&gt;Antes de criar qualquer memo&lt;/b&gt;: garantir_marcadores_no_sei." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="1313" width="320" height="210" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
