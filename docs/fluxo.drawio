366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="787" width="270" height="50" as="geometry"/></mxCell><mxCell id="c75" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="865" width="270" height="40" as="geometry"/></mxCell><mxCell id="c76" value="prox_acao = Assinar memo à APIS (formato inválido)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="933" width="270" height="50" as="geometry"/></mxCell><mxCell id="c83" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;verificar_base_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A existência das matrículas é conferida &lt;b&gt;só na base APIS&lt;/b&gt; (a base DISA é feita a partir dela)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="24" y="976" width="330" height="82" as="geometry"/></mxCell><mxCell id="c85" value="Matrícula em&lt;br&gt;formato inválido?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="74" y="1086" width="230" height="104" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1118" width="270" height="40" as="geometry"/></mxCell><mxCell id="c93" value="Faltou matrícula&lt;br&gt;na base APIS?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="74" y="1218" width="230" height="90" as="geometry"/></mxCell><mxCell id="c87" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_nao_encontradas_base_apis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;garantir_marcadores_no_sei, incluir_memo_apis_mat_nao_encontradas&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1222" width="270" height="82" as="geometry"/></mxCell><mxCell id="c88" value="➕ 1.2.1 - Mat. N Encontradas Base APIS" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1332" width="270" height="50" as="geometry"/></mxCell><mxCell id="c89" value="📄 &lt;b&gt;MemoApisMatNaoEncontradas&lt;/b&gt;&lt;br&gt;no bloco 7711907" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1410" width="270" height="50" as="geometry"/></mxCell><mxCell id="c90" value="➕ 1.6.1 - Aguarda APIS: Matrículas" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1488" width="270" height="50" as="geometry"/></mxCell><mxCell id="c91" value="➖ estado anterior (se houver)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1566" width="270" height="40" as="geometry"/></mxCell><mxCell id="c92" value="prox_acao = Assinar memo à APIS (matrículas não encontradas)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1634" width="270" height="50" as="geometry"/></mxCell><mxCell id="c101" value="Tem 1.2.1 - Mat. N Encontradas Base APIS?&lt;br&gt;(base corrigida)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="24" y="1708" width="330" height="104" as="geometry"/></mxCell><mxCell id="c100" value="➖ 1.2.1 - Mat. N Encontradas Base APIS&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;remove e segue o fluxo (abaixo)&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1727" width="270" height="66" as="geometry"/></mxCell><mxCell id="c103" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_avaliar_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Uso da rede própria na base DISA. Fora da base DISA = não usou&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;avaliar_uso_rede_propria_disa, registrar_uso, garantir_marcadores_no_sei&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="24" y="1840" width="330" height="98" as="geometry"/></mxCell><mxCell id="c105" value="Resposta inválida&lt;br&gt;na base DISA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="74" y="1966" width="230" height="104" as="geometry"/></mxCell><mxCell id="c104" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="1998" width="270" height="40" as="geometry"/></mxCell><mxCell id="c110" value="Alguém usou a rede própria&lt;br&gt;segundo a &lt;b&gt;base DISA&lt;/b&gt;?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="209" y="2098" width="300" height="104" as="geometry"/></mxCell><mxCell id="c107" value="➕ 1.6.2 - Base DISA: Usou RP" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="106" y="2262" width="240" height="40" as="geometry"/></mxCell><mxCell id="c108" value="➕ 1.6.2 - Base DISA: Não Usou RP" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="372" y="2262" width="240" height="50" as="geometry"/></mxCell><mxCell id="c109" value="➕ 1.6 - Avaliado Uso Rede Própria DISA&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;pulado na retomada; remove o estado anterior&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="194" y="2372" width="330" height="66" as="geometry"/></mxCell><mxCell id="c119" value="Período variável&lt;br&gt;para dependentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="74" y="2466" width="230" height="104" as="geometry"/></mxCell><mxCell id="c113" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_parar_periodo_variavel()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;_parar_com_memo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="2493" width="270" height="50" as="geometry"/></mxCell><mxCell id="c114" value="➕ 1.1 - Período Variável p/ Dependentes" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="2571" width="270" height="50" as="geometry"/></mxCell><mxCell id="c115" value="📄 &lt;b&gt;MemoApisPeriodoDependentes&lt;/b&gt;&lt;br&gt;no bloco 7730905" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="2649" width="270" height="50" as="geometry"/></mxCell><mxCell id="c116" value="➕ 1.7 - Aguarda APIS: Período Deps" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="2727" width="270" height="50" as="geometry"/></mxCell><mxCell id="c117" value="➖ 1.6 - Avaliado Uso Rede Própria DISA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="2805" width="270" height="50" as="geometry"/></mxCell><mxCell id="c118" value="prox_acao = Assinar memo à APIS (período dos dependentes)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="424" y="2883" width="270" height="50" as="geometry"/></mxCell><mxCell id="c126" value="▶ _avaliar_mantis_e_criar_docs() — coluna 4" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c127"><mxGeometry x="24" y="2934" width="330" height="40" as="geometry"/></mxCell><mxCell id="c198" value="&lt;b style=&quot;font-size:16px&quot;&gt;4 · _avaliar_mantis_e_criar_docs()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;MANTIS e a comparação base DISA × MANTIS (rede própria), pelo processo inteiro (alguém usou). Cada caso tem o seu memo e o seu bloco. &lt;b&gt;Quem vai para a DISA não vai para a DEPROC&lt;/b&gt;. RP = rede própria; RC = rede credenciada&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="2374" y="270" width="1086" height="2126" as="geometry"/></mxCell><mxCell id="c128" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;avaliar_uso_rede_propria_mantis()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Atendimentos no período do titular, nas duas redes&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;interpretar_periodo&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c198"><mxGeometry x="24" y="90" width="330" height="82" as="geometry"/></mxCell><mxCell id="c130" value="Período ou data&lt;br&gt;de atendimento&lt;br&gt;inválidos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c198"><mxGeometry x="74" y="200" width="230" height="104" as="geometry"/></mxCell><mxCell id="c129" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c198"><mxGeometry x="424" y="232" width="270" height="40" as="geometry"/></mxCell><mxCell id="c132" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_registrar_uso_mantis() · usos_mantis_alem_disa()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Planilha: uso nas duas redes, 