        <mxCell id="script-correcao-x25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="script-correcao-prox" target="script-correcao-qloop">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="665" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="script-correcao-n0" value="&lt;b&gt;Nomes dos marcadores&lt;/b&gt;&lt;br&gt;Os marcadores aparecem com o &lt;b&gt;nome completo&lt;/b&gt;, como estão cadastrados no SEI. Todos levam o prefixo &lt;b&gt;&quot;Script v2 - &quot;&lt;/b&gt; (ex.: &quot;Script v2 - 1.2 - Avaliado Se Usou Rede Própria&quot;). Limite do SEI: 50 caracteres." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="320" height="190" as="geometry" />
        </mxCell>
        <mxCell id="script-correcao-n1" value="&lt;b&gt;Objetivo&lt;/b&gt;&lt;br&gt;Corrigir os NOVOS encaminhados à DISA e à DEPROC &lt;b&gt;sem&lt;/b&gt; avaliação do uso da rede própria. Nenhum marcador é adicionado na triagem: só a rotina de correção adiciona." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2240" y="570" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="script-correcao-n2" value="&lt;b&gt;Erros (caixas vermelhas)&lt;/b&gt;&lt;br&gt;As setas vermelhas e grossas mostram &lt;b&gt;em que ponto exato&lt;/b&gt; o fluxo leva a erro.&lt;br&gt;registrar_erro(registro, e) preenche tipo_erro, erro e, se preciso, prox_acao = &quot;Verificar erro&quot;.&lt;br&gt;ErroAvaliacao / FormatoMemorandoInvalido: log sem traceback. Falha inesperada: logger.exception.&lt;br&gt;O processo termina e o loop segue: &lt;b&gt;um erro nunca interrompe os demais&lt;/b&gt;." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2240" y="940" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="script-correcao-n3" value="&lt;b&gt;Os dois main nunca se importam&lt;/b&gt;: a rotina de correção fica em correcao_rede_propria.py e é usada pelos dois scripts." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="1920" width="320" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
