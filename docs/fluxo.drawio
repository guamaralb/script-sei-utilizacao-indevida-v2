id="c1192" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c648" target="c649"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1193" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c649" target="c650"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="deproc-calcula-copa" name="deproc_calcula_copa"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1596" pageHeight="2426" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1194" value="run_deproc_calcula_copa · Cálculo da coparticipação na DEPROC (main_deproc_calcula_copa.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c1195" value="Na unidade da DEPROC, com os marcadores da DEPROC. Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c1196" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c1197" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1198" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c1199" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1200" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1201" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1202" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1203" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c1204" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1205" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c516" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_deproc_calcula_copa [-a AAAA -d DD/MM/AAAA] (base DEPROC dos processos sem a base na planilha de controle: obrigatórios se algum não tiver). Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=82;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="2080" as="geometry"/></mxCell><mxCell id="c499" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="106" width="330" height="40" as="geometry"/></mxCell><mxCell id="c491" value="ler_argumentos():&lt;br&gt;só um de -a e -d, fora do formato&lt;br&gt;ou sem o arquivo da base?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="74" y="174" width="230" height="168" as="geometry"/></mxCell><mxCell id="c490" value="argparse mostra o erro (com as bases da pasta) e encerra (código 2), antes do log, do login e de qualquer ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="424" y="217" width="270" height="82" as="geometry"/></mxCell><mxCell id="c500" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba deproc_calcula_copa de processos_a_processar.xlsx. A base DEPROC de cada ano e data de geração (BaseDeproc: copa-MANTIS11281-base_AAAA-DD_MM_AAAA.xlsx em dados/fluxo_deproc, aba Resultado, matrículas com DV) é carregada na primeira vez que um processo precisa dela" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="370" width="330" height="162" as="geometry"/></mxCell><mxCell id="c497" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="560" width="330" height="50" as="geometry"/></mxCell><mxCell id="c493" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;bases_dos_processos()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Base de cada processo: ano_processo e data_geracao_base_processo da planilha de controle (geacs_inicial) ou, sem eles, ano_base_deproc e data_geracao_base_deproc (apuração anterior). Sem nenhum par: a do -a e do -d (gravados em ano_processo e data_geracao_base_processo). Com a do -a e -d diferente da da planilha, vale a da planilha (aviso no log)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="638" width="330" height="162" as="geometry"/></mxCell><mxCell id="c495" value="Algum processo sem base&lt;br&gt;(na planilha e no -a -d), ou só com&lt;br&gt;o ano_processo e -a de outro ano?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="74" y="828" width="230" height="184" as="geometry"/></mxCell><mxCell id="c494" value="-a e -d obrigatórios: argparse lista os processos e encerra (código 2), antes do login" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="424" y="887" width="270" height="66" as="geometry"/></mxCell><mxCell id="c498" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Faz login no SEI e troca para a unidade da DEPROC (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="1040" width="330" height="66" as="geometry"/></mxCell><mxCell id="c501" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="1134" width="330" height="40" as="geometry"/></mxCell><mxCell id="c503" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="74" y="1202" width="230" height="120" as="geometry"/></mxCell><mxCell id="c502" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="424" y="1229" width="270" height="66" as="geometry"/></mxCell><mxCell id="c505" value="▶ processar_deproc() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="1350" width="330" height="40" as="geometry"/></mxCell><mxCell id="c506" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="1418" width="330" height="66" as="geometry"/></mxCell><mxCell id="c507" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linha do processo: script, fluxo (DEPROC - COPARTICIPAÇÃO), prox_acao, erro, ano_base_deproc, data_geracao_base_deproc, ano_processo e data_geracao_base_processo (só os vindos do -a e do -d), marcadores_deproc_*, estado_atual_deproc e DEPROC | &lt;marcador&gt;. Os marcadores da GEACS e os resultados do fluxo inicial ficam como estão" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="1512" width="330" height="162" as="geometry"/></mxCell><mxCell id="c509" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="74" y="1702" width="230" height="90" as="geometry"/></mxCell><mxCell id="c508" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="424" y="1722" width="270" height="50" as="geometry"/></mxCell><mxCell id="c512" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="74" y="1820" width="230" height="90" as="geometry"/></mxCell><mxCell id="c511" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="424" y="1845" width="270" height="40" as="geometry"/></mxCell><mxCell id="c514" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="1938" width="330" height="50" as="geometry"/></mxCell><mxCell id="c515" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c516"><mxGeometry x="24" y="2016" width="330" height="40" as="geometry"/></mxCell><mxCell id="c547" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · processar_deproc()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Na unidade da DEPROC: apura a coparticipação, anexa o relatório e cria o MemoGeacsCalculoCopa (da DEPROC à GEACS). Marcadores da DEPROC (mesmo prefixo &quot;v2: &quot;)&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=66;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="2116" as="geometry"/></mxCell><mxCell id="c517" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;registrar_tags() · conferir_marcadores_deproc()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;No máximo um estado, e estado só com o 01. De novo no fim da passagem" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="90" width="330" height="82" as="geometry"/></mxCell><mxCell id="c519" value="Marcadores&lt;br&gt;inconsistentes?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="74" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c518" value="&lt;b&gt;MarcadoresInconsistentes&lt;/b&gt;: prox_acao = Verificar marcadores inconsistentes" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="424" y="212" width="270" height="66" as="geometry"/></mxCell><mxCell id="c522" value="Tem 01.02 - No Bloco GEACS:&lt;br&gt;Memo Cálculo COPA?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="74" y="318" width="230" height="120" as="geometry"/></mxCell><mxCell id="c521" value="Sem ler mais nada&lt;br&gt;prox_acao = DEPROC: assinar memo de resultado da coparticipação e encaminhar à GEACS" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="424" y="337" width="270" height="82" as="geometry"/></mxCell><mxCell id="c525" value="Tem 01.02.1 - Encaminhado GEACS:&lt;br&gt;Memo Cálculo COPA (manual)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="74" y="466" width="230" height="120" as="geometry"/></mxCell><mxCell id="c524" value="Concluído, sem ler mais nada&lt;br&gt;prox_acao = DEPROC: memo de resultado da coparticipação encaminhado à GEACS (concluído)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="424" y="485" width="270" height="82" as="geometry"/></mxCell><mxCell id="c528" value="Base do processo&lt;br&gt;fora da pasta?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="74" y="614" width="230" height="90" as="geometry"/></mxCell><mxCell id="c527" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="424" y="639" width="270" height="40" as="geometry"/></mxCell><mxCell id="c531" value="Sem Incluir Documento?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="74" y="732" width="230" height="90" as="geometry"/></mxCell><mxCell id="c530" value="&lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;: não está aberto na DEPROC (não reabre)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="424" y="752" width="270" height="50" as="geometry"/></mxCell><mxCell id="c533" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Os três que o script adiciona (TAGS_DEPROC): 01, 01.01 e 01.02" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="850" width="330" height="66" as="geometry"/></mxCell><mxCell id="c534" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_documentos_arvore() · obter_dados_ui()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Último memo da APIS destinado à GEACS (define a rodada). Sem memo ou formato inválido: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="944" width="330" height="98" as="geometry"/></mxCell><mxCell id="c535" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_memo_deproc_assinado()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Memo DEPROC da GEACS na rodada (PADRAO_ASSUNTO_MEMO_DEPROC), assinado por Gustavo Amaral Bernardino (ou, nos anteriores, Bruna Miiller Lavarini). Sem o memo ou sem a assinatura: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="1070" width="330" height="114" as="geometry"/></mxCell><mxCell id="c536" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;apurar_coparticipacao()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Linhas com SEI = processo; confere as matrículas com o memo da APIS (MatriculasDivergentes); mantém só as linhas com VALOR_BASE_COPA diferente de 0; filtra pelo período de apuração. Nenhuma linha: erro" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="1212" width="330" height="114" as="geometry"/></mxCell><mxCell id="c537" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_conferir_configuracao()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Antes de qualquer documento: bloco BLOCO_MEMO_GEACS_CALCULO_COPA (7765003), signatário (Danúbia Lacerda Gomes de Oliveira), texto do memo. Faltando: erro. O memo cita a data de geração da base do processo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="1354" width="330" height="114" as="geometry"/></mxCell><mxCell id="c538" value="➕ 01 - Tratado pelo Script&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;se faltar&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="1496" width="330" height="50" as="geometry"/></mxCell><mxCell id="c541" value="Há coparticipação no período?&lt;br&gt;(atendimento e total ≠ 0)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="74" y="1574" width="230" height="120" as="geometry"/></mxCell><mxCell id="c539" value="📎 PDF Coparticipação - &amp;lt;matrícula&amp;gt; - &amp;lt;data&amp;gt;&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;extrato de utilização, sem as linhas de valor 0; retomada pelo nome na rodada&lt;/span&gt;" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="424" y="1579" width="270" height="110" as="geometry"/></mxCell><mxCell id="c540" value="➕ 01.01 - Relatório Copart. Anexado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="424" y="1717" width="270" height="50" as="geometry"/></mxCell><mxCell id="c544" value="📄 &lt;b&gt;MemoGeacsCalculoCopa&lt;/b&gt;&lt;br&gt;no bloco 7765003 (BLOCO_MEMO_GEACS_CALCULO_COPA); tabelas: beneficiário (iniciais), matrícula, vínculo e valor (sem os de valor 0) e totais (apurado, descontado, em aberto)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="1790" width="330" height="98" as="geometry"/></mxCell><mxCell id="c545" value="➕ 01.02 - No Bloco GEACS: Memo Cálculo COPA&lt;br&gt;&lt;span style=&quot;font-weight:normal&quot;&gt;↻ remove o 01.01&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="1916" width="330" height="66" as="geometry"/></mxCell><mxCell id="c546" value="prox_acao = DEPROC: assinar memo de resultado da coparticipação e encaminhar à GEACS&lt;br&gt;Depois de assinar (manual): ➕ 01.02.1, ➖ 01.02" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c547"><mxGeometry x="24" y="2010" width="330" height="82" as="geometry"/></mxCell><mxCell id="c1206" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c491" 