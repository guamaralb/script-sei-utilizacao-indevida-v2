Scale="1" pageWidth="1596" pageHeight="2172" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1247" value="run_deproc_excluir_docs · Excluir os documentos da DEPROC gerados pelo script (main_deproc_excluir_docs.py)" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="44" as="geometry"/></mxCell><mxCell id="c1248" value="Na unidade da DEPROC. Remove os marcadores da DEPROC. Não altera a prox_acao (coluna própria deproc_excluir_docs). Leia as colunas da esquerda para a direita. Em cada coluna o caminho principal desce reto; os desvios saem para a direita." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="68" width="1600" height="28" as="geometry"/></mxCell><mxCell id="c1249" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;função()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;o que ela faz&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;funções que ela chama&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="114" width="180" height="82" as="geometry"/></mxCell><mxCell id="c1250" value="▶ outra coluna" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1251" value="Pergunta&lt;br&gt;(Sim → direita)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="103" width="180" height="104" as="geometry"/></mxCell><mxCell id="c1252" value="&lt;b&gt;caso&lt;/b&gt;&lt;br&gt;variação do fluxo" style="rounded=1;fillColor=#1f4e79;strokeColor=#10314f;strokeWidth=2;fontColor=#ffffff;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1253" value="➕ marcador adicionado" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1254" value="➖ marcador removido" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1255" value="📄 &lt;b&gt;Memo&lt;/b&gt;&lt;br&gt;no bloco …" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="130" width="180" height="50" as="geometry"/></mxCell><mxCell id="c1256" value="📎 relatório PDF anexado" style="shape=document;boundedLbl=1;size=0.15;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="124" width="180" height="62" as="geometry"/></mxCell><mxCell id="c1257" value="&lt;b&gt;Erro&lt;/b&gt; (registrar_erro)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c1258" value="fim / prox_acao" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1930" y="135" width="180" height="40" as="geometry"/></mxCell><mxCell id="c566" value="&lt;b style=&quot;font-size:16px&quot;&gt;1 · main() e _processar_linha()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;poetry run task run_deproc_excluir_docs. Um erro nunca interrompe os demais processos&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=50;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="718" height="1244" as="geometry"/></mxCell><mxCell id="c549" value="Início" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c550" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;configurar_logging() · ler_processos_a_processar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o log e lê a aba deproc_excluir_docs de processos_a_processar.xlsx" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="142" width="330" height="82" as="geometry"/></mxCell><mxCell id="c548" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;PlanilhaControleGeral() · abrir_sei()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê a planilha de controle, faz login no SEI e troca para a unidade da DEPROC (trocar_unidade)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="252" width="330" height="82" as="geometry"/></mxCell><mxCell id="c551" value="&lt;b&gt;Para cada processo&lt;/b&gt;" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="362" width="330" height="40" as="geometry"/></mxCell><mxCell id="c553" value="acessar_processo():&lt;br&gt;unidade sem acesso?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="74" y="430" width="230" height="120" as="geometry"/></mxCell><mxCell id="c552" value="registrar_sem_acesso(): prox_acao = Verificar acesso da unidade ao processo, sem ação no SEI" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="424" y="457" width="270" height="66" as="geometry"/></mxCell><mxCell id="c555" value="▶ excluir_docs_deproc() — coluna 2" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="578" width="330" height="40" as="geometry"/></mxCell><mxCell id="c556" value="&lt;b&gt;Erro levantado?&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;registrar_erro()&lt;/font&gt;. Inesperado: + traceback e recarrega a página" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="646" width="330" height="66" as="geometry"/></mxCell><mxCell id="c557" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;controle.registrar()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Não altera a prox_acao (nem fluxo, marcadores e erro dos outros fluxos): só script, ultima_passagem, data_execucao e a coluna deproc_excluir_docs (resultado em uma frase)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="740" width="330" height="98" as="geometry"/></mxCell><mxCell id="c559" value="Navegador fechado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="74" y="866" width="230" height="90" as="geometry"/></mxCell><mxCell id="c558" value="Para o loop (resumo e driver.quit() continuam)" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="424" y="886" width="270" height="50" as="geometry"/></mxCell><mxCell id="c562" value="Há mais processos?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="74" y="984" width="230" height="90" as="geometry"/></mxCell><mxCell id="c561" value="▶ volta a &quot;Para cada processo&quot;" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontStyle=1;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="424" y="1009" width="270" height="40" as="geometry"/></mxCell><mxCell id="c564" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;log_resumo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Fecha o navegador e loga o resumo" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="1102" width="330" height="50" as="geometry"/></mxCell><mxCell id="c565" value="Fim" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c566"><mxGeometry x="24" y="1180" width="330" height="40" as="geometry"/></mxCell><mxCell id="c593" value="&lt;b style=&quot;font-size:16px&quot;&gt;2 · excluir_docs_deproc()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Exclui só os documentos da IPSEMG/DEPROC-Utilização gerados pelo deproc_calcula_copa (relatório de coparticipação e memo de resultado). Os outros documentos da DEPROC são mantidos. Depois, remove os marcadores da DEPROC. Não adiciona marcadores&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#fbfcfe;startSize=82;" vertex="1" parent="1"><mxGeometry x="818" y="270" width="718" height="1862" as="geometry"/></mxCell><mxCell id="c568" value="Sem Incluir Documento&lt;br&gt;(fechado no setor)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="74" y="106" width="230" height="120" as="geometry"/></mxCell><mxCell id="c567" value="&lt;b&gt;ProcessoFechadoNoSetor&lt;/b&gt;: não reabre, nada é excluído" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="424" y="141" width="270" height="50" as="geometry"/></mxCell><mxCell id="c570" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;listar_documentos_arvore() · filtrar_docs_deproc()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Documentos da DEPROC (todos os tipos, não só memorandos)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="24" y="254" width="330" height="82" as="geometry"/></mxCell><mxCell id="c572" value="Nenhum documento&lt;br&gt;da DEPROC?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="74" y="364" width="230" height="90" as="geometry"/></mxCell><mxCell id="c571" value="deproc_excluir_docs = &quot;nenhum documento da DEPROC&quot;" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="424" y="384" width="270" height="50" as="geometry"/></mxCell><mxCell id="c574" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_separar_docs_gerados()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;PDF: nome &quot;PDF Coparticipação - &amp;lt;matrícula&amp;gt; - &amp;lt;AAAAMMDD_HHMMSS&amp;gt;&quot;. Memorando: texto (ler_texto_doc) com o assunto do MemoGeacsCalculoCopa (&quot;Retorno do levantamento de coparticipação – ...&quot; ou o anterior, &quot;Coparticipação apurada – ...&quot;). Os outros: mantidos. Memo que não pôde ser lido: não excluído" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="24" y="482" width="330" height="146" as="geometry"/></mxCell><mxCell id="c576" value="Nenhum gerado&lt;br&gt;pelo script?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="74" y="656" width="230" height="90" as="geometry"/></mxCell><mxCell id="c575" value="deproc_excluir_docs = &quot;nenhum documento gerado pelo deproc_calcula_copa&quot;" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="424" y="668" width="270" height="66" as="geometry"/></mxCell><mxCell id="c578" value="&lt;b&gt;Para cada documento gerado, do último para o primeiro&lt;/b&gt; (um documento posterior pode citar o anterior)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="24" y="774" width="330" height="66" as="geometry"/></mxCell><mxCell id="c579" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;selecionar_doc() · excluir_doc()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;sei_automacao.documento" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="24" y="868" width="330" height="50" as="geometry"/></mxCell><mxCell id="c581" value="Falhou?&lt;br&gt;(ex.: assinado)" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="74" y="946" width="230" height="90" as="geometry"/></mxCell><mxCell id="c580" value="Anota como não excluído, recarrega a página e segue para o próximo. Navegador fechado: para o processo" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="424" y="958" width="270" height="66" as="geometry"/></mxCell><mxCell id="c583" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;_docs_gerados_restantes()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;A árvore demora a refletir a exclusão: reabre o processo e relê a árvore até os excluídos sumirem, por até 15 s (TEMPO_CONFERENCIA)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="24" y="1064" width="330" height="82" as="geometry"/></mxCell><mxCell id="c585" value="Algum documento gerado&lt;br&gt;ainda na árvore?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="74" y="1174" width="230" height="104" as="geometry"/></mxCell><mxCell id="c584" value="&lt;b&gt;ErroAvaliacao&lt;/b&gt;: &quot;Documento(s) da DEPROC não excluído(s): ...; marcadores da DEPROC mantidos&quot; (sai dos excluídos)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="424" y="1185" width="270" height="82" as="geometry"/></mxCell><mxCell id="c587" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;remover_marcadores_deproc()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Lê os marcadores e remove os da DEPROC que o processo tiver (o 01 por último). Os outros ficam. Colunas marcadores_deproc_*, estado_atual_deproc e DEPROC | &lt;marcador&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;listar_marcadores() · tags.remover_tag()&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry x="24" y="1306" width="330" height="130" as="geometry"/></mxCell><mxCell id="c588" value="➖ v2: 01.02.1 - Encaminhado GEACS: Memo Cálculo COPA" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#fff4e5;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontColor=#8a5a00;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c593"><mxGeometry