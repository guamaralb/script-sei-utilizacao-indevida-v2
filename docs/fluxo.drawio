mxCell id="c229" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;remover_tag()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Remove o outro do grupo (cada ➖ do diagrama)&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;chama: &lt;font face=&quot;Courier New&quot;&gt;remover_marcador&lt;/font&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c232"><mxGeometry x="424" y="179" width="270" height="82" as="geometry"/></mxCell><mxCell id="c237" value="&lt;b style=&quot;font-size:16px&quot;&gt;adicionar_tag_se_ausente()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Retomada: 0 - Processo VELHO, 1.1 - Período Variável p/ Dependentes e 1.2.1 - Mat. N Encontradas Base APIS não são adicionados de novo&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=66;" vertex="1" parent="1"><mxGeometry x="3826" y="1676" width="718" height="272" as="geometry"/></mxCell><mxCell id="c234" value="Já tem o marcador?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c237"><mxGeometry x="74" y="90" width="230" height="90" as="geometry"/></mxCell><mxCell id="c233" value="Não faz nada" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c237"><mxGeometry x="424" y="115" width="270" height="40" as="geometry"/></mxCell><mxCell id="c236" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;adicionar_tag()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c237"><mxGeometry x="24" y="208" width="330" height="40" as="geometry"/></mxCell><mxCell id="c243" value="&lt;b style=&quot;font-size:16px&quot;&gt;incluir_memo()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cada 📄 do diagrama. Retomada: procura o memo pelo assunto na rodada&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3826" y="1988" width="718" height="334" as="geometry"/></mxCell><mxCell id="c238" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_memo_geacs_por_assunto()&lt;/b&gt;&lt;/font&gt;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c243"><mxGeometry x="24" y="74" width="330" height="40" as="geometry"/></mxCell><mxCell id="c240" value="Já existe?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c243"><mxGeometry x="74" y="142" width="230" height="90" as="geometry"/></mxCell><mxCell id="c239" value="Não recria (coluna &amp;lt;memo&amp;gt;_na_arvore)" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c243"><mxGeometry x="424" y="162" width="270" height="50" as="geometry"/></mxCell><mxCell id="c242" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;incluir_doc_sei_memo() · inserir_bloco_ass()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Cria o memo e insere no bloco" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c243"><mxGeometry x="24" y="260" width="330" height="50" as="geometry"/></mxCell><mxCell id="c249" value="&lt;b style=&quot;font-size:16px&quot;&gt;incluir_relatorios()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Cada 📎 do diagrama. Um PDF do titular e um dos dependentes, só de quem tem atendimento&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3826" y="2362" width="718" height="392" as="geometry"/></mxCell><mxCell id="c244" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;encontrar_doc_por_nome()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Procura na rodada &quot;PDF Utilização Tit.|Dep. RP|RC - &amp;lt;matrícula&amp;gt;&quot;" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c249"><mxGeometry x="24" y="74" width="330" height="66" as="geometry"/></mxCell><mxCell id="c246" value="Já anexado?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c249"><mxGeometry x="74" y="168" width="230" height="90" as="geometry"/></mxCell><mxCell id="c245" value="Não anexa de novo" style="rounded=1;fillColor=#ffffff;strokeColor=#999999;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c249"><mxGeometry x="424" y="193" width="270" height="40" as="geometry"/></mxCell><mxCell id="c248" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;transformar_xls_em_pdf() · incluir_doc_externo()&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Gera o PDF e anexa: tipo PDF, Nato-digital, Restrito" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="c249"><mxGeometry x="24" y="286" width="330" height="82" as="geometry"/></mxCell><mxCell id="c254" value="&lt;b style=&quot;font-size:16px&quot;&gt;garantir_marcadores_no_sei()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Antes de criar memos e relatórios&lt;/span&gt;" style="swimlane;html=1;whiteSpace=wrap;fontSize=13;rounded=1;arcSize=1;collapsible=0;container=1;strokeWidth=2;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fffaf3;startSize=50;" vertex="1" parent="1"><mxGeometry x="3826" y="2794" width="718" height="298" as="geometry