        <mxCell id="g-a-abre" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;acessar_processo · listar_documentos_arvore · listar_marcadores&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Abre o processo, lista a árvore e lê os marcadores &lt;b&gt;do SEI&lt;/b&gt; (normalizar_tags)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="g-c-linha"><mxGeometry x="650" y="58" width="440" height="74" as="geometry" /></mxCell>
